// ==============================================================================
// 秦安县秦剧团云端预约系统 · Prisma Schema v1.0
// 数据源：init_v1.0_mysql.sql 全部 42 表（MySQL 8.0+ 主选）
// 切换 PostgreSQL：provider = "postgresql" + DATABASE_URL 切换即可（类型已兼容）
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ==============================================================================
// 批次 1：权限模块基础（8 张）
// ==============================================================================

model AccountsV2 {
  id                String         @id @db.VarChar(32)
  username          String         @unique(map: "idx_acc_username") @db.VarChar(64)
  passwordHash      String         @map("password_hash") @db.VarChar(255)
  realName          String         @map("real_name") @db.VarChar(50)
  role              String         @default("staff") @db.VarChar(32)
  phone             String?        @db.VarChar(20)
  email             String?        @db.VarChar(128)
  avatarUrl         String?        @map("avatar_url") @db.VarChar(500)
  lastLoginAt       DateTime?      @map("last_login_at") @db.DateTime(0)
  lastLoginIp       String?        @map("last_login_ip") @db.VarChar(45)
  forcePwdChange    Boolean        @default(true) @map("force_pwd_change")
  failedLoginCount  Int            @default(0) @map("failed_login_count")
  lockedUntil       DateTime?      @map("locked_until") @db.DateTime(0)
  totpSecret        String?        @map("totp_secret") @db.VarChar(64)
  status            String         @default("active") @db.VarChar(20)
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.DateTime(0)
  createdBy         String?        @map("created_by") @db.VarChar(32)
  ts                BigInt         @map("_ts")

  userRoles         UserRole[]
  adminSessions     AdminSession[]
  auditLogs         AuditLog[]

  @@index([role, status], map: "idx_acc_role_status")
  @@map("accounts_v2")
}

model Role {
  id          String            @id @db.VarChar(32)
  name        String            @unique(map: "idx_role_name") @db.VarChar(64)
  description String?           @db.VarChar(255)
  level       Int               @default(0)
  status      String            @default("active") @db.VarChar(20)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(0)
  createdBy   String?           @map("created_by") @db.VarChar(32)
  ts          BigInt            @map("_ts")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String            @id @db.VarChar(32)
  code        String            @unique(map: "idx_perm_code") @db.VarChar(128)
  name        String            @db.VarChar(128)
  module      String            @db.VarChar(64)
  description String?           @db.VarChar(255)
  status      String            @default("active") @db.VarChar(20)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(0)
  ts          BigInt            @map("_ts")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.VarChar(32)
  permissionId String   @map("permission_id") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts           BigInt   @map("_ts")

  @@id([roleId, permissionId])
  @@index([roleId], map: "idx_rp_role")
  @@map("role_permissions")
}

model UserRole {
  accountId String   @map("account_id") @db.VarChar(32)
  roleId    String   @map("role_id") @db.VarChar(32)
  assignedBy  String?  @map("assigned_by") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts        BigInt   @map("_ts")

  @@id([accountId, roleId])
  @@map("user_roles")
}

model AdminSession {
  id           String    @id @db.VarChar(64)
  accountId    String    @map("account_id") @db.VarChar(32)
  tokenHash    String    @unique(map: "idx_sess_token") @map("token_hash") @db.VarChar(128)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts           BigInt    @map("_ts")

  @@index([expiresAt], map: "idx_sess_expires")
  @@map("admin_sessions")
}

model AuditLog {
  id         String    @id @db.VarChar(32)
  accountId  String?   @map("account_id") @db.VarChar(32)
  username   String?   @db.VarChar(64)
  action     String    @db.VarChar(128)
  module     String    @db.VarChar(64)
  targetType String?   @map("target_type") @db.VarChar(64)
  targetId   String?   @map("target_id") @db.VarChar(64)
  actionTs   DateTime @map("action_ts") @db.DateTime(0)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  detailJson Json?     @map("detail_json")
  ts         BigInt    @map("_ts")

  @@index([accountId, actionTs], map: "idx_audit_user_ts")
  @@map("audit_logs")
}

model LoginAttempt {
  id           String    @id @db.VarChar(32)
  username     String?   @db.VarChar(64)
  ipAddress    String    @map("ip_address") @db.VarChar(45)
  attemptedAt DateTime @map("attempted_at") @db.DateTime(0)
  successFlag  Boolean   @default(false) @map("success_flag")
  failReason   String?   @map("fail_reason") @db.VarChar(255)
  ts           BigInt    @map("_ts")

  @@index([ipAddress, attemptedAt], map: "idx_login_ip_ts")
  @@map("login_attempts")
}

// ==============================================================================
// 批次 2：系统/配置（3 张）
// ==============================================================================

model Setting {
  id          String   @id @db.VarChar(64)
  key         String   @unique(map: "idx_sett_key") @db.VarChar(128)
  value       String   @db.Text
  group       String?  @db.VarChar(64)
  description String?  @db.VarChar(255)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  ts          BigInt   @map("_ts")

  @@index([group], map: "idx_sett_group")
  @@map("settings")
}

model SystemBackup {
  id            String    @id @db.VarChar(32)
  backupType    String    @map("backup_type") @db.VarChar(32) // full/incremental/manual
  filename      String    @db.VarChar(255)
  storagePath   String    @map("storage_path") @db.VarChar(500)
  fileSizeBytes BigInt    @map("file_size_bytes")
  checksumSha256 String?  @map("checksum_sha256") @db.VarChar(64)
  status        String    @default("completed") @db.VarChar(20)
  createdBy     String?   @map("created_by") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  expiredAt   DateTime? @map("expired_at") @db.DateTime(0)
  ts            BigInt    @map("_ts")

  @@index([createdAt], map: "idx_backup_ts")
  @@map("system_backups")
}

model DataMigration {
  id               String    @id @db.VarChar(64)
  batch            Int
  description      String    @db.VarChar(500)
  executedBy         String?   @map("executed_by") @db.VarChar(64)
  expectedRowCount Int?      @map("expected_row_count")
  actualRowCount   Int?      @map("actual_row_count")
  dryRun           Boolean   @default(false) @map("dry_run")
  status           String    @default("pending") @db.VarChar(20)
  executedAt       DateTime @default(now()) @map("executed_at") @db.DateTime(0)
  ts               BigInt    @map("_ts")

  @@map("data_migrations")
}

// ==============================================================================
// 批次 3：主数据（6 张）
// ==============================================================================

model PerformersDbV1 {
  id                String   @id @db.VarChar(32)
  staffNo           String?  @unique(map: "idx_pf_staffno") @map("staff_no") @db.VarChar(32)
  name              String   @db.VarChar(50)
  gender            String?  @db.VarChar(10)
  birthDate         DateTime? @map("birth_date") @db.Date
  phone             String?  @db.VarChar(20)
  idCardNo          String?  @map("id_card_no") @db.VarChar(18)
  rankGrade         String?  @map("rank_grade") @db.VarChar(10) // A+/A/B/C
  primaryRole       String?  @map("primary_role") @db.VarChar(50)
  hireDate          DateTime? @map("hire_date") @db.Date
  employmentType     String?  @map("employment_type") @db.VarChar(20) // 正式/外聘/临时
  bankAccount     String?  @map("bank_account") @db.VarChar(50)
  bankName        String?  @map("bank_name") @db.VarChar(100)
  socialSecurityNo String?  @map("social_security_no") @db.VarChar(20)
  status           String   @default("active") @db.VarChar(20)
  remark            String?  @db.Text
  avatarUrl       String?  @map("avatar_url") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  ts                BigInt   @map("_ts")

  @@map("performers_db_v1")
}

model Play {
  id            String    @id @db.VarChar(32)
  playCode      String?   @unique(map: "idx_play_code") @map("play_code") @db.VarChar(32)
  title         String    @db.VarChar(200)
  subtitle      String?   @db.VarChar(500)
  genre         String?   @db.VarChar(50) // 历史/神话/现代/折子戏
  durationMinutes Int?     @map("duration_minutes")
  author        String?   @db.VarChar(200)
  posterUrl     String?   @map("poster_url") @db.VarChar(500)
  synopsis      String?   @db.Text
  castSummary   String?   @map("cast_summary") @db.Text
  difficultyLevel String? @map("difficulty_level") @db.VarChar(10)
  status        String    @default("active") @db.VarChar(20)
  createdBy     String?   @map("created_by") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  ts            BigInt    @map("_ts")

  playCasts     PlayCast[]

  @@map("plays")
}

model PlayCast {
  id          String   @id @db.VarChar(32)
  playId      String   @map("play_id") @db.VarChar(32)
  performerId String?  @map("performer_id") @db.VarChar(32)
  roleName    String   @map("role_name") @db.VarChar(100)
  roleType    String?  @map("role_type") @db.VarChar(32) // 主演/配角/龙套/乐队
  sortOrder   Int      @default(0) @map("sort_order")
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts          BigInt   @map("_ts")

  @@index([playId], map: "idx_pc_play")
  @@map("play_casts")
}

model InventoryItem {
  id          String   @id @db.VarChar(32)
  sku         String?  @unique(map: "idx_inv_sku") @db.VarChar(64)
  name        String   @db.VarChar(200)
  category    String?  @db.VarChar(64) // 戏服/道具/头饰/乐器/其他
  quantity    Int      @default(0)
  unit        String?  @db.VarChar(20)
  unitPrice   Decimal? @map("unit_price") @db.Decimal(12, 2)
  location    String?  @db.VarChar(200)
  status      String   @default("in_stock") @db.VarChar(20)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  remark      String?  @db.Text
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  ts          BigInt   @map("_ts")

  @@index([category], map: "idx_inv_cat")
  @@map("inventory_items")
}

model InventoryRecord {
  id          String   @id @db.VarChar(32)
  itemId      String   @map("item_id") @db.VarChar(32)
  opType      String   @map("op_type") @db.VarChar(20) // in/out/borrow/return/loss
  opDate      DateTime @map("op_date") @db.DateTime(0)
  quantity    Int
  relatedScheduleId String? @map("related_schedule_id") @db.VarChar(32)
  operator    String?  @db.VarChar(50)
  remark      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts          BigInt   @map("_ts")

  @@index([itemId, opDate], map: "idx_invrec_item")
  @@map("inventory_records")
}

model ContentV2 {
  id            String    @id @db.VarChar(32)
  type          String    @db.VarChar(32) // news/article/notice/gallery/video
  title         String    @db.VarChar(255)
  subtitle      String?   @db.VarChar(500)
  coverImage    String?   @map("cover_image") @db.VarChar(500)
  contentBody      String?   @map("content_body") @db.Text
  summary       String?   @db.Text
  publishStatus  String    @default("draft") @map("publish_status") @db.VarChar(20)
  publishDate   DateTime? @map("publish_date") @db.DateTime(0)
  authorName    String?   @map("author_name") @db.VarChar(50)
  sortWeight    Int       @default(0) @map("sort_weight")
  viewCount     Int       @default(0) @map("view_count")
  tagsJson      Json?     @map("tags_json")
  extraJson     Json?     @map("extra_json")
  createdBy     String?   @map("created_by") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  ts            BigInt    @map("_ts")

  @@index([type, publishStatus, publishDate], map: "idx_ct_type_status")
  @@map("content_v2")
}

// ==============================================================================
// 批次 4：客户 + 预约（上游，6 张）
// ==============================================================================

model CustomersV1 {
  id                 String    @id @db.VarChar(32)
  customerType       String    @default("personal") @map("customer_type") @db.VarChar(20) // personal/organization
  customerName       String    @map("customer_name") @db.VarChar(100)
  organization       String?   @db.VarChar(200)
  unifiedSocialCode  String?   @map("unified_social_code") @db.VarChar(32)
  contactPerson      String?   @map("contact_person") @db.VarChar(50)
  phone              String    @db.VarChar(20)
  backupPhone        String?   @map("backup_phone") @db.VarChar(20)
  wechatId           String?   @map("wechat_id") @db.VarChar(64)
  email              String?   @db.VarChar(128)
  region           String?   @db.VarChar(200)
  address            String?   @db.Text
  sourceChannel      String?   @map("source_channel") @db.VarChar(50)
  level              String?   @db.VarChar(20) // VIP/A/B/C
  creditLevel       String?   @map("credit_level") @db.VarChar(20)
  totalOrdersAmount   Decimal? @map("total_orders_amount") @db.Decimal(14, 2)
  totalOrdersCount   Int?      @map("total_orders_count")
  remark             String?   @db.Text
  tagsJson           Json?     @map("tags_json")
  status             String    @default("active") @db.VarChar(20)
  firstContactDate  DateTime? @map("first_contact_date") @db.Date
  createdBy         String?   @map("created_by") @db.VarChar(32)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  ts                 BigInt    @map("_ts")

  appointments      Appointment[]
  customerContacts CustomerContact[]
  customerTags      CustomerTag[]
  orders             Order[]

  @@index([customerName, organization], map: "idx_cust_name_org")
  @@index([phone], map: "idx_cust_phone")
  @@map("customers_v1")
}

model CustomerContact {
  id           String    @id @db.VarChar(32)
  customerId String    @map("customer_id") @db.VarChar(32)
  name         String    @db.VarChar(50)
  position     String?   @db.VarChar(50)
  phone        String    @db.VarChar(20)
  wechatId     String?   @map("wechat_id") @db.VarChar(64)
  email        String?   @db.VarChar(128)
  isPrimary     Boolean   @default(true) @map("is_primary")
  remark       String?   @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts           BigInt    @map("_ts")

  @@index([customerId], map: "idx_cc_customer")
  @@map("customer_contacts")
}

model CustomerTag {
  customerId String   @map("customer_id") @db.VarChar(32)
  tag        String   @db.VarChar(64)
  taggedAt   DateTime @default(now()) @map("tagged_at") @db.DateTime(0)
  ts         BigInt   @map("_ts")

  @@id([customerId, tag])
  @@map("customer_tags")
}

model Appointment {
  id                    String    @id @db.VarChar(32)
  appointmentNo       String    @unique(map: "idx_appt_no") @map("appointment_no") @db.VarChar(32)
  source          String    @default("website") @db.VarChar(32) // website/wechat/phone/manual
  status                  String    @default("pending") @db.VarChar(32) // pending/confirmed/converted/cancelled/rejected
  customerId            String    @map("customer_id") @db.VarChar(32)
  customerName        String    @map("customer_name") @db.VarChar(100)
  customerType        String?   @map("customer_type") @db.VarChar(20)
  organization          String?   @db.VarChar(200)
  phone                 String    @db.VarChar(20)
  contactPerson         String?   @map("contact_person") @db.VarChar(50)
  preferredStartDate    DateTime @map("preferred_start_date") @db.Date
  preferredEndDate      DateTime? @map("preferred_end_date") @db.Date
  performanceCount          Int       @default(1) @map("performance_count")
  packageType       String?   @map("package_type") @db.VarChar(50) // 庙会包场/文旅演出/校园巡演/定制
  venueProvince       String?   @map("venue_province") @db.VarChar(50)
  venueCity             String?   @map("venue_city") @db.VarChar(50)
  venueDistrict        String?   @map("venue_district") @db.VarChar(50)
  venueAddress          String?   @map("venue_address") @db.VarChar(500)
  estimatedBudget    Decimal? @map("estimated_budget") @db.Decimal(14, 2)
  totalPerformanceFee  Decimal? @map("total_performance_fee") @db.Decimal(14, 2)
  depositAmount        Decimal? @map("deposit_amount") @db.Decimal(14, 2)
  paymentTerms           String?   @map("payment_terms") @db.VarChar(255)
  specialRequirements    String?   @map("special_requirements") @db.Text
  remarkInternal          String?   @map("remark_internal") @db.Text
  assignedAccountId  String?   @map("assigned_account_id") @db.VarChar(32)
  smsVerifiedFlag  Boolean   @default(false) @map("sms_verified_flag")
  sourceChannel       String?   @map("source_channel") @db.VarChar(50)
  conversionToOrderDate    DateTime? @map("conversion_to_order_date") @db.DateTime(0)
  convertedOrderId   String?   @map("converted_order_id") @db.VarChar(32)
  rejectReason          String?   @map("reject_reason") @db.VarChar(255)
  createdBy         String?   @map("created_by") @db.VarChar(32)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  ts                    BigInt    @map("_ts")

  plays              AppointmentPlay[]
  appointmentAudits AppointmentAudit[]
  order              Order?

  @@index([phone, status, createdAt], map: "idx_appt_phone_status")
  @@index([status, preferredStartDate], map: "idx_appt_status_date")
  @@map("appointments")
}

model AppointmentPlay {
  appointmentId String   @map("appointment_id") @db.VarChar(32)
  playId        String   @map("play_id") @db.VarChar(32)
  sortOrder     Int      @default(1) @map("sort_order")
  performanceDate DateTime? @map("performance_date") @db.Date
  performanceTime String?  @map("performance_time") @db.VarChar(20)
  note          String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts            BigInt   @map("_ts")

  @@id([appointmentId, playId])
  @@index([appointmentId], map: "idx_apptplay_appt")
  @@map("appointment_plays")
}

model AppointmentAudit {
  id             String    @id @db.VarChar(32)
  appointmentId  String    @map("appointment_id") @db.VarChar(32)
  actionType    String    @map("action_type") @db.VarChar(32)
  actionTs      DateTime @map("action_ts") @db.DateTime(0)
  operatorAccountId String? @map("operator_account_id") @db.VarChar(32)
  operatorName     String?   @map("operator_name") @db.VarChar(50)
  fromStatus       String?   @map("from_status") @db.VarChar(32)
  toStatus         String?   @map("to_status") @db.VarChar(32)
  remark           String?   @db.Text
  detailJson       Json?     @map("detail_json")
  ts               BigInt    @map("_ts")

  @@index([appointmentId, actionTs], map: "idx_apptaudit_aid")
  @@map("appointment_audit")
}

// ==============================================================================
// 批次 5：订单 + 档期 + 演员表（8 张）
// ==============================================================================

model Order {
  id                  String    @id @db.VarChar(32)
  orderNo          String    @unique(map: "idx_order_no") @map("order_no") @db.VarChar(32)
  orderType         String    @default("performance") @map("order_type") @db.VarChar(32)
  status              String    @default("draft") @db.VarChar(32) // draft/confirmed/partial_paid/paid/performance/completed/cancelled/refunded
  customerId        String    @map("customer_id") @db.VarChar(32)
  customerName      String    @map("customer_name") @db.VarChar(100)
  organization      String?   @db.VarChar(200)
  phone               String?   @db.VarChar(20)
  appointmentId     String?   @map("appointment_id") @db.VarChar(32)
  orderDate           DateTime @map("order_date") @db.DateTime(0)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  discountAmount  Decimal? @default(0) @map("discount_amount") @db.Decimal(14, 2)
  finalAmount       Decimal  @default(0) @map("final_amount") @db.Decimal(14, 2)
  depositAmount      Decimal? @default(0) @map("deposit_amount") @db.Decimal(14, 2)
  paidAmount          Decimal? @default(0) @map("paid_amount") @db.Decimal(14, 2)
  invoiceTitle          String?   @map("invoice_title") @db.VarChar(200)
  taxNo               String?   @map("tax_no") @db.VarChar(32)
  contractNo        String?   @map("contract_no") @db.VarChar(64)
  contractUrl       String?   @map("contract_url") @db.VarChar(500)
  salesmanId      String?   @map("salesman_id") @db.VarChar(32)
  salesmanName       String?   @map("salesman_name") @db.VarChar(50)
  performanceStartDate DateTime? @map("performance_start_date") @db.Date
  performanceEndDate   DateTime? @map("performance_end_date") @db.Date
  performanceCount    Int?      @map("performance_count")
  venueFullAddress  String?   @map("venue_full_address") @db.VarChar(500)
  specialRequirements   String?   @map("special_requirements") @db.Text
  internalRemark       String?   @map("internal_remark") @db.Text
  cancellationReason  String?   @map("cancellation_reason") @db.VarChar(255)
