// ==============================================================================
// 秦安县秦剧团云端预约系统 · Prisma Schema v1.0
// 数据源：init_v1.0_mysql.sql 全部 42 表（MySQL 8.0+ 主选）
// 切换 PostgreSQL：provider = "postgresql" + DATABASE_URL 切换即可（类型已兼容）
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ==============================================================================
// 批次 1：权限模块基础（8 张）
// ==============================================================================

model AccountsV2 {
  id               String    @id
  username         String    @unique(map: "idx_acc_username")
  passwordHash     String    @map("password_hash")
  realName         String    @map("real_name")
  role             String    @default("staff")
  phone            String?
  email            String?
  avatarUrl        String?   @map("avatar_url")
  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip")
  forcePwdChange   Boolean   @default(true) @map("force_pwd_change")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  totpSecret       String?   @map("totp_secret")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by")
  ts               BigInt    @map("_ts")

  userRoles     UserRole[]
  adminSessions AdminSession[]
  auditLogs     AuditLog[]

  @@index([role, status], map: "idx_acc_role_status")
  @@map("accounts_v2")
}

model Role {
  id          String   @id
  name        String   @unique(map: "idx_role_name")
  description String?
  level       Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  ts          BigInt   @map("_ts")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id
  code        String   @unique(map: "idx_perm_code")
  name        String
  module      String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  ts          BigInt   @map("_ts")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  ts           BigInt     @map("_ts")
  Role         Role       @relation(fields: [roleId], references: [id])
  Permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([roleId], map: "idx_rp_role")
  @@map("role_permissions")
}

model UserRole {
  accountId    String      @map("account_id")
  roleId       String      @map("role_id")
  assignedBy   String?     @map("assigned_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  ts           BigInt      @map("_ts")
  account      AccountsV2  @relation(fields: [accountId], references: [id])
  role         Role        @relation(fields: [roleId], references: [id])

  @@id([accountId, roleId])
  @@map("user_roles")
}

model AdminSession {
  id           String      @id
  accountId    String      @map("account_id")
  tokenHash    String      @unique(map: "idx_sess_token") @map("token_hash")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  expiresAt    DateTime    @map("expires_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  ts           BigInt      @map("_ts")
  account      AccountsV2  @relation(fields: [accountId], references: [id])

  @@index([expiresAt], map: "idx_sess_expires")
  @@map("admin_sessions")
}

model AuditLog {
  id           String      @id
  accountId    String?     @map("account_id")
  username     String?
  action       String
  module       String
  targetType   String?     @map("target_type")
  targetId     String?     @map("target_id")
  actionTs     DateTime    @map("action_ts")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  detailJson   String?     @map("detail_json")
  ts           BigInt      @map("_ts")
  account      AccountsV2? @relation(fields: [accountId], references: [id])

  @@index([accountId, actionTs], map: "idx_audit_user_ts")
  @@map("audit_logs")
}

model LoginAttempt {
  id          String   @id
  username    String?
  ipAddress   String   @map("ip_address")
  attemptedAt DateTime @map("attempted_at")
  successFlag Boolean  @default(false) @map("success_flag")
  failReason  String?  @map("fail_reason")
  ts          BigInt   @map("_ts")

  @@index([ipAddress, attemptedAt], map: "idx_login_ip_ts")
  @@map("login_attempts")
}

// ==============================================================================
// 批次 2：系统/配置（3 张）
// ==============================================================================

model Setting {
  id          String   @id
  key         String   @unique(map: "idx_sett_key")
  value       String
  group       String?
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  ts          BigInt   @map("_ts")

  @@index([group], map: "idx_sett_group")
  @@map("settings")
}

model SystemBackup {
  id             String    @id
  backupType     String    @map("backup_type") // full/incremental/manual
  filename       String
  storagePath    String    @map("storage_path")
  fileSizeBytes  BigInt    @map("file_size_bytes")
  checksumSha256 String?   @map("checksum_sha256")
  status         String    @default("completed")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiredAt      DateTime? @map("expired_at")
  ts             BigInt    @map("_ts")

  @@index([createdAt], map: "idx_backup_ts")
  @@map("system_backups")
}

model DataMigration {
  id               String   @id
  batch            Int
  description      String
  executedBy       String?  @map("executed_by")
  expectedRowCount Int?     @map("expected_row_count")
  actualRowCount   Int?     @map("actual_row_count")
  dryRun           Boolean  @default(false) @map("dry_run")
  status           String   @default("pending")
  executedAt       DateTime @default(now()) @map("executed_at")
  ts               BigInt   @map("_ts")

  @@map("data_migrations")
}

// ==============================================================================
// 批次 3：主数据（6 张）
// ==============================================================================

model PerformersDbV1 {
  id               String    @id
  staffNo          String?   @unique(map: "idx_pf_staffno") @map("staff_no")
  name             String
  gender           String?
  birthDate        DateTime? @map("birth_date")
  phone            String?
  idCardNo         String?   @map("id_card_no")
  rankGrade        String?   @map("rank_grade") // A+/A/B/C
  primaryRole      String?   @map("primary_role")
  hireDate         DateTime? @map("hire_date")
  employmentType   String?   @map("employment_type") // 正式/外聘/临时
  bankAccount      String?   @map("bank_account")
  bankName         String?   @map("bank_name")
  socialSecurityNo String?   @map("social_security_no")
  status           String    @default("active")
  remark           String?
  avatarUrl        String?   @map("avatar_url")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  ts               BigInt    @map("_ts")

  @@map("performers_db_v1")
}

model Play {
  id              String   @id
  playCode        String?  @unique(map: "idx_play_code") @map("play_code")
  title           String
  subtitle        String?
  genre           String? // 历史/神话/现代/折子戏
  durationMinutes Int?     @map("duration_minutes")
  author          String?
  posterUrl       String?  @map("poster_url")
  synopsis        String?
  castSummary     String?  @map("cast_summary")
  difficultyLevel String?  @map("difficulty_level")
  status          String   @default("active")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  ts              BigInt   @map("_ts")

  playCasts     PlayCast[]
  appointmentPlays AppointmentPlay[]

  @@map("plays")
}

model PlayCast {
  id          String   @id
  playId      String   @map("play_id")
  performerId String?  @map("performer_id")
  roleName    String   @map("role_name")
  roleType    String?  @map("role_type") // 主演/配角/龙套/乐队
  sortOrder   Int      @default(0) @map("sort_order")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  ts          BigInt   @map("_ts")
  Play        Play     @relation(fields: [playId], references: [id])

  @@index([playId], map: "idx_pc_play")
  @@map("play_casts")
}

model InventoryItem {
  id        String   @id
  sku       String?  @unique(map: "idx_inv_sku")
  name      String
  category  String? // 戏服/道具/头饰/乐器/其他
  quantity  Int      @default(0)
  unit      String?
  unitPrice Decimal? @map("unit_price")
  location  String?
  status    String   @default("in_stock")
  imageUrl  String?  @map("image_url")
  remark    String?
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ts        BigInt   @map("_ts")

  @@index([category], map: "idx_inv_cat")
  @@map("inventory_items")
}

model InventoryRecord {
  id                String   @id
  itemId            String   @map("item_id")
  opType            String   @map("op_type") // in/out/borrow/return/loss
  opDate            DateTime @map("op_date")
  quantity          Int
  relatedScheduleId String?  @map("related_schedule_id")
  operator          String?
  remark            String?
  createdAt         DateTime @default(now()) @map("created_at")
  ts                BigInt   @map("_ts")

  @@index([itemId, opDate], map: "idx_invrec_item")
  @@map("inventory_records")
}

model ContentV2 {
  id            String    @id
  type          String // news/article/notice/gallery/video
  title         String
  subtitle      String?
  coverImage    String?   @map("cover_image")
  contentBody   String?   @map("content_body")
  summary       String?
  publishStatus String    @default("draft") @map("publish_status")
  publishDate   DateTime? @map("publish_date")
  authorName    String?   @map("author_name")
  sortWeight    Int       @default(0) @map("sort_weight")
  viewCount     Int       @default(0) @map("view_count")
  tagsJson      String?   @map("tags_json")
  extraJson     String?   @map("extra_json")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  ts            BigInt    @map("_ts")

  @@index([type, publishStatus, publishDate], map: "idx_ct_type_status")
  @@map("content_v2")
}

// ==============================================================================
// 批次 4：客户 + 预约（上游，6 张）
// ==============================================================================

model CustomersV1 {
  id                String    @id
  customerType      String    @default("personal") @map("customer_type") // personal/organization
  customerName      String    @map("customer_name")
  organization      String?
  unifiedSocialCode String?   @map("unified_social_code")
  contactPerson     String?   @map("contact_person")
  phone             String
  backupPhone       String?   @map("backup_phone")
  wechatId          String?   @map("wechat_id")
  email             String?
  region            String?
  address           String?
  sourceChannel     String?   @map("source_channel")
  level             String? // VIP/A/B/C
  creditLevel       String?   @map("credit_level")
  totalOrdersAmount Decimal?  @map("total_orders_amount")
  totalOrdersCount  Int?      @map("total_orders_count")
  remark            String?
  tagsJson          String?   @map("tags_json")
  status            String    @default("active")
  firstContactDate  DateTime? @map("first_contact_date")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  ts                BigInt    @map("_ts")

  appointments     Appointment[]
  customerContacts CustomerContact[]
  customerTags     CustomerTag[]
  orders           Order[]

  @@index([customerName, organization], map: "idx_cust_name_org")
  @@index([phone], map: "idx_cust_phone")
  @@map("customers_v1")
}

model CustomerContact {
  id            String       @id
  customerId    String       @map("customer_id")
  name          String
  position      String?
  phone         String
  wechatId      String?      @map("wechat_id")
  email         String?
  isPrimary     Boolean      @default(true) @map("is_primary")
  remark        String?
  createdAt     DateTime     @default(now()) @map("created_at")
  ts            BigInt       @map("_ts")
  customer      CustomersV1  @relation(fields: [customerId], references: [id])

  @@index([customerId], map: "idx_cc_customer")
  @@map("customer_contacts")
}

model CustomerTag {
  customerId    String       @map("customer_id")
  tag           String
  taggedAt      DateTime     @default(now()) @map("tagged_at")
  ts            BigInt       @map("_ts")
  customer      CustomersV1  @relation(fields: [customerId], references: [id])

  @@id([customerId, tag])
  @@map("customer_tags")
}

model Appointment {
  id                    String    @id
  appointmentNo         String    @unique(map: "idx_appt_no") @map("appointment_no")
  source                String    @default("website") // website/wechat/phone/manual
  status                String    @default("pending") // pending/confirmed/converted/cancelled/rejected
  customerId            String    @map("customer_id")
  customerName          String    @map("customer_name")
  customerType          String?   @map("customer_type")
  organization          String?
  phone                 String
  contactPerson         String?   @map("contact_person")
  preferredStartDate    DateTime  @map("preferred_start_date")
  preferredEndDate      DateTime? @map("preferred_end_date")
  performanceCount      Int       @default(1) @map("performance_count")
  packageType           String?   @map("package_type") // 庙会包场/文旅演出/校园巡演/定制
  venueProvince         String?   @map("venue_province")
  venueCity             String?   @map("venue_city")
  venueDistrict         String?   @map("venue_district")
  venueAddress          String?   @map("venue_address")
  estimatedBudget       Decimal?  @map("estimated_budget")
  totalPerformanceFee   Decimal?  @map("total_performance_fee")
  depositAmount         Decimal?  @map("deposit_amount")
  paymentTerms          String?   @map("payment_terms")
  specialRequirements   String?   @map("special_requirements")
  remarkInternal        String?   @map("remark_internal")
  assignedAccountId     String?   @map("assigned_account_id")
  smsVerifiedFlag       Boolean   @default(false) @map("sms_verified_flag")
  sourceChannel         String?   @map("source_channel")
  conversionToOrderDate DateTime? @map("conversion_to_order_date")
  convertedOrderId      String?   @map("converted_order_id")
  rejectReason          String?   @map("reject_reason")
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  ts                    BigInt    @map("_ts")

  plays             AppointmentPlay[]
  appointmentAudits AppointmentAudit[]
  order             Order?
  customer          CustomersV1       @relation(fields: [customerId], references: [id])

  @@index([phone, status, createdAt], map: "idx_appt_phone_status")
  @@index([status, preferredStartDate], map: "idx_appt_status_date")
  @@map("appointments")
}

model AppointmentPlay {
  appointmentId   String      @map("appointment_id")
  playId          String      @map("play_id")
  sortOrder       Int         @default(1) @map("sort_order")
  performanceDate DateTime?   @map("performance_date")
  performanceTime String?     @map("performance_time")
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  ts              BigInt      @map("_ts")
  Appointment     Appointment @relation(fields: [appointmentId], references: [id])
  play            Play        @relation(fields: [playId], references: [id])

  @@id([appointmentId, playId])
  @@index([appointmentId], map: "idx_apptplay_appt")
  @@index([playId], map: "idx_apptplay_play")
  @@map("appointment_plays")
}

model AppointmentAudit {
  id                String      @id
  appointmentId     String      @map("appointment_id")
  actionType        String      @map("action_type")
  actionTs          DateTime    @map("action_ts")
  operatorAccountId String?     @map("operator_account_id")
  operatorName      String?     @map("operator_name")
  fromStatus        String?     @map("from_status")
  toStatus          String?     @map("to_status")
  remark            String?
  detailJson        String?     @map("detail_json")
  ts                BigInt      @map("_ts")
  Appointment       Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId, actionTs], map: "idx_apptaudit_aid")
  @@map("appointment_audit")
}

// ==============================================================================
// 批次 5：订单 + 档期 + 演员表（8 张）
// ==============================================================================

model Order {
  id                   String    @id
  orderNo              String    @unique(map: "idx_order_no") @map("order_no")
  orderType            String    @default("performance") @map("order_type")
  status               String    @default("draft") // draft/confirmed/partial_paid/paid/performance/completed/cancelled/refunded
  customerId           String    @map("customer_id")
  customerName         String    @map("customer_name")
  organization         String?
  phone                String?
  appointmentId        String?   @unique @map("appointment_id")
  orderDate            DateTime  @map("order_date")
  totalAmount          Decimal   @default(0) @map("total_amount")
  discountAmount       Decimal?  @default(0) @map("discount_amount")
  finalAmount          Decimal   @default(0) @map("final_amount")
  depositAmount        Decimal?  @default(0) @map("deposit_amount")
  paidAmount           Decimal?  @default(0) @map("paid_amount")
  invoiceTitle         String?   @map("invoice_title")
  taxNo                String?   @map("tax_no")
  contractNo           String?   @map("contract_no")
  contractUrl          String?   @map("contract_url")
  salesmanId           String?   @map("salesman_id")
  salesmanName         String?   @map("salesman_name")
  performanceStartDate DateTime? @map("performance_start_date")
  performanceEndDate   DateTime? @map("performance_end_date")
  performanceCount     Int?      @map("performance_count")
  venueFullAddress     String?   @map("venue_full_address")
  specialRequirements  String?   @map("special_requirements")
  internalRemark       String?   @map("internal_remark")
  cancellationReason   String?   @map("cancellation_reason")
  cancelledDate        DateTime? @map("cancelled_date")
  cancelledBy          String?   @map("cancelled_by")
  completedDate        DateTime? @map("completed_date")
  createdBy            String?   @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  ts                   BigInt    @map("_ts")

  items         OrderItem[]
  payments      FinPaymentV1[]
  refunds       OrderRefund[]
  schedules     ScheduleV2[]
  customer      CustomersV1    @relation(fields: [customerId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])

  @@index([status, orderDate], map: "idx_order_status_date")
  @@index([customerId], map: "idx_order_customer")
  @@map("orders")
}

model OrderItem {
  id              String    @id
  orderId         String    @map("order_id")
  itemType        String    @map("item_type") // performance/extra/discount
  playId          String?   @map("play_id")
  itemName        String    @map("item_name")
  quantity        Int       @default(1)
  unitPrice       Decimal   @map("unit_price")
  subtotal        Decimal   @map("subtotal")
  performanceDate DateTime? @map("performance_date")
  remark          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  ts              BigInt    @map("_ts")
  Order           Order     @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "idx_oi_order")
  @@map("order_items")
}

model FinPaymentV1 {
  id              String   @id
  orderId         String   @map("order_id")
  payNo           String   @unique(map: "idx_pay_no") @map("pay_no")
  payDate         DateTime @map("pay_date")
  payChannel      String   @map("pay_channel") // cash/transfer/wechat/alipay/cheque
  payType         String   @default("in") @map("pay_type") // in=收/out=退
  amount          Decimal  @map("amount")
  currency        String   @default("CNY")
  payerAccount    String?  @map("payer_account")
  payerName       String?  @map("payer_name")
  receiverAccount String?  @map("receiver_account")
  receiverName    String?  @map("receiver_name")
  voucherNo       String?  @map("voucher_no")
  status          String   @default("confirmed")
  remark          String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  ts              BigInt   @map("_ts")
  Order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, payDate], map: "idx_pay_order")
  @@map("fin_payments_v1")
}

model OrderRefund {
  id            String   @id
  orderId       String   @map("order_id")
  refundNo      String   @unique(map: "idx_refund_no") @map("refund_no")
  refundDate    DateTime @map("refund_date")
  refundChannel String   @map("refund_channel")
  amount        Decimal  @map("amount")
  reason        String?
  status        String   @default("pending")
  approvedBy    String?  @map("approved_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ts            BigInt   @map("_ts")
  Order         Order    @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "idx_refund_order")
  @@map("order_refunds")
}

model ScheduleV2 {
  id                String    @id
  scheduleNo        String    @unique(map: "idx_sched_no") @map("schedule_no")
  orderId           String    @map("order_id")
  status            String    @default("scheduled")
  playId            String?   @map("play_id")
  playTitle         String?   @map("play_title")
  scheduleDateStart DateTime  @map("schedule_date_start")
  scheduleDateEnd   DateTime  @map("schedule_date_end")
  performanceTime   String?   @map("performance_time") // 日场/夜场/加场/下午场
  venueProvince     String?   @map("venue_province")
  venueCity         String?   @map("venue_city")
  venueDistrict     String?   @map("venue_district")
  venueAddress      String?   @map("venue_address")
  audienceSize      Int?      @map("audience_size")
  weatherForecast   String?   @map("weather_forecast")
  actualAttendance  Int?      @map("actual_attendance")
  feeAmount         Decimal?  @map("fee_amount")
  castSheetId       String?   @map("cast_sheet_id")
  attendanceStatus  String?   @map("attendance_status")
  completedDate     DateTime? @map("completed_date")
  remark            String?
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  ts                BigInt    @map("_ts")

  castSheet CastSheetsV1[]
  venues    ScheduleVenue[]
  Order     Order           @relation(fields: [orderId], references: [id])

  @@index([scheduleDateStart, scheduleDateEnd, status], map: "idx_sched_range")
  @@index([status, scheduleDateStart], map: "idx_sched_status")
  @@map("schedules_v2")
}

model ScheduleVenue {
  id            String      @id
  scheduleId    String      @map("schedule_id")
  venueName     String      @map("venue_name")
