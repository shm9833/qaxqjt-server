model AttendanceV1 {
  id              String    @id
  staffId         String    @map("staff_id")
  staffName       String    @map("staff_name")
  attendanceMonth String    @map("attendance_month") // YYYY-MM
  attendanceDate  DateTime  @map("attendance_date")
  attendanceType  String    @map("attendance_type") // full/night/double/half/公休/rest/SL/PL/BL/ML/AL/absent/rainout/leave/outing/study/business/injury
  scheduleId      String?   @map("schedule_id")
  checkInTime     DateTime? @map("check_in_time")
  checkOutTime    DateTime? @map("check_out_time")
  workHours       Decimal?  @map("work_hours")
  overtimeHours   Decimal?  @map("overtime_hours")
  locationGps     String?   @map("location_gps")
  remark          String?
  approveStatus   String?   @default("approved") @map("approve_status")
  approvedBy      String?   @map("approved_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  ts              BigInt    @map("_ts")

  punches AttendancePunchRecord[]

  @@index([staffId, attendanceMonth, attendanceType], map: "idx_att_month")
  @@index([scheduleId], map: "idx_att_schedule")
  @@map("attendance_v1")
}

model AttendancePunchRecord {
  id             String        @id
  attendanceId   String?       @map("attendance_id")
  staffId        String        @map("staff_id")
  staffName      String        @map("staff_name")
  attendanceDate DateTime      @map("attendance_date")
  punchType      String        @map("punch_type") // in/out/meal_in/meal_out
  punchTime      DateTime      @map("punch_time")
  punchSource    String?       @map("punch_source") // manual/gps/face/device
  locationGps    String?       @map("location_gps")
  deviceId       String?       @map("device_id")
  remark         String?
  imageUrl       String?       @map("image_url")
  createdAt      DateTime      @default(now()) @map("created_at")
  ts             BigInt        @map("_ts")
  attendance   AttendanceV1? @relation(fields: [attendanceId], references: [id])

  @@index([staffId, attendanceDate, punchType], map: "idx_punch_staff")
  @@map("attendance_punch_records")
}

model LeaveApplication {
  id             String    @id
  staffId        String    @map("staff_id")
  staffName      String    @map("staff_name")
  leaveType      String    @map("leave_type") // SL/PL/BL/ML/AL/outing/study/business/injury
  dateFrom       DateTime  @map("date_from")
  dateTo         DateTime  @map("date_to")
  totalDays      Decimal   @map("total_days")
  totalHours     Decimal?  @map("total_hours")
  reason         String
  attachmentUrls String?   @map("attachment_urls")
  approveStatus  String    @default("pending") @map("approve_status")
  approverId     String?   @map("approver_id")
  approverName   String?   @map("approver_name")
  approvedAt     DateTime? @map("approved_at")
  rejectReason   String?   @map("reject_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  ts             BigInt    @map("_ts")

  @@index([staffId, dateFrom], map: "idx_leave_staff")
  @@map("leave_applications")
}

model OvertimeRecord {
  id            String    @id
  staffId       String    @map("staff_id")
  staffName     String    @map("staff_name")
  overtimeDate  DateTime  @map("overtime_date")
  overtimeType  String?   @map("overtime_type") // 工作日/周末/法定
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  totalHours    Decimal   @map("total_hours")
  scheduleId    String?   @map("schedule_id")
  reason        String?
  approveStatus String    @default("pending") @map("approve_status")
  approverId    String?   @map("approver_id")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  ts            BigInt    @map("_ts")

  @@index([staffId, overtimeDate], map: "idx_ot_staff")
  @@map("overtime_records")
}
