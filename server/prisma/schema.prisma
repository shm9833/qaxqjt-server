  attendanceId    String?   @map("attendance_id") @db.VarChar(32)
  staffId        String    @map("staff_id") @db.VarChar(32)
  staffName          String    @map("staff_name") @db.VarChar(50)
  attendanceDate   DateTime @map("attendance_date") @db.Date
  punchType     String    @map("punch_type") @db.VarChar(20) // in/out/meal_in/meal_out
  punchTime    DateTime @map("punch_time") @db.DateTime(0)
  punchSource  String?   @map("punch_source") @db.VarChar(20) // manual/gps/face/device
  locationGps     String?   @map("location_gps") @db.VarChar(100)
  deviceId           String?   @map("device_id") @db.VarChar(64)
  remark         String?   @db.VarChar(255)
  imageUrl         String?   @map("image_url") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  ts               BigInt    @map("_ts")

  @@index([staffId, attendanceDate, punchType], map: "idx_punch_staff")
  @@map("attendance_punch_records")
}

model LeaveApplication {
  id                String    @id @db.VarChar(32)
  staffId           String    @map("staff_id") @db.VarChar(32)
  staffName         String    @map("staff_name") @db.VarChar(50)
  leaveType       String    @map("leave_type") @db.VarChar(20) // SL/PL/BL/ML/AL/outing/study/business/injury
  dateFrom         DateTime @map("date_from") @db.Date
  dateTo           DateTime @map("date_to") @db.Date
  totalDays        Decimal  @map("total_days") @db.Decimal(4, 1)
  totalHours       Decimal?  @map("total_hours") @db.Decimal(5, 2)
  reason          String    @db.Text
  attachmentUrls   Json?     @map("attachment_urls")
  approveStatus     String    @default("pending") @map("approve_status") @db.VarChar(20)
  approverId       String?   @map("approver_id") @db.VarChar(32)
  approverName    String?   @map("approver_name") @db.VarChar(50)
  approvedAt     DateTime? @map("approved_at") @db.DateTime(0)
  rejectReason       String?   @map("reject_reason") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  ts               BigInt    @map("_ts")

  @@index([staffId, dateFrom], map: "idx_leave_staff")
  @@map("leave_applications")
}

model OvertimeRecord {
  id              String    @id @db.VarChar(32)
  staffId       String    @map("staff_id") @db.VarChar(32)
  staffName       String    @map("staff_name") @db.VarChar(50)
  overtimeDate  DateTime @map("overtime_date") @db.Date
  overtimeType String?   @map("overtime_type") @db.VarChar(20) // 工作日/周末/法定
  startTime    DateTime? @map("start_time") @db.DateTime(0)
  endTime     DateTime? @map("end_time") @db.DateTime(0)
  totalHours    Decimal   @map("total_hours") @db.Decimal(4, 2)
  scheduleId   String?   @map("schedule_id") @db.VarChar(32)
  reason      String?   @db.Text
  approveStatus   String    @default("pending") @map("approve_status") @db.VarChar(20)
  approverId   String?   @map("approver_id") @db.VarChar(32)
  approvedAt  DateTime? @map("approved_at") @db.DateTime(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  ts              BigInt    @map("_ts")

  @@index([staffId, overtimeDate], map: "idx_ot_staff")
  @@map("overtime_records")
}
