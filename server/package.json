{
  "name": "qaxqjt-cloud-booking-server",
  "version": "1.0.0",
  "description": "秦安县秦剧团文化演出有限公司云端预约系统 · Koa 2 + Prisma 5 后端服务",
  "main": "src/server.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon -e js,prisma --exec \"node -r dotenv/config src/server.js\"",
    "start": "cross-env NODE_ENV=production node -r dotenv/config src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push --skip-generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node -r dotenv/config prisma/seed.js",
    "init": "node -r dotenv/config scripts/init.js",
    "init:check": "node -r dotenv/config scripts/init.js -- --check",
    "lint": "eslint \"src/**/*.js\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "test": "node --test --test-force-exit",
    "test:cov": "node --test --test-force-exit --experimental-test-coverage",
    "healthz": "node -e \"require('http').get('http://127.0.0.1:' + (process.env.PORT||3001) + '/v1/healthz', r => { process.exit(r.statusCode===200?0:1) })\""
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.1",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.13",
    "dotenv": "^18.0.6",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.2",
    "koa": "^3.2.1",
    "koa-body": "^8.0.1",
    "koa-compress": "^5.1.1",
    "koa-helmet": "^9.0.0",
    "koa-jwt": "^4.0.4",
    "koa-morgan": "^1.0.1",
    "nanoid": "^3.3.7",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/koa": "^3.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0"
  }
}
