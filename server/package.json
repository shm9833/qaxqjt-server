{
  "name": "qaxqjt-cloud-booking-server",
  "version": "1.0.0",
  "description": "秦安县秦剧团云端预约系统 · Koa 2 + Prisma 5 后端服务",
  "main": "src/server.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.17.0 <21"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon -e js,prisma --exec \"node -r dotenv/config src/server.js\"",
    "start": "cross-env NODE_ENV=production node -r dotenv/config src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push --skip-generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node -r dotenv/config prisma/seed.js",
    "lint": "eslint \"src/**/*.js\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "test": "jest --passWithNoTests --silent",
    "test:cov": "jest --coverage --passWithNoTests",
    "healthz": "node -e \"require('http').get('http://127.0.0.1:' + (process.env.PORT||3001) + '/v1/healthz', r => { process.exit(r.statusCode===200?0:1) })\""
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.1",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.15.3",
    "koa-body": "^6.0.1",
    "koa-compress": "^5.1.1",
    "koa-helmet": "^7.0.2",
    "koa-jwt": "^4.0.4",
    "koa-morgan": "^1.0.1",
    "nanoid": "^3.3.7",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0"
  }
}
