{
  "info": {
    "_postman_id": "f13a9b86-7c5d-4f1e-a2b3-9c8d7e6a5b4c",
    "name": "秦安县秦剧团云端预约系统 · 管理后台 API v1.0 (12页核心CRUD)",
    "description": "包含 12 个管理页面核心 CRUD：认证/账号/角色权限/审计日志/客户/预约/排期/剧团演员/考勤/财务/报表/库存\n\n接入步骤：\n1. 导入 Collection 后，设置 Collection Variables（baseUrl / admin_username / admin_password）\n2. 先执行『01-认证登录 → POST 登录』获取 Token（脚本自动写入 accessToken 变量）\n3. 后续所有请求自动继承 Authorization: Bearer {{accessToken}}\n4. 若后端离线，可在 booking.html / admin/login.html 观察 localStorage 降级日志（Console）\n\n对应文档：E-5 后端接口对接方案v1.0 / E-2 后端REST鉴权规范v1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3001", "type": "string" },
    { "key": "admin_username", "value": "admin", "type": "string" },
    { "key": "admin_password", "value": "ChangeMe123!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "lastAppointmentId", "value": "", "type": "string" },
    { "key": "lastCustomerId", "value": "", "type": "string" },
    { "key": "lastAccountId", "value": "", "type": "string" },
    { "key": "lastRoleId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "01-认证登录 Auth",
      "description": "对应页面：admin/login.html + index.html 鉴权守卫",
      "item": [
        {
          "name": "GET 健康检查 healthz (无需鉴权)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/healthz",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "healthz"]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('健康检查 status=200', function() { pm.response.to.have.status(200); });",
            "pm.test('返回 service 字段', function() { var j = pm.response.json(); pm.expect(j.service).to.eql('qaxqjt-api'); });"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "POST 登录 (无需鉴权 → 自动写入 accessToken 变量)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\",\n  \"captcha\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "var code = pm.response.code;",
            "pm.test('登录 status ∈ [200, 201] or network error for fallback demo', function() { pm.expect(code).to.be.oneOf([200,201]); });",
            "try {",
            "  var j = pm.response.json();",
            "  var data = j.data || j;",
            "  var tok = data.accessToken || j.accessToken || (data.data && data.data.accessToken);",
            "  if (tok && String(tok).length > 30) {",
            "    pm.collectionVariables.set('accessToken', tok);",
            "    console.log('✅ Token 已写入变量 accessToken (len=' + tok.length + ')');",
            "    var user = data.user || data.account || {};",
            "    console.log('👤 当前用户: ' + (user.username || user.realName || '{{admin_username}}') + ' | role=' + (user.role || user.roles));",
            "  } else { console.warn('⚠️ 未获取到 accessToken：后端返回空或账号密码错误？'); }",
            "} catch(e) { console.warn('⚠️ 解析响应失败，后端可能离线（前端将自动走 localStorage 降级）：' + e.message); }"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "GET 当前用户 /auth/me",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "me"] } },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('/auth/me 200 or 401(expected when no token)', function() { pm.expect(pm.response.code).to.be.oneOf([200,401]); });"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "POST 刷新 accessToken /auth/refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"(从登录响应复制粘贴)\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "refresh"] }
          }
        },
        {
          "name": "POST 注销 /auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "logout"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('登出返回 200', function() { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('accessToken', '');"
          ], "type": "text/javascript" } }]
        }
      ]
    },

    {
      "name": "02-账号管理 Accounts (accounts.html)",
      "description": "超级管理员对 IAM 账号的增删改查（对应 admin/accounts.html）",
