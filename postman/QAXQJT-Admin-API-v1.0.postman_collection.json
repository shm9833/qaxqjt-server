    {
      "name": "06-预约管理 Appointments (appointments.html + detail)",
      "description": "对应 appointments.html + appointment-detail.html，共 11 个接口（含状态流转+剧目绑定）",
      "item": [
        {
          "name": "GET 预约列表 (分页+状态+日期范围)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/appointments?page=1&pageSize=20&status=pending&packageType=&fromDate=2026-08-01&toDate=2026-09-30",
              "host": ["{{baseUrl}}"], "path": ["v1", "appointments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "status", "value": "pending", "disabled": true },
                { "key": "packageType", "value": "", "disabled": true },
                { "key": "source", "value": "", "disabled": true },
                { "key": "customerId", "value": "", "disabled": true },
                { "key": "fromDate", "value": "2026-08-01", "disabled": true },
                { "key": "toDate", "value": "2026-09-30", "disabled": true }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "try { var j = pm.response.json(); var arr = j.data && j.data.list ? j.data.list : (j.list || j.data || j); if(arr && arr[0]) pm.collectionVariables.set('lastAppointmentId', arr[0].id); } catch(e){}"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "GET 预约统计 /appointments/stats",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/appointments/stats", "host": ["{{baseUrl}}"], "path": ["v1", "appointments", "stats"] } }
        },
        {
          "name": "POST 创建预约 (匿名公开接口·无需鉴权) — booking.html 提交",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"booking.html 测试-张大哥\",\n  \"customerType\": \"personal\",\n  \"organization\": \"\",\n  \"contactPerson\": \"张大哥\",\n  \"phone\": \"13844445555\",\n  \"backupPhone\": \"\",\n  \"email\": \"zhang@demo.local\",\n  \"region\": \"甘肃秦安\",\n  \"address\": \"秦安县叶堡镇\",\n  \"sourceChannel\": \"微信朋友圈\",\n  \"preferredStartDate\": \"2026-09-15\",\n  \"preferredEndDate\": \"2026-09-17\",\n  \"performanceCount\": 3,\n  \"packageType\": \"temple_fair\",\n  \"venueProvince\": \"甘肃省\",\n  \"venueCity\": \"天水市\",\n  \"venueDistrict\": \"秦安县\",\n  \"venueAddress\": \"叶堡镇文化广场舞台\",\n  \"estimatedBudget\": 36000.00,\n  \"totalPerformanceFee\": 36000.00,\n  \"depositAmount\": 10000.00,\n  \"paymentTerms\": \"签合同付 30%，演出前 3 天付清尾款\",\n  \"specialRequirements\": \"需要音响设备和灯光全套，安排《三滴血》《周仁回府》\",\n  \"remarkInternal\": \"\",\n  \"smsVerifiedFlag\": false,\n  \"plays\": [\n    { \"playId\": \"play_san_di_xue\", \"sortOrder\": 1, \"performanceDate\": \"2026-09-15\", \"performanceTime\": \"20:00\", \"note\": \"夜场\" },\n    { \"playId\": \"play_zhou_ren_hui_fu\", \"sortOrder\": 2, \"performanceDate\": \"2026-09-16\", \"performanceTime\": \"20:00\", \"note\": \"夜场\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/v1/appointments", "host": ["{{baseUrl}}"], "path": ["v1", "appointments"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "var code = pm.response.code;",
            "if (code >= 200 && code < 300) {",
            "  try { var j = pm.response.json(); if(j.data && j.data.id) pm.collectionVariables.set('lastAppointmentId', j.data.id); console.log('✅ 预约提交成功 ID=' + (j.data.id || '')); }",
            "  catch(e) { console.warn('解析响应失败: ' + e.message); }",
            "} else {",
