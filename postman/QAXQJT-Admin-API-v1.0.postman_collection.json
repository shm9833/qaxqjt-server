        {
          "name": "DELETE 删除账号 /accounts/:id",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/v1/accounts/{{lastAccountId}}", "host": ["{{baseUrl}}"], "path": ["v1", "accounts", "{{lastAccountId}}"] } }
        }
      ]
    },

