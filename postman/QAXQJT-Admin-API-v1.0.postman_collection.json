            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"oldPassword\": \"{{admin_password}}\",\n  \"newPassword\": \"{{admin_password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/accounts/me/password", "host": ["{{baseUrl}}"], "path": ["v1", "accounts", "me", "password"] }
          }
