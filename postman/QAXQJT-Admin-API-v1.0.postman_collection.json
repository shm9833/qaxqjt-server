          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('列表 200/401/403', function() { pm.expect(pm.response.code).to.be.oneOf([200,401,403]); });",
            "try { var j = pm.response.json(); var arr = j.data && j.data.list ? j.data.list : (j.list || j.data || j); if(arr && arr[0]) pm.collectionVariables.set('lastAccountId', arr[0].id); } catch(e){}"
