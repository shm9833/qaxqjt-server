            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"ops_test_01\",\n  \"password\": \"Qaxqjt@2026\",\n  \"realName\": \"测试运营01\",\n  \"role\": \"ops\",\n  \"phone\": \"13800000001\",\n  \"email\": \"ops01@demo.local\",\n  \"status\": \"active\",\n  \"forcePwdChange\": true\n}" },
            "url": { "raw": "{{baseUrl}}/v1/accounts", "host": ["{{baseUrl}}"], "path": ["v1", "accounts"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "try { var j = pm.response.json(); if (j.data && j.data.id) pm.collectionVariables.set('lastAccountId', j.data.id); } catch(e){}"
          ], "type": "text/javascript" } }]
        },
        {
          "name": "GET 账号详情 /accounts/:id",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/accounts/{{lastAccountId}}", "host": ["{{baseUrl}}"], "path": ["v1", "accounts", "{{lastAccountId}}"] } }
        },
        {
          "name": "PATCH 修改账号 /accounts/:id",
