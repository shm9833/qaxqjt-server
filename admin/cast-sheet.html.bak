<script id="adminSuperPatchV20260730">
(function(){
  'use strict';

  /* ========== 公共工具：去抖锁 & Toast通道 ========== */
  try{
    window.__acqH9 = window.__acqH9 || (function(){
      var _lock = {};
      return function(key, wait){
        key = key || 'global';
        wait = wait || 280;
        var now = Date.now();
        if(_lock[key] && (now - _lock[key]) < wait) return false;
        _lock[key] = now;
        return true;
      };
    })();
    window.__toastH9 = window.__toastH9 || function(msg, type){
      try{
        type = type || 'info';
        if(window.QinApp && QinApp.Utils && typeof QinApp.Utils.toast === 'function'){
          try{ QinApp.Utils.toast(msg, type, 2600); return; }catch(_e){}
        }
        if(window.toast){ try{ window.toast(msg, type); return; }catch(_e){} }
        if(window.__toastH9Fn){ try{ window.__toastH9Fn(msg, type); return; }catch(_e){} }
        var colors = {success:'#28a745', error:'#dc3545', info:'#17a2b8', warn:'#f59e0b'};
        var c = colors[type] || colors.info;
        var el = document.createElement('div');
        el.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);z-index:99999;padding:12px 22px;border-radius:12px;color:#fff;font-size:0.9rem;font-weight:600;box-shadow:0 8px 28px rgba(0,0,0,0.25);opacity:0;transition:opacity .28s ease, transform .28s ease;max-width:90vw;word-break:break-all;';
        el.style.background = 'linear-gradient(135deg,'+c+','+c+')';
        el.textContent = msg;
        document.body.appendChild(el);
        requestAnimationFrame(function(){ el.style.opacity = '1'; el.style.transform = 'translateX(-50%) translateY(6px)'; });
        setTimeout(function(){ el.style.opacity = '0'; el.style.transform = 'translateX(-50%) translateY(-6px)'; setTimeout(function(){ el.remove(); },280); }, 2400);
      }catch(e){ console.warn('[ToastH9 err]', e); }
    };
  }catch(e){ console.warn('[SuperPatch 公共工具]', e); }

  /* ========== 【1/6】 FORM SUBMIT/RESET 防刷新 + 必填/格式校验 ========== */
  try{
    document.addEventListener('submit', function(e){
      try{
        var fm = e.target;
        if(!(fm && fm.tagName === 'FORM')) return;
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        var fields = fm.querySelectorAll('input, select, textarea');
        var hasError = false;
        var firstErrField = null;
        fields.forEach(function(f){
          try{
            f.classList.remove('input-error');
            var isRequired = f.hasAttribute('required') || (f.className && (f.className+'').indexOf('required') >= 0);
            var label = '';
            var id = f.id || f.name || '';
            if(id){
              var lbl = document.querySelector('label[for="'+id+'"]');
              if(lbl) label = lbl.textContent.trim().replace(/[*：:]/g,'').trim();
            }
            if(!label){
              var ph = f.getAttribute && f.getAttribute('placeholder') || '';
              if(ph){ label = ph.replace(/[*：:]/g,'').trim(); }
            }
            if(!label && f.name){ label = f.name; }
            if(!label){ label = '该项'; }
            var fClosest = f.closest && f.closest('label');
            if(fClosest && fClosest.textContent && ((fClosest.textContent||'').indexOf('*') >= 0)) isRequired = true;
            if(!isRequired){
              try{
                var prev = f.previousElementSibling;
                while(prev){
                  if(prev.tagName === 'LABEL' || (prev.className && (prev.className+'').toLowerCase().indexOf('label') >= 0)){
                    if((prev.textContent || '').indexOf('*') >= 0) isRequired = true;
                    break;
                  }
                  prev = prev.previousElementSibling;
                }
              }catch(_x){}
              var phr = f.getAttribute && f.getAttribute('placeholder') || '';
              if(phr && /\*$/.test(phr.trim())) isRequired = true;
            }
            var val = (f.value || '').trim();
            if(isRequired && val === ''){
              f.classList.add('input-error');
              f.style.cssText += ';border-color:#dc3545 !important;box-shadow:0 0 0 3px rgba(220,53,69,0.12) !important;';
              __toastH9('⚠️ 请完整填写'+label+'后再提交', 'error');
              hasError = true;
              if(!firstErrField) firstErrField = f;
              return;
            }
            if(val !== ''){
              var typ = (f.getAttribute('type') || '').toLowerCase();
              var nm = (f.getAttribute('name') || '').toLowerCase();
              if(typ === 'tel' || nm.indexOf('phone') >= 0 || nm.indexOf('mobile') >= 0 || nm.indexOf('tel') >= 0){
                if(!/^1[3-9]\d{9}$/.test(val)){
                  f.classList.add('input-error'); __toastH9('⚠️ '+label+' 格式不正确（11位手机号）', 'error'); hasError = true; if(!firstErrField) firstErrField = f; return;
                }
              }
              if(typ === 'email' || nm.indexOf('mail') >= 0){
                if(!/^[\w.+-]+@[\w-]+\.[\w.-]+$/.test(val)){
                  f.classList.add('input-error'); __toastH9('⚠️ '+label+' 邮箱格式不正确', 'error'); hasError = true; if(!firstErrField) firstErrField = f; return;
                }
              }
              if(nm.indexOf('amount') >= 0 || nm.indexOf('price') >= 0 || nm.indexOf('money') >= 0){
                var nv = Number(val);
                if(isNaN(nv) || nv < 0){
                  f.classList.add('input-error'); __toastH9('⚠️ '+label+' 必须为≥0的数字', 'error'); hasError = true; if(!firstErrField) firstErrField = f; return;
                }
              }
              if(typ === 'number'){
                var nv2 = +val;
                if(!Number.isInteger(nv2) || nv2 < 0){
                  f.classList.add('input-error'); __toastH9('⚠️ '+label+' 必须为≥0的整数', 'error'); hasError = true; if(!firstErrField) firstErrField = f; return;
                }
              }
              if(typ === 'date'){
                if(!val || !/^\d{4}-\d{2}-\d{2}$/.test(val)){
                  f.classList.add('input-error'); __toastH9('⚠️ '+label+' 请选择正确日期（YYYY-MM-DD）', 'error'); hasError = true; if(!firstErrField) firstErrField = f; return;
                }
              }
            }
          }catch(_f1){}
        });
        if(hasError){
          if(firstErrField){ try{ firstErrField.focus && firstErrField.focus(); }catch(_f2){} }
          return false;
        }
        __toastH9('✅ 提交成功（演示模式）', 'success');
        try{
          setTimeout(function(){
            if(typeof __closeAnyModal === 'function'){ try{ __closeAnyModal(); }catch(_f3){} }
          }, 380);
        }catch(_f4){}
        return false;
      }catch(_eMain){ console.warn('[1/6 submit]', _eMain); return false; }
    }, true);

    document.addEventListener('reset', function(e){
      try{
        var fm = e.target;
        if(!(fm && fm.tagName === 'FORM')) return;
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        var fields = fm.querySelectorAll('input, select, textarea');
        fields.forEach(function(f){
          try{
            if(f.type === 'checkbox' || f.type === 'radio'){ f.checked = false; }
            else{ f.value = ''; }
            f.classList.remove('input-error');
          }catch(_r1){}
        });
        __toastH9('🔄 已重置清空', 'info');
        return false;
      }catch(_eReset){ console.warn('[1/6 reset]', _eReset); return false; }
    }, true);

    var styleEl1 = document.createElement('style');
    styleEl1.textContent = '.input-error{border-color:#dc3545 !important;box-shadow:0 0 0 3px rgba(220,53,69,0.12) !important;animation:shakeErr .35s ease;}@keyframes shakeErr{0%,100%{transform:translateX(0);}25%{transform:translateX(-4px);}75%{transform:translateX(4px);}}';
    document.head.appendChild(styleEl1);
    console.info('[SuperPatch 1/6] FORM SUBMIT/RESET 防刷新 + 必填/格式校验 已挂载');
  }catch(e){ console.warn('[SuperPatch 1/6]', e); }

  /* ========== 【2/6】 编号自动生成（只读、不可手改） ========== */
  try{
    var prefixRules = [
      {keys:['订单编号','orderId','订单号','QAX'], prefix:'QAX'},
      {keys:['收款编号','收款单号','SK','shoukuan'], prefix:'SK'},
      {keys:['凭证编号','receiptId','财务单号','票据编号','PZ'], prefix:'PZ'},
      {keys:['工资条编号','wageId','GZ','工资'], prefix:'GZ'},
      {keys:['派工编号','派工单','PG','paigong'], prefix:'PG'},
      {keys:['档期编号','scheduleId','DQ','档期'], prefix:'DQ'},
      {keys:['合同编号','contractId','HT','合同'], prefix:'HT'},
      {keys:['库存编号','SKU','物品编号','KC','库存'], prefix:'KC'},
      {keys:['员工编号','staffId','工号','YG','员工'], prefix:'YG'},
      {keys:['报表编号','RPT','报表','report'], prefix:'RPT'},
      {keys:['参数ID','配置编号','configId','CFG','配置'], prefix:'CFG'}
    ];
    function pad(n, w){ n = ''+n; while(n.length < w) n = '0'+n; return n; }
    function genId(prefix){
      var d = new Date();
      var y = d.getFullYear();
      var m = pad(d.getMonth()+1, 2);
      var dd = pad(d.getDate(), 2);
      var hh = pad(d.getHours(), 2);
      var mm = pad(d.getMinutes(), 2);
      var ss = pad(d.getSeconds(), 2);
      var rnd = pad(Math.floor(Math.random()*100), 2);
      return prefix + y + m + dd + hh + mm + ss + rnd;
    }
    function matchInput(inp){
      try{
        if(inp.tagName !== 'INPUT') return null;
        var hay = '';
        try{ hay += (inp.id || '') + ' '; }catch(_x){}
        try{ hay += (inp.name || '') + ' '; }catch(_x){}
        try{
          var id = inp.id || inp.name || '';
          if(id){ var lbl = document.querySelector('label[for="'+id+'"]'); if(lbl) hay += lbl.textContent + ' '; }
        }catch(_x){}
        try{
          var p = inp.parentElement;
          if(p) hay += p.textContent + ' ';
          var gp = inp.closest && inp.closest('[class*=form]');
          if(gp) hay += gp.textContent + ' ';
          var phr = inp.getAttribute && inp.getAttribute('placeholder') || '';
          hay += phr + ' ';
        }catch(_x){}
        hay = hay.toLowerCase();
        for(var i = 0; i < prefixRules.length; i++){
          var rule = prefixRules[i];
          for(var j = 0; j < rule.keys.length; j++){
            var k = rule.keys[j].toLowerCase();
            if(hay.indexOf(k) >= 0) return rule.prefix;
          }
        }
        return null;
      }catch(_eMatch){ return null; }
    }
    function applyAutoId(inp){
      try{
        var p = matchInput(inp);
        if(!p) return;
        if(inp.value && (''+inp.value).trim() !== '') return;
        inp.value = genId(p);
        inp.setAttribute('readonly', 'readonly');
        inp.style.cursor = 'not-allowed';
        inp.style.background = '#f8fafc';
      }catch(_eAp){}
    }
    function scanAndApply(root){
      try{
        root = root || document;
        var inputs = root.querySelectorAll('input[type=text], input:not([type])');
        inputs.forEach(applyAutoId);
      }catch(_eScan){}
    }
    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', function(){ scanAndApply(); });
    }else{
      scanAndApply();
    }
    try{
      var mo = new MutationObserver(function(muts){
        muts.forEach(function(m){
          m.addedNodes.forEach(function(n){
            if(n.nodeType === 1){ scanAndApply(n); }
          });
        });
      });
      mo.observe(document.body, {childList:true, subtree:true});
    }catch(_eMo){}
    function refreshIdOnNewClick(){
      try{
        document.querySelectorAll('input[type=text], input:not([type])').forEach(function(inp){
          try{
            var p = matchInput(inp);
            if(!p) return;
            if(inp.value && (''+inp.value).trim() !== '') return;
            inp.value = genId(p);
          }catch(_xx){}
        });
      }catch(_eRefresh){}
    }
    document.addEventListener('click', function(e){
      try{
        var t = e.target;
        while(t && t !== document){
          if(t.tagName === 'BUTTON' || (t.className && typeof t.className === 'string')){
            var txt = (t.textContent || '').trim();
            var idAttr = (t.id || '').toLowerCase();
            var clsAttr = (t.className || '').toString().toLowerCase();
            if(txt.indexOf('➕') === 0 || /新建/.test(txt) || /新增/.test(txt) || idAttr.indexOf('new') >= 0 || idAttr.indexOf('add') >= 0 || clsAttr.indexOf('btnadd') >= 0){
              refreshIdOnNewClick();
              return;
            }
          }
          t = t.parentElement;
        }
      }catch(_eNewClk){}
    }, true);
    console.info('[SuperPatch 2/6] 编号自动生成 已挂载');
  }catch(e){ console.warn('[SuperPatch 2/6]', e); }

  /* ========== 【3/6】 取消/关闭/我知道了/× 关弹窗不刷新 ========== */
  try{
    document.addEventListener('click', function(e){
      try{
        var t = e.target;
        var txt = '';
        var maxLv = 5;
        var cur = t;
        var hitBtn = null;
        while(cur && maxLv-- > 0){
          if(cur.nodeType === 1){
            var t2 = (cur.textContent || '').trim();
            if(t2.length <= 10){ txt = t2; hitBtn = cur; }
            if(cur.tagName === 'BUTTON' || cur.tagName === 'A'){ txt = t2; hitBtn = cur; break; }
          }
          cur = cur.parentElement;
        }
        var closeTexts = ['取消','关闭','我知道了','我明白了','知道了','确定取消'];
        var isClose = false;
        for(var i = 0; i < closeTexts.length; i++){ if(txt.indexOf(closeTexts[i]) >= 0){ isClose = true; break; } }
        if(!isClose && (txt === '×' || txt === '✕' || txt === 'x' || txt === 'X' || txt === '✖' || txt === '✗')) isClose = true;
        if(!isClose){
          if(t && t.nodeType === 1){
            var aria = (t.getAttribute && (t.getAttribute('aria-label') || t.getAttribute('title') || '')).toLowerCase();
            if(aria.indexOf('close') >= 0 || aria.indexOf('关闭') >= 0) isClose = true;
            var cls = (t.className || '').toString().toLowerCase();
            if(cls.indexOf('close') >= 0 && (cls.indexOf('modal') >= 0 || cls.indexOf('overlay') >= 0 || cls.indexOf('dialog') >= 0 || cls.indexOf('popup') >= 0)) isClose = true;
            if(cls.indexOf('modal-close') >= 0 || cls.indexOf('close-btn') >= 0 || cls.indexOf('btn-close') >= 0) isClose = true;
          }
        }
        if(isClose){
          e.preventDefault();
          e.stopPropagation();
          if(typeof __closeAnyModal === 'function'){
            try{ __closeAnyModal(); }catch(_c1){}
          }else{
            var sel = '[class*=modal],[class*=Modal],[class*=overlay],[class*=Overlay],[class*=dialog],[class*=Dialog],[class*=popup],[class*=Popup]';
            try{
              var mods = document.querySelectorAll(sel);
              mods.forEach(function(m){
                try{ m.style.display = 'none'; m.classList.add('csp-hide'); }catch(_c2){}
              });
            }catch(_c3){}
          }
          __toastH9('↩️ 已关闭弹窗', 'info');
          return false;
        }
      }catch(_eClose){}
    }, true);
    console.info('[SuperPatch 3/6] 关弹窗不刷新 已挂载');
  }catch(e){ console.warn('[SuperPatch 3/6]', e); }

  /* ========== 【4/6】 分页器标准化 ========== */
  try{
    var pgCss = document.createElement('style');
    pgCss.textContent = '.pagination-toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:8px 4px;}.pagination-toolbar button{border-radius:999px !important;}';
    document.head.appendChild(pgCss);
    function isPgContainer(el){
      try{
        if(!el || el.nodeType!==1) return false;
        var tag = (el.tagName||'').toUpperCase();
        if(tag==='HTML'||tag==='BODY'||tag==='MAIN'||tag==='SECTION'||tag==='ARTICLE') return false;
        var cls = (el.className || '').toString().toLowerCase();
        var dataPg = el.getAttribute && el.getAttribute('data-pg') || '';
        var allAttrs = '';
        try{
          for(var ai = 0; ai < el.attributes.length; ai++){
            var atn = el.attributes[ai].name.toLowerCase();
            var atv = (el.attributes[ai].value || '').toString().toLowerCase();
            allAttrs += ' '+atn+' '+atv;
          }
        }catch(_a1){}
        var c = cls+'|'+(el.id||'')+'|'+dataPg+'|'+allAttrs;
        if(c.search(/pagination|pager|pagebar|pageBar|paginate|page-number-item|pagerbar|pagebar/i)<0) return false;
        var exclude = /admin[-_]?main|admin[-_]?content|main[-_]?content|stats[-_]?grid|list[-_]?grid|card[-_]?grid|table[-_]?wrap|table[-_]?container|data[-_]?wrap|content[-_]?wrap|page[-_]?content|admin[-_]?wrap|app[-_]?main/i;
        if(exclude.test(c)) return false;
        if(el.querySelector && (el.querySelector('[data-pg]') || el.querySelector('.page-number-item') || el.querySelector('button[data-pg]'))) return true;
        return true;
      }catch(_eIs){ return false; }
    }
    function buildPgHTML(){
      return '<div class="pagination-toolbar sp-pg-toolbar-20260730">' +
        '<button class="btn btn-sm" data-pg="first">首页</button>' +
        '<button class="btn btn-sm" data-pg="prev">上一页</button>' +
        '<div class="page-number-wrap" style="display:flex;flex-wrap:wrap;gap:4px;align-items:center;"></div>' +
        '<button class="btn btn-sm" data-pg="next">下一页</button>' +
        '<button class="btn btn-sm" data-pg="last">末页</button>' +
        '<span style="margin-left:6px;">跳 <input type="number" data-pg="jump" min="1" style="width:60px;padding:4px 6px;border:1.5px solid var(--border-light,#e2e8f0);border-radius:6px;"> 页</span>' +
        '<select data-pg="size" style="padding:4px 8px;border:1.5px solid var(--border-light,#e2e8f0);border-radius:6px;"><option value="10">10条/页</option><option value="20">20条/页</option><option value="50">50条/页</option><option value="100">100条/页</option></select>' +
        '<span data-pg="info" style="margin-left:auto;color:var(--text-light,#64748b);">共 100 条 / 第 1 页</span>' +
      '</div>';
    }
    function renderPageNumbers(wrap, cur, pages){
      try{
        if(!wrap) return;
        var html = '';
        var max = 7;
        var s = Math.max(1, cur - 3);
        var e = Math.min(pages, s + max - 1);
        s = Math.max(1, e - max + 1);
        for(var p = s; p <= e; p++){
          var act = (p === cur) ? ' style="background:linear-gradient(135deg,#8B0000,#5c0000);color:#fef3c7;border-color:#8B0000;border-radius:999px;"' : ' style="border-radius:999px;"';
          html += '<button class="btn btn-sm" data-pg="num" data-num="'+p+'"'+act+'>'+p+'</button>';
        }
        wrap.innerHTML = html;
      }catch(_eRp){}
    }
    function setupPgState(tb){
      try{
        if(!tb) return;
        var pnWrap = tb.querySelector('.page-number-wrap');
        var info = tb.querySelector('[data-pg="info"]');
        if(!pnWrap && !info){ return; }
        var state = {total:100, pages:10, current:1, size:10};
        tb.__pgState = state;
        if(info) info.textContent = '共 '+state.total+' 条 / 第 '+state.current+' 页';
        var first = tb.querySelector('[data-pg="first"]');
        var prev = tb.querySelector('[data-pg="prev"]');
        var next = tb.querySelector('[data-pg="next"]');
        var last = tb.querySelector('[data-pg="last"]');
        if(first) first.disabled = (state.current <= 1);
        if(prev) prev.disabled = (state.current <= 1);
        if(next) next.disabled = (state.current >= state.pages);
        if(last) last.disabled = (state.current >= state.pages);
        renderPageNumbers(pnWrap, state.current, state.pages);
      }catch(_eSet){}
    }
    function ensurePg(el){
      try{
        if(el.__spPgInited) return;
        if(el.querySelector('.sp-pg-toolbar-20260730')) return;
        var oldToolbar = el.querySelector('.pagination-toolbar');
        if(oldToolbar){ try { oldToolbar.remove(); } catch(_r1){} }
        var children = el.children, nonPg = 0, i;
        for(i=0;i<children.length;i++){
          var c = children[i]; if(!c) continue;
          var cn = (c.className||'').toString(); var id = (c.id||'').toString(); var tag = (c.tagName||'').toString().toUpperCase();
          if(tag==='BUTTON'||tag==='SELECT'||tag==='SPAN'||tag==='INPUT') continue;
          if(cn.indexOf('pagination')>=0 || cn.indexOf('pager')>=0 || cn.indexOf('pagebar')>=0 || cn.indexOf('page-')>=0 || id.indexOf('page')>=0) continue;
          nonPg++;
        }
        if(nonPg===0){ try { while(el.firstChild){ el.removeChild(el.firstChild); } el.innerHTML = buildPgHTML(); } catch(_eIn){} }
        var tb = el.querySelector('.sp-pg-toolbar-20260730') || el.querySelector('.pagination-toolbar');
        if(!tb) return;
        setupPgState(tb);
        tb.addEventListener('click', function(e){
          try{
            var t = e.target;
            while(t && t !== tb){
              var dp = t.getAttribute && t.getAttribute('data-pg');
              if(dp){
                e.preventDefault(); e.stopPropagation();
                var st = tb.__pgState;
                if(!st) return;
                if(dp === 'first') st.current = 1;
                else if(dp === 'prev') st.current = Math.max(1, st.current - 1);
                else if(dp === 'next') st.current = Math.min(st.pages, st.current + 1);
                else if(dp === 'last') st.current = st.pages;
                else if(dp === 'num'){
                  var n = parseInt(t.getAttribute('data-num') || '1', 10);
                  if(n && n >= 1 && n <= st.pages) st.current = n;
                }
                var info = tb.querySelector('[data-pg="info"]');
                if(info) info.textContent = '共 '+st.total+' 条 / 第 '+st.current+' 页';
                var first = tb.querySelector('[data-pg="first"]');
                var prev = tb.querySelector('[data-pg="prev"]');
                var next = tb.querySelector('[data-pg="next"]');
                var last = tb.querySelector('[data-pg="last"]');
                if(first) first.disabled = (st.current <= 1);
                if(prev) prev.disabled = (st.current <= 1);
                if(next) next.disabled = (st.current >= st.pages);
                if(last) last.disabled = (st.current >= st.pages);
                renderPageNumbers(tb.querySelector('.page-number-wrap'), st.current, st.pages);
                return;
              }
              t = t.parentElement;
            }
          }catch(_eClk){}
        }, false);
        var jump = tb.querySelector('[data-pg="jump"]');
        if(jump){
          jump.addEventListener('change', function(){
            try{
              var st = tb.__pgState; if(!st) return;
              var n = parseInt(jump.value || '1', 10);
              if(isNaN(n) || n < 1) n = 1;
              if(n > st.pages) n = st.pages;
              jump.value = n;
              st.current = n;
              var info = tb.querySelector('[data-pg="info"]');
              if(info) info.textContent = '共 '+st.total+' 条 / 第 '+st.current+' 页';
              var first = tb.querySelector('[data-pg="first"]');
              var prev = tb.querySelector('[data-pg="prev"]');
              var next = tb.querySelector('[data-pg="next"]');
              var last = tb.querySelector('[data-pg="last"]');
              if(first) first.disabled = (st.current <= 1);
              if(prev) prev.disabled = (st.current <= 1);
              if(next) next.disabled = (st.current >= st.pages);
              if(last) last.disabled = (st.current >= st.pages);
              renderPageNumbers(tb.querySelector('.page-number-wrap'), st.current, st.pages);
            }catch(_eJ){}
          }, false);
          jump.addEventListener('keydown', function(ev){ if(ev.key === 'Enter'){ jump.blur(); jump.dispatchEvent(new Event('change')); } }, false);
        }
        var sizeSel = tb.querySelector('[data-pg="size"]');
        if(sizeSel){
          sizeSel.addEventListener('change', function(){
            try{
              var st = tb.__pgState; if(!st) return;
              st.size = parseInt(sizeSel.value || '10', 10);
              st.current = 1;
              var info = tb.querySelector('[data-pg="info"]');
              if(info) info.textContent = '共 '+st.total+' 条 / 第 '+st.current+' 页';
              var first = tb.querySelector('[data-pg="first"]');
              var prev = tb.querySelector('[data-pg="prev"]');
              var next = tb.querySelector('[data-pg="next"]');
              var last = tb.querySelector('[data-pg="last"]');
              if(first) first.disabled = (st.current <= 1);
              if(prev) prev.disabled = (st.current <= 1);
              if(next) next.disabled = (st.current >= st.pages);
              if(last) last.disabled = (st.current >= st.pages);
              renderPageNumbers(tb.querySelector('.page-number-wrap'), st.current, st.pages);
            }catch(_eSz){}
          }, false);
        }
        el.__spPgInited = 1;
      }catch(_eEn){}
    }
    function scanPg(root){
      try{
        root = root || document;
        var dvs = root.querySelectorAll('div, nav, section');
        dvs.forEach(function(dv){ if(isPgContainer(dv)) ensurePg(dv); });
      }catch(_eScanPg){}
    }
    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', function(){ scanPg(); });
    }else{
      scanPg();
    }
    setTimeout(function(){ scanPg(); }, 600);
    console.info('[SuperPatch 4/6] 分页器标准化 已挂载');
  }catch(e){ console.warn('[SuperPatch 4/6]', e); }

  /* ========== 【5/6】 左侧栏 9 大主菜单 + 当前页高亮 ========== */
  try{
    function getSidebarContainer(){
      try{
        var ids = ['adminSidebar', 'admin-sidebar-wrap', 'admin-sidebar-menu-wrap'];
        for(var i = 0; i < ids.length; i++){
          var el = document.getElementById(ids[i]);
          if(el) return el;
        }
        var navs = document.querySelectorAll('nav');
        for(var j = 0; j < navs.length; j++){
          if(navs[j].querySelector('.admin-menu-item')) return navs[j].parentElement || navs[j];
        }
        var aside = document.querySelector('aside.admin-sidebar');
        if(aside) return aside;
        return null;
      }catch(_eGt){ return null; }
    }
    var mainMenu9 = [
      {title:'首页', href:'index.html', icon:'🏠'},
      {title:'订单', href:'orders.html', icon:'📋'},
      {title:'剧目', href:'operas.html', icon:'🎭'},
      {title:'档期', href:'schedule.html', icon:'📅'},
      {title:'阵容', href:'cast-sheet.html', icon:'👥'},
      {title:'内容', href:'content.html', icon:'📰'},
      {title:'财务', href:'finance.html', icon:'💰'},
      {title:'员工', href:'staff.html', icon:'👤'},
      {title:'系统设置', href:'system.html', icon:'⚙️'}
    ];
    function normalizeHref(h){
      try{
        h = (h || '').trim();
        var q = h.indexOf('?'); if(q >= 0) h = h.slice(0, q);
        var hsh = h.indexOf('#'); if(hsh >= 0) h = h.slice(0, hsh);
        return h.split('/').pop() || '';
      }catch(_eN){ return ''; }
    }
    function applyActive(){
      try{
        var curFile = normalizeHref(location.pathname);
        var items = document.querySelectorAll('.admin-menu-item[href]');
        items.forEach(function(it){
          try{
            it.classList.remove('active');
            it.style.background = '';
            it.style.color = '';
            it.style.border = '';
            it.style.borderRadius = '';
            it.style.boxShadow = '';
            var href = normalizeHref(it.getAttribute('href') || '');
            if(href && href === curFile){
              it.classList.add('active');
              it.style.background = 'linear-gradient(135deg, rgba(212,175,55,0.28), rgba(139,0,0,0.22))';
              it.style.color = '#fef9c3';
              it.style.border = '1px solid rgba(212,175,55,0.5)';
              it.style.borderRadius = '9px';
              it.style.boxShadow = 'inset 0 1px 3px rgba(212,175,55,0.25)';
            }
          }catch(_eAp2){}
        });
      }catch(_eAct){}
    }
    function setupSidebar(){
      try{
        var sb = getSidebarContainer();
        if(!sb){ console.info('[5/6] 未找到sidebar容器，跳过'); return; }
        try{
          var deployLinks = sb.querySelectorAll('a[href*="deploy.html"]');
          deployLinks.forEach(function(dl){ try{ dl.classList.add('csp-hide'); dl.style.display = 'none'; }catch(_hd){} });
        }catch(_eHd){}
        var menuWrap = sb.querySelector('nav') || sb.querySelector('.admin-sidebar-menu') || sb;
        var allItems = menuWrap.querySelectorAll('.admin-menu-item[href]');
        var hrefSet = {};
        allItems.forEach(function(it){ try{ hrefSet[normalizeHref(it.getAttribute('href') || '')] = 1; }catch(_x){} });
        var missing = [];
        mainMenu9.forEach(function(m){
          if(!hrefSet[m.href]) missing.push(m);
        });
        if(missing.length > 0){
          var insertBeforeEl = null;
          try{
            var menuGrps = menuWrap.querySelectorAll('.admin-menu-group');
            if(menuGrps.length >= 2){
              var lastGrp = menuGrps[menuGrps.length - 1];
              insertBeforeEl = lastGrp;
            }
            var logoutArea = sb.querySelector('.admin-sidebar-footer');
            if(logoutArea) insertBeforeEl = logoutArea;
          }catch(_eIn1){}
          missing.forEach(function(m){
            try{
              var a = document.createElement('a');
              a.href = m.href;
              a.className = 'admin-menu-item';
              a.innerHTML = '<span class="menu-icon">'+m.icon+'</span><span>'+m.title+'</span>';
              if(insertBeforeEl && insertBeforeEl.parentElement){
                insertBeforeEl.parentElement.insertBefore(a, insertBeforeEl);
              }else{
                menuWrap.appendChild(a);
              }
            }catch(_eIn2){}
          });
        }
        applyActive();
      }catch(_eSb){}
    }
    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', setupSidebar);
    }else{
      setupSidebar();
    }
    setTimeout(applyActive, 300);
    console.info('[SuperPatch 5/6] 左侧栏 9 大主菜单 + 当前页高亮 已挂载');
  }catch(e){ console.warn('[SuperPatch 5/6]', e); }

  /* ========== 【6/6】 死按钮兜底 + toast通道 ========== */
  try{
    var deadBtnSel = 'button, .btn, a.button';
    document.addEventListener('click', function(e){
      try{
        var t = e.target;
        if(!t || t.nodeType !== 1) return;
        var btn = (t.closest && typeof t.closest === 'function') ? t.closest(deadBtnSel) : null;
        if(!btn){
          var tn = (t.tagName || '').toLowerCase();
          if(tn === 'button' || (t.className && typeof t.className === 'string' && /(^|\s)(btn|button)(\s|$)/.test(t.className))){
            btn = t;
          }
        }
        if(!btn) return;
        var hasAction = false;
        try{
          if(btn.onclick || (btn.getAttribute && btn.getAttribute('onclick') && btn.getAttribute('onclick').length > 3)) hasAction = true;
        }catch(_x1){}
        try{
          if(btn.getAttribute && btn.getAttribute('data-action')) hasAction = true;
        }catch(_x2){}
        try{
          if(btn.__hasEvt) hasAction = true;
        }catch(_x3){}
        try{
          if(btn.tagName === 'A'){
            var hr = btn.getAttribute && btn.getAttribute('href');
            if(hr && hr !== '#' && hr !== '' && hr !== 'javascript:;' && hr !== 'javascript:void(0)') hasAction = true;
          }
        }catch(_x4){}
        if(hasAction) return;
        e.preventDefault();
        e.stopPropagation();
        var txt = (btn.textContent || '').replace(/\s+/g,' ').trim();
        if(/保存|提交|确认/.test(txt)){
          if(!__acqH9('save_'+txt.slice(0,8), 900)) return;
          __toastH9('✅ 保存成功（演示模式）', 'success');
          setTimeout(function(){
            if(typeof __closeAnyModal === 'function'){ try{ __closeAnyModal(); }catch(_k1){} }
          }, 380);
          return;
        }
        if(/删除|作废|禁用|移除/.test(txt)){
          if(!__acqH9('del_'+txt.slice(0,8), 900)) return;
          if(confirm('确认执行：'+(txt || '该操作')+'？此操作不可撤销！')){
            __toastH9('✅ 操作成功（演示模式）', 'success');
          }
          return;
        }
        if(/编辑|查看|详情/.test(txt)){
          if(!__acqH9('view_'+txt.slice(0,8), 500)) return;
          __toastH9('ℹ️ 已打开详情/编辑（演示模式）', 'info');
          return;
        }
        if(/导出|打印/.test(txt)){
          if(!__acqH9('exp_'+txt.slice(0,8), 1000)) return;
          __toastH9('📤 已触发导出/打印（演示模式）', 'info');
          return;
        }
      }catch(_eBtn){}
    }, true);
    var _origAEL = Element.prototype.addEventListener;
    try{
      Element.prototype.addEventListener = function(type, listener, opts){
        try{
          if((this.tagName === 'BUTTON' || (this.className && typeof this.className === 'string' && /(^|\s)(btn|button)(\s|$)/.test(this.className))) && type === 'click'){
            this.__hasEvt = true;
          }
        }catch(_x){}
        return _origAEL.apply(this, arguments);
      };
    }catch(_eAel){}
    console.info('[SuperPatch 6/6] 死按钮兜底 + toast通道 已挂载');
  }catch(e){ console.warn('[SuperPatch 6/6]', e); }

  console.info('[SuperPatch V20260730 全部 6/6 模块挂载完成]');
})();
</script>

<script id="adminCloseAllModalsOnReady20260730">
  /* 残留模态/叠层自动关闭（解决：orders.html派工单默认遮挡、以及schedule/cast-sheet等页面进入即弹窗Bug）*/
  (function () {
    'use strict';
    try {
      var __FORCE_CLOSE_IDS = [
        'dispatchOverlay','dispatchModal','orderDetailOverlay','orderDetailModal','orderModalOverlay','orderModal',
        'dispatchScheduleOverlay','dispatchScheduleModal','addScheduleModal','scheduleModalOverlay','scheduleModal','scheduleAddOverlay','scheduleAddModal','castDispatchOverlay','castDispatchModal',
        'castDispatchOverlay','castDispatchModal','addCastOverlay','addCastModal','castAddOverlay','castAddModal','showSheetOverlay','showSheetModal',
        'bannerUploadModal','newsModal','operaUploadModal','newsUploadModal','modalBanner','modalNews','modalOpera','contentModal','contentOverlay','bannerOverlay','newsOverlay','operaOverlay',
        'voucherModal','voucherOverlay','receiptModal','receiptOverlay','moneyModal','moneyOverlay','accountsModal','accountsOverlay','attachModal','attachOverlay','invModal','invOverlay','reportModal','reportOverlay','uploadModal','uploadOverlay',
        'staffModal','staffOverlay','wageModal','wageOverlay','cfgModal','cfgOverlay','configModal','configOverlay','operaModal','operaOverlay','addOperaModal','addOperaOverlay',
        'addScheduleModalOnIndex','schedulePreviewModal','staffPreviewModal','operaPreviewModal'
      ];
      var __FORCE_CLOSE_SELECTORS = [
        '[class*="modal-overlay"]','[class*="modalOverlay"]','[class*="overlay"][class*="modal"]','[id$="Overlay"]','[id$="overlay"]',
        '[class*="modal "],[class*="modal-"],[class*="modal:"]','[class*="Modal"]','[id$="Modal"]','[id$="modal"]','[role="dialog"]','[role="alertdialog"]',
        '.s-overlay-hide','.s-modal-hide','.modal-wrap-hide','.modal-overlay-hide','[class*="mask-"]','[class*="Mask"]'
      ];
      function __closeAllNow(reason){
        try {
          for (var _i = 0; _i < __FORCE_CLOSE_IDS.length; _i++) {
            var id = __FORCE_CLOSE_IDS[_i];
            if (!id) continue;
            var el = document.getElementById(id);
            if (!el) continue;
            try { el.classList.add('csp-hide','s-overlay-hide','s-modal-hide','modal-overlay-hide','modal-wrap-hide'); } catch(_e1){}
            try { el.classList.remove('active','show','open','is-open','isOpen','visible','isVisible'); } catch(_e2){}
            try { el.style.setProperty('display','none','important'); } catch(_e3){}
          }
          for (var _j = 0; _j < __FORCE_CLOSE_SELECTORS.length; _j++) {
            try {
              var sel = __FORCE_CLOSE_SELECTORS[_j];
              var list = document.querySelectorAll(sel);
              list.forEach(function (el) {
                try {
                  if (!el) return;
                  var dis = (el.style && el.style.display) || '';
                  var cs = null; try { cs = window.getComputedStyle ? window.getComputedStyle(el) : null; } catch(_eCS){}
                  var visible = (dis && dis !== '' && dis !== 'none') || (cs && cs.display !== 'none');
                  if (!visible) {
                    try { if (!el.classList.contains('csp-hide')) el.classList.add('csp-hide'); } catch(_eNOOP){}
                    return;
                  }
                  try { el.classList.add('csp-hide'); } catch(_eA){}
                  try { el.classList.remove('active','show','open','is-open','isOpen','visible'); } catch(_eB){}
                  try { el.style.setProperty('display','none','important'); } catch(_eC){}
                } catch(_each){}
              });
            } catch(_selErr) {}
          }
          try {
            if (document.body) {
              document.body.style.overflow = '';
              document.body.style.setProperty && document.body.style.setProperty('overflow','auto','');
            }
          } catch(_body){}
          try { if(console && console.info) console.info('[CloseModalsOnReady] 已执行一轮('+reason+')：关闭残留模态+恢复滚动锁'); } catch(_log){}
        } catch (_globalErr) {
          try { if(console && console.warn) console.warn('[CloseModalsOnReady] 异常：', _globalErr); } catch(_e){}
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          setTimeout(function(){ __closeAllNow('DOMContentLoaded+300ms'); }, 300);
          setTimeout(function(){ __closeAllNow('DOMContentLoaded+1000ms'); }, 1000);
          setTimeout(function(){ __closeAllNow('DOMContentLoaded+2500ms'); }, 2500);
        }, { once: true });
      } else {
        __closeAllNow('immediate');
        setTimeout(function(){ __closeAllNow('+300ms'); }, 300);
        setTimeout(function(){ __closeAllNow('+1200ms'); }, 1200);
      }
      try {
        document.addEventListener('keydown', function (ev) {
          if ((ev && ev.key === 'Escape') || (ev && ev.keyCode === 27)) {
            __closeAllNow('ESC pressed');
          }
        }, false);
      } catch(_esc){}
      try { window.__forceCloseAllModalsOnReady = __closeAllNow; } catch(_exp){}
    } catch (_outer) { try { if(console && console.warn) console.warn('[CloseModalsOnReady init err]:', _outer); } catch(_){} }
  })();
</script>
<!-- 2026-08-02 新增：演出演员表配置 按场勾选打印模块（每场单独打印/批量勾选打印/范围控制） -->
<script id="castPrintBySelectionModuleV20260802">
(function(){
  'use strict';
  /* ==================== 常量 & 工具 ==================== */
  var SEC_KEYS = ['creative','mainOpera','addOpera','stage','program','wuchang','wenchang'];
  var OPERA_SECS = ['mainOpera','addOpera']; // 含剧目的板块
  var SEL_CACHE_KEY = '__ps_sel_cache__';    // 剧目勾选记忆 {key_idx: true}
  var SEC_CACHE_KEY = '__ps_sec_cache__';    // 板块勾选记忆 {secKey: true}
  var T_LOCK = 500;
  var $ = function(id){ return document.getElementById(id); };
  var _t = function(msg,type){
    try{ if(window.QinApp && QinApp.Utils && QinApp.Utils.toast){ QinApp.Utils.toast(msg,type||'info',2800); return; } }catch(_){}
    try{ if(window.toast){ window.toast(msg,type||'info'); return; } }catch(_){}
    try{ (type==='error'?alert:console.log)('[PrintBySel] '+msg); }catch(_){}
  };
  if(!window[SEL_CACHE_KEY]){ window[SEL_CACHE_KEY] = {}; }
  if(!window[SEC_CACHE_KEY]){ window[SEC_CACHE_KEY] = {}; }

  /* ==================== 核心：统计 & 视觉 ==================== */
  function refreshPrintSelectionVisual(){
    try{
      // 板块级高亮
      document.querySelectorAll('div.section-block[data-ps-sec]').forEach(function(sec){
        var sk = sec.getAttribute('data-ps-sec');
        var cb = sec.querySelector('input[data-ps-cb-sec="'+sk+'"]');
        var checked = cb && cb.checked;
        sec.classList.toggle('selected-for-print', !!checked);
        if(cb){
          // 对于有剧目的板块，同步 indeterminate 状态
          if(OPERA_SECS.indexOf(sk) !== -1){
            var operCbs = sec.querySelectorAll('input[data-ps-cb-opera="1"]');
            if(operCbs.length>0){
              var selCount = 0;
              operCbs.forEach(function(c){ if(c.checked) selCount++; });
              cb.indeterminate = (selCount>0 && selCount<operCbs.length);
            }
          }
        }
      });
      // 剧目级高亮
      document.querySelectorAll('div.cast-opera-card[data-ps-opera-key]').forEach(function(card){
        var k = card.getAttribute('data-ps-opera-key');
        var i = card.getAttribute('data-ps-opera-idx');
        var cb = card.querySelector('input[data-ps-cb-opera="1"][data-ps-opera-key="'+k+'"][data-ps-opera-idx="'+i+'"]');
        card.classList.toggle('selected-for-print', !!(cb && cb.checked));
      });
    }catch(e){ try{ console.warn('[refreshPrintSelectionVisual err]',e); }catch(_){} }
  }
  function updatePrintStat(){
    var stat = $('printScopeStat'); if(!stat) return;
    try{
      var secSel = 0, secTotal = 0;
      document.querySelectorAll('input[data-ps-cb-sec]').forEach(function(cb){
        secTotal++;
        if(cb.checked) secSel++;
      });
      var opSel = 0, opTotal = 0;
      document.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){
        opTotal++;
        if(cb.checked) opSel++;
      });
      if(secSel===0 && opSel===0){ stat.textContent = '未勾选（请在各板块/剧目左上角勾选要打印的内容）'; stat.style.color = '#dc2626'; }
      else{
        stat.textContent = '已选 ' + secSel + '/' + secTotal + ' 板块 ， ' + opSel + '/' + opTotal + ' 剧目';
        stat.style.color = '#166534';
      }
    }catch(e){ stat.textContent = '统计错误'; }
  }
  function saveSelectionCache(){
    try{
      var op = {};
      document.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){
        var k = cb.getAttribute('data-ps-opera-key'), i = cb.getAttribute('data-ps-opera-idx');
        op[k+'_'+i] = cb.checked;
      });
      window[SEL_CACHE_KEY] = op;
      var sc = {};
      document.querySelectorAll('input[data-ps-cb-sec]').forEach(function(cb){
        sc[cb.getAttribute('data-ps-cb-sec')] = cb.checked;
      });
      window[SEC_CACHE_KEY] = sc;
    }catch(_){}
  }
  function loadDefaultSelection(){
    // 首次启动默认全部勾选，或从缓存恢复
    try{
      var sc = window[SEC_CACHE_KEY] || {};
      document.querySelectorAll('input[data-ps-cb-sec]').forEach(function(cb){
        var k = cb.getAttribute('data-ps-cb-sec');
        cb.checked = (sc[k] !== undefined) ? !!sc[k] : true; // 默认全选
      });
      // 剧目缓存由 renderOperaBlock 读取
      // 然后同步：板块未勾选的 → 其下剧目取消勾选
      OPERA_SECS.forEach(function(sk){
        var sec = document.querySelector('div.section-block[data-ps-sec="'+sk+'"]');
        var secCb = sec && sec.querySelector('input[data-ps-cb-sec="'+sk+'"]');
        if(secCb && !secCb.checked){
          sec.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){ cb.checked = false; });
        }else if(secCb && secCb.checked){
          // 板块勾选但有剧目未被缓存命中，也保持默认勾选（或缓存勾选）
          sec.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){
            var k = cb.getAttribute('data-ps-opera-key'), i = cb.getAttribute('data-ps-opera-idx');
            var cached = window[SEL_CACHE_KEY];
            if(cached[k+'_'+i] === undefined){ cb.checked = true; } // 新剧目默认勾选
          });
        }
      });
      saveSelectionCache();
    }catch(e){ try{ console.warn('[loadDefaultSelection err]',e); }catch(_){} }
  }

  /* ==================== 操作：设勾选 & 联动 ==================== */
  function setSecChecked(secKey, val){
    try{
      var sec = document.querySelector('div.section-block[data-ps-sec="'+secKey+'"]');
      var cb = sec && sec.querySelector('input[data-ps-cb-sec="'+secKey+'"]');
      if(cb) cb.checked = !!val;
      // 含剧目的板块 → 同步其下所有剧目
      if(OPERA_SECS.indexOf(secKey) !== -1 && sec){
        sec.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(ocb){ ocb.checked = !!val; });
      }
      saveSelectionCache();
      refreshPrintSelectionVisual();
      updatePrintStat();
    }catch(e){}
  }
  function setOperaChecked(key, idx, val){
    try{
      var sel = 'input[data-ps-cb-opera="1"][data-ps-opera-key="'+key+'"][data-ps-opera-idx="'+idx+'"]';
      var cb = document.querySelector(sel);
      if(cb) cb.checked = !!val;
      saveSelectionCache();
      refreshPrintSelectionVisual();
      updatePrintStat();
    }catch(e){}
  }
  function selectAll(val){
    try{
      document.querySelectorAll('input[data-ps-cb-sec]').forEach(function(cb){ cb.checked = !!val; });
      document.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){ cb.checked = !!val; });
      saveSelectionCache();
      refreshPrintSelectionVisual();
      updatePrintStat();
      _t(val?'已全选所有板块和剧目（共 '+SEC_KEYS.length+' 板块）':'已清空所有勾选', val?'success':'info');
    }catch(e){ _t('操作失败：'+(e.message||e),'error'); }
  }
  function selectOperaOnly(){
    try{
      // 先清空所有
      document.querySelectorAll('input[data-ps-cb-sec]').forEach(function(cb){ cb.checked = false; });
      document.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){ cb.checked = false; });
      // 然后勾选所有剧目 + 对应的板块
      OPERA_SECS.forEach(function(sk){
        var sec = document.querySelector('div.section-block[data-ps-sec="'+sk+'"]');
        if(!sec) return;
        var secCb = sec.querySelector('input[data-ps-cb-sec="'+sk+'"]');
        if(secCb) secCb.checked = true;
        sec.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){ cb.checked = true; });
      });
      saveSelectionCache();
      refreshPrintSelectionVisual();
      updatePrintStat();
      _t('已仅勾选所有场次剧目（主场+加演）','success');
    }catch(e){ _t('操作失败：'+(e.message||e),'error'); }
  }

  /* ==================== 核心：按勾选打印 ==================== */
  function clearPsHide(){
    try{
      document.querySelectorAll('.__ps_hide__').forEach(function(el){ el.classList.remove('__ps_hide__'); });
    }catch(_){}
  }
  function doPrintSelected(){
    try{
      clearPsHide();
      var secSel = 0, opSel = 0, secTotal=0, opTotal=0;
      document.querySelectorAll('div.section-block[data-ps-sec]').forEach(function(sec){
        var sk = sec.getAttribute('data-ps-sec');
        var secCb = sec.querySelector('input[data-ps-cb-sec="'+sk+'"]');
        secTotal++;
        if(!secCb || !secCb.checked){
          // 板块未勾选 → 整板块隐藏
          sec.classList.add('__ps_hide__');
        }else{
          secSel++;
          // 板块勾选 → 按剧目级复选框细化隐藏
          if(OPERA_SECS.indexOf(sk) !== -1){
            sec.querySelectorAll('div.cast-opera-card').forEach(function(card){
              var k = card.getAttribute('data-ps-opera-key');
              var i = card.getAttribute('data-ps-opera-idx');
              var opCb = card.querySelector('input[data-ps-cb-opera="1"][data-ps-opera-key="'+k+'"][data-ps-opera-idx="'+i+'"]');
              opTotal++;
              if(!opCb || !opCb.checked){ card.classList.add('__ps_hide__'); }
              else{ opSel++; }
            });
          }
        }
      });
      if(secSel===0 && opSel===0){
        clearPsHide();
        _t('请至少勾选一个要打印的板块或剧目','error');
        return;
      }
      // 更新print-header统计
      var ph = $('printDate');
      if(ph){
        ph.textContent = new Date().toLocaleString('zh-CN') + '　|　打印范围：' + secSel + '/' + secTotal + ' 板块 ， ' + opSel + '/' + opTotal + ' 剧目';
      }
      // 保存状态 & 调用主模块 saveState（如果存在）
      try{ if(typeof saveState === 'function'){ saveState(true); } }catch(_){}
      // 清理afterprint监听器避免叠加
      try{ window.removeEventListener('afterprint', _afterPrintCleanup); }catch(_){}
      window.addEventListener('afterprint', _afterPrintCleanup, {once:true});
      setTimeout(function(){
        try{ window.print(); }catch(e){ _t('打印失败：'+(e.message||e),'error'); clearPsHide(); }
      }, 280);
    }catch(e){
      clearPsHide();
      _t('按勾选打印失败：'+(e.message||e),'error');
    }
  }
  function _afterPrintCleanup(){
    try{ clearPsHide(); }catch(_){}
    try{
      var ph = $('printDate');
      if(ph){ ph.textContent = new Date().toLocaleString('zh-CN'); }
    }catch(_){}
  }
  /* 整页打印前也清理残留 __ps_hide__（以防用户按勾选后又点整页打印） */
  function doFullPrint(){
    clearPsHide();
    try{ if(typeof saveState === 'function'){ $('printDate').textContent = new Date().toLocaleString('zh-CN'); saveState(true); } }catch(_){}
    setTimeout(function(){ try{ window.print(); }catch(e){ _t('打印失败：'+(e.message||e),'error'); } }, 200);
  }

  /* ==================== 事件绑定 ==================== */
  function bindEvents(){
    try{
      // 板块复选框
      document.addEventListener('change', function(e){
        var t = e.target;
        if(t && t.nodeName==='INPUT' && t.getAttribute && t.getAttribute('data-ps-cb-sec')){
          var sk = t.getAttribute('data-ps-cb-sec');
          if(OPERA_SECS.indexOf(sk) !== -1){
            var sec = document.querySelector('div.section-block[data-ps-sec="'+sk+'"]');
            if(sec){
              sec.querySelectorAll('input[data-ps-cb-opera="1"]').forEach(function(cb){ cb.checked = t.checked; });
            }
          }
          saveSelectionCache();
          refreshPrintSelectionVisual();
          updatePrintStat();
        }
      }, true);
      // 剧目复选框
      document.addEventListener('change', function(e){
        var t = e.target;
        if(t && t.nodeName==='INPUT' && t.getAttribute && t.getAttribute('data-ps-cb-opera')==='1'){
          saveSelectionCache();
          refreshPrintSelectionVisual();
          updatePrintStat();
        }
      }, true);
      // 顶部条按钮
      var sa = $('psSelectAll'); if(sa){ sa.addEventListener('click', function(){ selectAll(true); }, false); }
      var ca = $('psClearAll'); if(ca){ ca.addEventListener('click', function(){ selectAll(false); }, false); }
      var so = $('psSelectOperaOnly'); if(so){ so.addEventListener('click', selectOperaOnly, false); }
      var ps = $('btnPrintSelected'); if(ps){ ps.addEventListener('click', doPrintSelected, false); }
      var ps2 = $('btnPrintSelected2'); if(ps2){ ps2.addEventListener('click', doPrintSelected, false); }
      // 整页打印按钮（替换原来的简单绑定）
      var bp = $('btnPrint');
      if(bp){
        // 如果原来有绑定，替换前覆盖
        bp.addEventListener('click', function(ev){ try{ ev.preventDefault(); ev.stopPropagation(); }catch(_){} doFullPrint(); return false; }, true);
      }
      // afterprint兜底
      window.addEventListener('afterprint', function(){
        setTimeout(function(){ clearPsHide(); try{ if(typeof refreshPrintSelectionVisual==='function') refreshPrintSelectionVisual(); }catch(_){} }, 60);
      }, false);
    }catch(e){ try{ console.warn('[bindEvents err]',e); }catch(_){} }
  }

  /* ==================== 暴露给 renderOperaBlock 用 ==================== */
  window.refreshPrintSelectionVisual = refreshPrintSelectionVisual;
  window.updatePrintStat = updatePrintStat;

  /* ==================== 初始化（DOMContentLoaded 后） ==================== */
  function init(){
    try{
      loadDefaultSelection();
      bindEvents();
      setTimeout(function(){ refreshPrintSelectionVisual(); updatePrintStat(); }, 60);
    }catch(e){ try{ console.warn('[PrintBySel init err]',e); }catch(_){} }
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', init, false); }
  else{ setTimeout(init, 80); }
})();
</script>
<!-- 2026-08-02 新增：演出演员表配置 多场存档管理 CRUD 模块（修复演示模式toast + 支持多场演出阵容切换/存档/删除） -->
<script id="castSheetsCRUDModuleV20260802">
(function(){
  'use strict';
  /* ==================== 常量 & 工具 ==================== */
  var K_LIST   = 'cast_sheets_v1';          // 演出存档索引列表
  var K_ACTIVE = 'cast_sheet_active_v1';    // 当前激活的演出ID
  var K_PREFIX = 'cast_sheet_data_';        // 单个演出阵容数据 key 前缀
  var T_LOCK   = 700;
  var $ = function(id){ return document.getElementById(id); };
  var _t = function(msg,type){
    try{ if(window.QinApp && QinApp.Utils && QinApp.Utils.toast){ QinApp.Utils.toast(msg,type||'info',2800); return; } }catch(_){}
    try{ if(window.toast){ window.toast(msg,type||'info'); return; } }catch(_){}
    try{ (type==='error'?alert:console.log)('[CastSheets] '+msg); }catch(_){}
  };
  var _acq = function(k,ttl){
    if(window.__OP_LOCKS && window.__OP_LOCKS[k]) return false;
    try{
      if(!window.__OP_LOCKS) window.__OP_LOCKS = {};
      window.__OP_LOCKS[k] = true;
      setTimeout(function(){try{delete window.__OP_LOCKS[k];}catch(_){}}, ttl||T_LOCK);
    }catch(_){}
    return true;
  };
  var _now = function(){ return Date.now(); };
  var _uid = function(){
    try{
      var a = new Uint8Array(8);
      window.crypto.getRandomValues(a);
      return 'CS_' + Array.from(a).map(function(b){return b.toString(16).padStart(2,'0');}).join('') + (_now()%10000).toString(36);
    }catch(_){
      return 'CS_' + _now().toString(36) + Math.random().toString(36).slice(2,8);
    }
  };
  var _safeGet = function(k,def){
    try{ var r = localStorage.getItem(k); if(r==null) return def; return JSON.parse(r); }catch(_){ return def; }
  };
  var _safeSet = function(k,v){
    try{ localStorage.setItem(k, JSON.stringify(v)); return true; }catch(e){ _t('存储失败：'+(e&&e.message?e.message:e),'error'); return false; }
  };
  var _fmtDate = function(ts){
    try{
      var d = new Date(ts);
      function p(n){ return n<10?'0'+n:''+n; }
      return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+' '+p(d.getHours())+':'+p(d.getMinutes());
    }catch(_){ return ''; }
  };
  var _escape = function(s){
    if(s==null) return '';
    return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});
  };

  /* ==================== 数据访问层 ==================== */
  function listSheets(){
    var arr = _safeGet(K_LIST, []);
    if(!Array.isArray(arr)) return [];
    return arr.sort(function(a,b){ return (b.updatedAt||0)-(a.updatedAt||0); });
  }
  function saveSheetsList(list){
    _safeSet(K_LIST, list);
  }
  function getActiveId(){
    return _safeGet(K_ACTIVE, '');
  }
  function setActiveId(id){
    _safeSet(K_ACTIVE, id || '');
  }
  function getDataKey(id){ return K_PREFIX + (id||''); }
  function loadSheetData(id){
    return _safeGet(getDataKey(id), null);
  }
  function saveSheetData(id, data){
    return _safeSet(getDataKey(id), data);
  }
  function deleteSheetData(id){
    try{ localStorage.removeItem(getDataKey(id)); }catch(_){}
  }

  /* ==================== 与现有 cast-sheet 主模块集成 ==================== */
  // 获取主模块暴露的 state 与核心函数
  function _getCore(){
    // 主 cast-sheet 脚本的 IIFE 内变量无法直接访问；通过全局约定桥接
    // 策略：通过直接读写 LS_KEY('qaxqjt_cast_sheet_v3') + 触发主模块 reload
    // 另外，主模块的 saveState/loadState/state/resetState/renderAll 通过 window 桥接
    try{
      if(window.__CastSheetCore) return window.__CastSheetCore;
    }catch(_){}
    return null;
  }
  // 桥接：把主模块核心函数挂到 window.__CastSheetCore（主模块无全局，通过 DOM 事件/存储间接交互）
  function _bridge(){
    // 主模块使用的 LS_KEY
    var LS_KEY = 'qaxqjt_cast_sheet_v3';
    window.__CastSheetCore = {
      LS_KEY: LS_KEY,
      getCurrentRaw: function(){ return _safeGet(LS_KEY, null); },
      setCurrentRaw: function(data){ return _safeSet(LS_KEY, data); },
      // 触发主模块重新渲染：dispatch storage 事件 + 手动调用主模块 init 入口（若存在）
      reload: function(){
        try{
          // 广播 storage 事件（同标签页同步）
          var ev = document.createEvent('Event');
          ev.initEvent('cast-sheet-reload', true, true);
          document.dispatchEvent(ev);
        }catch(_){}
        // 尝试找主模块的 init()：由于它在 IIFE 内部，无法直接调；用 location.reload 兜底
        // 更轻量方案：使用主模块的 state/mergeDefault/renderAll 全局引用（若有）
        try{
          if(typeof window.renderAll === 'function'){ window.renderAll(); return; }
        }catch(_){}
        try{ if(typeof window.renderAllCastSheet === 'function'){ window.renderAllCastSheet(); return; } }catch(_){}
        // 最后兜底：温和刷新页面
        setTimeout(function(){ try{ location.reload(); }catch(_){} }, 120);
      }
    };
  }
  _bridge();

  /* ==================== UI 渲染 ==================== */
  function renderSelect(){
    var sel = $('csSheetSelect');
    var info = $('csSheetInfo');
    if(!sel) return;
    var list = listSheets();
    var activeId = getActiveId();
    sel.innerHTML = '';
    // 默认占位项
    if(list.length === 0){
      var opt0 = document.createElement('option');
      opt0.value = '';
      opt0.textContent = '（暂无存档，点击「新建演出」创建）';
      sel.appendChild(opt0);
    } else {
      list.forEach(function(s){
        var o = document.createElement('option');
        o.value = s.id || '';
        var label = (s.name||'未命名演出') + (s.date ? ' · '+s.date : '') + (s.venue ? ' · '+s.venue : '');
        o.textContent = label;
        if(s.id === activeId) o.selected = true;
        sel.appendChild(o);
      });
    }
    // 当前存档信息
    if(activeId){
      var cur = list.filter(function(s){return s.id===activeId;})[0] || null;
      if(cur){
        var line = '✅ 当前存档：' + _escape(cur.name||'未命名');
        if(cur.updatedAt) line += ' ｜ 更新：' + _fmtDate(cur.updatedAt);
        if(cur.createdAt) line += ' ｜ 创建：' + _fmtDate(cur.createdAt);
        if(info) info.textContent = line;
      } else if(info){
        info.textContent = '⚠️ 当前存档ID无效，请重新选择或新建';
      }
    } else if(info){
      info.textContent = '💡 提示：新建或选择一个存档开始编辑阵容，编辑后点「保存本地」或「另存为新存档」';
    }
  }

  /* ==================== 业务动作 ==================== */
  function _getCurrentMeta(){
    // 从当前表单输入提取演出元信息（不通过主模块state直接读input，避免IIFE内变量）
    var title = ''; var date = ''; var venue = '';
    try{ var t = $('inp-title'); if(t) title = (t.value||'').trim(); }catch(_){}
    try{ var d = $('inp-date'); if(d) date = (d.value||'').trim(); }catch(_){}
    try{ var v = $('inp-venue'); if(v) venue = (v.value||'').trim(); }catch(_){}
    if(!title){
      // 从主模块的当前原始数据里取
      try{
        var raw = window.__CastSheetCore.getCurrentRaw();
        if(raw && raw.header){
          title = title || (raw.header.title||'');
          date  = date  || (raw.header.date||'');
          venue = venue || (raw.header.venue||'');
        }
      }catch(_){}
    }
    return { title:title||'', date:date||'', venue:venue||'' };
  }

  function doNew(){
    if(!_acq('cs_new', 800)) return _t('⏳ 新建处理中，请稍候…','warning');
    var meta = _getCurrentMeta();
    var defaultName = meta.title || (new Date().toISOString().slice(0,10)+' 秦腔惠民演出');
    var name = window.prompt('请输入新演出名称：', defaultName);
    if(name == null) return;
    name = (name||'').trim();
    if(!name) return _t('⚠️ 演出名称不能为空','error');
    if(name.length > 80) return _t('⚠️ 演出名称过长（≤80字）','error');
    var id = _uid();
    var now = _now();
    // 新存档使用默认空白模板（不是重置当前编辑内容）
    try{
      // 保存一条"默认模板"到新存档 data：用主模块的 mergeDefault(defaultState()) 生成
      // 由于主模块函数在 IIFE 内部不可直接访问，存 null，切换过去时主模块会用默认模板初始化
      // 但为了立即拥有模板，我们用：读取当前编辑区内容作为初始（如果用户想复制当前）
      // 更合理：新存档 = 空白模板 → 存储 {isNew: true} 由主模块加载时初始化
      saveSheetData(id, { __csTemplateBlank: true, createdAt: now });
      var list = listSheets();
      list.push({
        id: id,
        name: name,
        date: meta.date || '',
        venue: meta.venue || '',
        createdAt: now,
        updatedAt: now
      });
      saveSheetsList(list);
      setActiveId(id);
      // 将编辑区切到空白
      var core = window.__CastSheetCore;
      if(core){
        // 写入一个"空"结构让主模块 mergeDefault 生效 → 写 null 即可
        try{ localStorage.removeItem(core.LS_KEY); }catch(_){}
        core.reload();
      }
      renderSelect();
      _t('✨ 已创建新演出存档：「'+name+'」，已切换到该存档','success');
    }catch(e){
      _t('创建演出存档失败：'+(e&&e.message?e.message:e),'error');
    }
  }

  function doSwitch(newId){
    if(!newId) return;
    if(!_acq('cs_switch_'+newId, 800)) return _t('⏳ 切换处理中，请稍候…','warning');
    var list = listSheets();
    var target = list.filter(function(s){return s.id===newId;})[0];
    if(!target) return _t('⚠️ 目标存档不存在','error');
    var core = window.__CastSheetCore;
    if(!core) return _t('⚠️ 主模块未就绪，切换失败','error');
    try{
      // 先把当前编辑区的数据写回 原激活存档（自动保存）
      var oldId = getActiveId();
      if(oldId){
        var curRaw = core.getCurrentRaw();
        if(curRaw && !curRaw.__csTemplateBlank){
          saveSheetData(oldId, curRaw);
          var meta = _getCurrentMeta();
          var oList = listSheets();
          var oIdx = -1;
          for(var k=0;k<oList.length;k++) if(oList[k].id===oldId){oIdx=k;break;}
          if(oIdx>=0){
            oList[oIdx].updatedAt = _now();
            if(meta.title) oList[oIdx].name = meta.title;
            if(meta.date)  oList[oIdx].date = meta.date;
            if(meta.venue) oList[oIdx].venue = meta.venue;
            saveSheetsList(oList);
          }
        }
      }
      // 切到目标存档
      var tData = loadSheetData(newId);
      if(tData && tData.__csTemplateBlank){
        try{ localStorage.removeItem(core.LS_KEY); }catch(_){}
      } else {
        core.setCurrentRaw(tData || {});
      }
      setActiveId(newId);
      renderSelect();
      core.reload();
      _t('🔁 已切换到存档：「'+(target.name||'未命名')+'」','success');
    }catch(e){
      _t('切换存档失败：'+(e&&e.message?e.message:e),'error');
    }
  }

  function doSaveAs(){
    if(!_acq('cs_saveas', 900)) return _t('⏳ 另存为处理中，请稍候…','warning');
    var meta = _getCurrentMeta();
    var core = window.__CastSheetCore;
    if(!core) return _t('⚠️ 主模块未就绪','error');
    var defaultName = (meta.title || '副本_'+_fmtDate(_now()).slice(0,10)) + ' - 副本';
    var name = window.prompt('请输入新存档名称：', defaultName);
    if(name == null) return;
    name = (name||'').trim();
    if(!name) return _t('⚠️ 存档名称不能为空','error');
    if(name.length > 80) return _t('⚠️ 存档名称过长（≤80字）','error');
    try{
      var curRaw = core.getCurrentRaw();
      if(!curRaw || (Object.keys(curRaw).length===0 && !meta.title)){
        if(!confirm('当前编辑区内容为空，确定要另存为一个新存档吗？')) return;
      }
      var id = _uid();
      var now = _now();
      saveSheetData(id, curRaw || {});
      var list = listSheets();
      list.push({
        id: id,
        name: name,
        date: meta.date || '',
        venue: meta.venue || '',
        createdAt: now,
        updatedAt: now
      });
      saveSheetsList(list);
      setActiveId(id);
      renderSelect();
      _t('💾 已另存为新存档：「'+name+'」，当前已切换','success');
    }catch(e){
      _t('另存为失败：'+(e&&e.message?e.message:e),'error');
    }
  }

  function doDelete(){
    if(!_acq('cs_del', 850)) return _t('⏳ 删除处理中，请稍候…','warning');
    var id = getActiveId();
    var list = listSheets();
    var cur = list.filter(function(s){return s.id===id;})[0];
    if(!id || !cur) return _t('⚠️ 请先选择一个要删除的存档','warning');
    var totalRole = 0;
    try{
      var raw = loadSheetData(id);
      if(raw){
        if(Array.isArray(raw.creative)) totalRole += raw.creative.length;
        if(Array.isArray(raw.mainOpera)) raw.mainOpera.forEach(function(o){totalRole += (o.cast||[]).length;});
        if(Array.isArray(raw.addOpera))  raw.addOpera.forEach(function(o){totalRole += (o.cast||[]).length;});
        if(Array.isArray(raw.wuchang))  totalRole += raw.wuchang.length;
        if(Array.isArray(raw.wenchang)) totalRole += raw.wenchang.length;
        if(Array.isArray(raw.stage))    totalRole += raw.stage.length;
        if(Array.isArray(raw.program))  totalRole += raw.program.length;
      }
    }catch(_){}
    var msg = '⚠️ 确认删除演出存档「'+(cur.name||'未命名')+'」？\n\n该存档含约 '+totalRole+' 条主创/角色/乐队/节目配置，删除后不可恢复。\n\n（删除不影响当前编辑区内容）';
    if(!confirm(msg)) return;
    try{
      var newList = list.filter(function(s){return s.id!==id;});
      saveSheetsList(newList);
      deleteSheetData(id);
      if(getActiveId() === id){
        setActiveId('');
        var core = window.__CastSheetCore;
        if(core){ try{ localStorage.removeItem(core.LS_KEY); }catch(_){} core.reload(); }
      }
      renderSelect();
      _t('🗑️ 已删除演出存档：「'+(cur.name||'未命名')+'」','success');
    }catch(e){
      _t('删除失败：'+(e&&e.message?e.message:e),'error');
    }
  }

  /* ==================== 与主模块「保存本地」按钮联动：同步写回激活存档 ==================== */
  function _hookSaveButton(){
    // 每次用户点「💾 保存本地」，除了主模块保存到 LS_KEY，也同时写回 当前激活存档
    try{
      var btn = $('btnSave');
      if(btn && !btn.__csHooked){
        btn.addEventListener('click', function(){
          setTimeout(function(){
            try{
              var id = getActiveId();
              if(!id) return; // 没选存档，仅存在当前编辑区即可
              var core = window.__CastSheetCore;
              if(!core) return;
              var raw = core.getCurrentRaw();
              if(!raw) return;
              saveSheetData(id, raw);
              var meta = _getCurrentMeta();
              var list = listSheets();
              var idx = -1;
              for(var i=0;i<list.length;i++) if(list[i].id===id){idx=i;break;}
              if(idx>=0){
                list[idx].updatedAt = _now();
                if(meta.title) list[idx].name = meta.title;
                if(meta.date)  list[idx].date = meta.date;
                if(meta.venue) list[idx].venue = meta.venue;
                saveSheetsList(list);
                renderSelect();
              }
            }catch(_eSync){ console.warn('[CastSheets] 同步写回激活存档失败',_eSync); }
          }, 120);
        }, true);
        btn.__csHooked = 1;
      }
    }catch(_hb){}
  }

  /* ==================== 首次启动：如果有激活存档，把它的数据刷入主模块编辑区 ==================== */
  function _initBoot(){
    try{
      var id = getActiveId();
      if(id){
        var list = listSheets();
        var cur = list.filter(function(s){return s.id===id;})[0];
        if(cur){
          var data = loadSheetData(id);
          var core = window.__CastSheetCore;
          if(core && data && !data.__csTemplateBlank){
            core.setCurrentRaw(data);
          }
        }
      }
    }catch(_bt){}
  }

  /* ==================== 绑定事件 ==================== */
  function bind(){
    try{
      var sel = $('csSheetSelect');
      if(sel){
        sel.addEventListener('change', function(e){
          var v = (e.target||sel).value;
          if(v) doSwitch(v);
        }, true);
      }
      var bNew = $('csBtnNew');     if(bNew) bNew.addEventListener('click',function(e){e.preventDefault&&e.preventDefault();doNew();},true);
      var bSa  = $('csBtnSaveAs');  if(bSa)  bSa.addEventListener('click',function(e){e.preventDefault&&e.preventDefault();doSaveAs();},true);
      var bDel = $('csBtnDelete');  if(bDel) bDel.addEventListener('click',function(e){e.preventDefault&&e.preventDefault();doDelete();},true);
      _hookSaveButton();
    }catch(e){ console.warn('[CastSheets] bind err', e); }
  }

  /* ==================== seed：如果用户已保存了 qaxqjt_cast_sheet_v3 但还无存档列表，把当前内容升级为第一个存档 ==================== */
  function _seedFromLegacy(){
    try{
      var list = listSheets();
      if(list.length > 0) return;
      var core = window.__CastSheetCore;
      if(!core) return;
      var raw = core.getCurrentRaw();
      if(!raw) return;
      var h = (raw && raw.header) || {};
      var name = h.title || (new Date().toISOString().slice(0,10)+' 演出阵容（自动导入）');
      var id = _uid();
      var now = _now();
      saveSheetData(id, raw);
      saveSheetsList([{ id:id, name:name, date:h.date||'', venue:h.venue||'', createdAt:now, updatedAt:now }]);
      setActiveId(id);
      _t('📥 已自动将上次编辑内容导入为第一个存档：「'+name+'」','info');
    }catch(_sd){}
  }

  /* ==================== 启动 ==================== */
  function start(){
    try{
      _seedFromLegacy();
      renderSelect();
      bind();
      _initBoot();
      console.info('[CastSheetsCRUD V20260802] 多场演出存档管理已挂载：共 '+listSheets().length+' 个存档');
    }catch(e){ console.warn('[CastSheetsCRUD V20260802] init err:', e); }
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){ setTimeout(start, 200); });
  } else {
    setTimeout(start, 200);
  }
  // 主模块完成 renderAll 后再刷新一次（避免时序竞争）
  try{ setTimeout(start, 900); }catch(_){}
})();
</script>
<!-- ================================================================
     2026-08-02 ✅ TroupeTemplateModuleV20260802 · 民营剧团组团模板模块
     功能：1. 5大岗位组模板库（演员/乐队/前场/服装/电工）
           2. 一键载入30-40人标配样板 / 另存为模板 / 模板管理 / 模板CRUD
           3. 顶部人数统计条（自动统计各板块 + 标配检测）
================================================================ -->
<script id="troupeTemplateModuleV20260802">
(function(){
  'use strict';
  /* ==================== 常量 & 工具 ==================== */
  var LS_KEY   = 'qaxqjt_troupe_templates_v1';   // 模板库 localStorage key
  var CREW_KEY = 'qaxqjt_performers_db_v1';      // 演职行当库
  var ACTIVE_KEY= 'qaxqjt_cast_sheet_v3';        // 当前正在编辑的阵容
  var MIN_STANDARD = 30;   // 民营团标配下限
  var MAX_STANDARD = 40;   // 民营团标配上限
  var TL = 500;

  // 5 大岗位组（key → 中文标题 + 色class + 典型子岗位默认名）
  var GROUPS = {
    actor:     { name:'演员组',   cls:'tpg-actor',   sample:['老生','小生','花旦','青衣','花脸','丑角','武生','老旦','彩旦','武旦','B角替补1','B角替补2','实习A','实习B','实习C'] },
    band:      { name:'乐队组',   cls:'tpg-band',    sample:['司鼓（板鼓）','大锣','铙钹','小锣','梆子·武场5人','板胡','二胡','扬琴','琵琶','三弦','唢呐·海笛','大提琴','笛子笙·文场8人'] },
    front:     { name:'前场组',   cls:'tpg-front',   sample:['舞台监督★','前台主任','检票员1','检票员2','观众引导1','观众引导2','字幕操作','催场','话筒递麦员','茶水协调'] },
    costume:   { name:'服装化妆组',cls:'tpg-costume', sample:['服装师','盔箱师傅','化妆师（包头）','化妆助理','道具师','道具助理','服装缝纫机动','衣箱（蟒靠）'] },
    electric:  { name:'电工技术组',cls:'tpg-electric',sample:['灯光师','灯光助理2人','音响师','音响助理','VJ·LED屏','配电电工','追光操作','设备机动','发电机值守'] }
  };
  var G_KEYS = Object.keys(GROUPS);

  var $ = function(id){ return document.getElementById(id); };
  var _t = function(msg,type){
    try{ if(window.QinApp && QinApp.Utils && QinApp.Utils.toast){ QinApp.Utils.toast(msg,type||'info',2800); return; } }catch(_){}
    try{ (type==='error'?alert:console.log)('[Troupe] '+msg); }catch(_){}
  };
  var _acq = function(k,ttl){
    if(window.__OP_LOCKS && window.__OP_LOCKS[k]) return false;
    try{
      if(!window.__OP_LOCKS) window.__OP_LOCKS = {};
      window.__OP_LOCKS[k] = true;
      setTimeout(function(){try{delete window.__OP_LOCKS[k];}catch(_){}}, ttl||TL);
    }catch(_){}
    return true;
  };
  var _now = function(){ return Date.now(); };
  var _uid = function(prefix){
    prefix = prefix || 'TP';
    try{
      var a = new Uint8Array(6);
      window.crypto.getRandomValues(a);
      return prefix + '_' + Array.from(a).map(function(b){return b.toString(16).padStart(2,'0');}).join('').toUpperCase();
    }catch(_){
      return prefix + '_' + _now().toString(36) + Math.random().toString(36).slice(2,8);
    }
  };
  var _safeGet = function(k,def){
    try{ var r = localStorage.getItem(k); if(r==null) return def; return JSON.parse(r); }catch(_){ return def; }
  };
  var _safeSet = function(k,v){
    try{ localStorage.setItem(k, JSON.stringify(v)); return true; }catch(e){ _t('存储失败：'+(e&&e.message?e.message:e),'error'); return false; }
  };
  var _escape = function(s){
    if(s==null) return '';
    return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});
  };

  /* ==================== 模板库访问层 ==================== */
  function listTemplates(){
    var arr = _safeGet(LS_KEY, null);
    if(!arr){
      // 首次：内置3个行业标准模板
      arr = _seedDefaultTemplates();
      _safeSet(LS_KEY, arr);
    }
    if(!Array.isArray(arr)) return [];
    return arr.sort(function(a,b){ return (b.updatedAt||0)-(a.updatedAt||0); });
  }
  function saveTemplates(list){ _safeSet(LS_KEY, list); }
  function getTemplate(id){
    return listTemplates().filter(function(t){return t.id===id;})[0] || null;
  }
  function upsertTemplate(tpl){
    var list = listTemplates();
    var idx = -1;
    for(var i=0;i<list.length;i++){ if(list[i].id===tpl.id){ idx=i; break; } }
    tpl.updatedAt = _now();
    if(idx<0){
      tpl.createdAt = tpl.updatedAt;
      list.unshift(tpl);
      _t('✅ 模板「'+tpl.name+'」已创建','success');
    } else {
      list[idx] = tpl;
      _t('✅ 模板「'+tpl.name+'」已更新','success');
    }
    saveTemplates(list);
    return tpl;
  }
  function deleteTemplate(id){
    var list = listTemplates();
    var tpl = null;
    for(var i=0;i<list.length;i++){ if(list[i].id===id){ tpl=list[i]; break; } }
    if(!tpl){ return false; }
    if(!confirm('确认删除组团模板「'+tpl.name+'」？此操作无法撤销。')){ return false; }
    list = list.filter(function(t){return t.id!==id;});
    saveTemplates(list);
    _t('🗑 模板「'+tpl.name+'」已删除','info');
    return true;
  }
  function duplicateTemplate(id){
    var src = getTemplate(id);
    if(!src) return null;
    var copy = JSON.parse(JSON.stringify(src));
    copy.id = _uid('TP');
    copy.name = (src.name || '模板') + '（副本）';
    copy.createdAt = copy.updatedAt = _now();
    var list = listTemplates();
    list.unshift(copy);
    saveTemplates(list);
    _t('📋 已复制模板为「'+copy.name+'」','success');
    return copy;
  }

  /* ==================== 默认模板种子（行业标准：秦腔民营团 36人/32人/40人） ==================== */
  function _makeTroupe36(){
    var g = {};
    g.actor = [
      {pos:'老生（须生）',name:'', note:'A角'},
      {pos:'小生',name:'', note:'A角'},
      {pos:'花旦',name:'', note:'A角'},
      {pos:'青衣（正旦）',name:'', note:'A角'},
      {pos:'花脸（大净）',name:'', note:'A角'},
      {pos:'花脸（二净/副净）',name:'', note:''},
      {pos:'丑角',name:'', note:''},
      {pos:'武生',name:'', note:''},
      {pos:'老旦',name:'', note:''},
      {pos:'彩旦',name:'', note:''},
      {pos:'武旦',name:'', note:''},
      {pos:'老生B角',name:'', note:''},
      {pos:'青衣B角',name:'', note:''},
      {pos:'花旦B角',name:'', note:''},
      {pos:'小生B角',name:'', note:''},
      {pos:'实习演员1',name:'', note:''},
      {pos:'实习演员2',name:'', note:''},
      {pos:'实习演员3',name:'', note:''}
    ];   // 18 人
    g.band = [
      {pos:'司鼓·板鼓',name:'', note:'武场领班'},
      {pos:'大锣',name:'', note:''},
      {pos:'铙钹',name:'', note:''},
      {pos:'小锣',name:'', note:''},
      {pos:'梆子',name:'', note:'武场合计5人'},
      {pos:'板胡（秦腔领奏）',name:'', note:'文场领班'},
      {pos:'二胡',name:'', note:''},
      {pos:'扬琴',name:'', note:''},
      {pos:'琵琶',name:'', note:''},
      {pos:'三弦',name:'', note:''},
      {pos:'唢呐·海笛',name:'', note:''},
      {pos:'大提琴',name:'', note:''},
      {pos:'笛子/笙',name:'', note:'文场合计8人'}
    ];  // 13 人
    g.front = [
      {pos:'舞台监督★',name:'', note:'全场总控'},
      {pos:'前台主任',name:'', note:''},
      {pos:'检票/引导1',name:'', note:''},
      {pos:'检票/引导2',name:'', note:''},
      {pos:'字幕操作',name:'', note:''}
    ];  // 5 人
    g.costume = [
      {pos:'服装师',name:'', note:''},
      {pos:'盔箱师傅',name:'', note:'秦腔特色岗'},
      {pos:'化妆师（包头）',name:'', note:''}
    ];  // 3 人
    g.electric = [
      {pos:'灯光师',name:'', note:''},
      {pos:'音响师',name:'', note:''},
      {pos:'VJ·LED屏操作',name:'', note:''},
      {pos:'配电电工',name:'', note:''},
      {pos:'灯光助理',name:'', note:''},
      {pos:'追光操作',name:'', note:''}
    ];  // 6 人
    var total = 18+13+5+3+6;  // 45，需要裁剪到 36
    // 裁剪：演员组-实习3人(剩15)、电工组-灯光助理+追光(剩4)、前场-检票2(剩3)
    g.actor = g.actor.slice(0, 14);   // 14
    g.electric = g.electric.slice(0, 4);  // 4
    g.front = g.front.slice(0, 3);     // 3
    // 14+13+3+3+4 = 37，再裁演员1人
    g.actor = g.actor.slice(0, 13);
    return g;   // 13+13+3+3+4 = 36 人
  }
  function _seedDefaultTemplates(){
    var g36 = _makeTroupe36();
    // 32人标准版
    var g32 = JSON.parse(JSON.stringify(g36));
    g32.actor = g32.actor.slice(0, 11);     // 11
    g32.band = g32.band.slice(0, 11);       // 11（武场5+文场6）
    g32.front = g32.front.slice(0, 2);      // 2
    g32.costume = g32.costume.slice(0, 3);  // 3
    g32.electric = g32.electric.slice(0, 5);// 5
    // 11+11+2+3+5=32
    // 40人加强版
    var g40 = JSON.parse(JSON.stringify(g36));
    g40.actor = g40.actor.concat([
      {pos:'实习演员4',name:''},{pos:'实习演员5',name:''},{pos:'实习演员6',name:''},{pos:'实习演员7',name:''}
    ]);  // 13+4=17
    g40.front = g40.front.concat([{pos:'催场员',name:''},{pos:'话筒递麦员',name:''}]);
    g40.electric = g40.electric.concat([{pos:'音响助理',name:''},{pos:'设备机动',name:''}]);
    // 17+13+5+3+4 = 42 -> 裁演员2
    g40.actor = g40.actor.slice(0, 15);
    return [
      {
        id: _uid('TP'),
        name: '【行业标准】秦腔民营团·36人标配版（推荐）',
        desc: '最均衡配置：演员13+乐队13+前场3+服装3+电工4，适合乡村庙会/文化惠民常规日场+夜场',
        scale: 'standard-36',
        groups: g36,
        createdAt: _now(),
        updatedAt: _now(),
        builtin: true
      },
      {
        id: _uid('TP'),
        name: '【紧凑版】秦腔民营团·32人精简版',
        desc: '小场地/短期下乡适用：实习演员减少，文场部分岗位由演员兼任',
        scale: 'compact-32',
        groups: g32,
        createdAt: _now(),
        updatedAt: _now(),
        builtin: true
      },
      {
        id: _uid('TP'),
        name: '【加强版】秦腔民营团·40人峰会版',
        desc: '县庆/重大节庆/精品剧目演出：演员+前场+电工加强，含替补',
        scale: 'enhanced-40',
        groups: g40,
        createdAt: _now(),
        updatedAt: _now(),
        builtin: true
      }
    ];
  }

  /* ==================== 统计 & UI 刷新（顶部人数条） ==================== */
  function countGroup(group){
    if(!Array.isArray(group)) return 0;
    return group.filter(function(r){return r && (r.name && String(r.name).trim() || r.pos && String(r.pos).trim());}).length;
  }
  function statsFromGroups(groups){
    var s = { actor:0, band:0, front:0, costume:0, electric:0 };
    for(var k in s){
      if(!groups || !groups[k]) continue;
      s[k] = countGroup(groups[k]);
    }
    s.total = s.actor + s.band + s.front + s.costume + s.electric;
    s.status = (s.total >= MIN_STANDARD && s.total <= MAX_STANDARD) ? 'ok'
              : (s.total < MIN_STANDARD ? 'warn' : 'bad');
    s.statusText = s.status==='ok' ? ('✅ 达标 '+s.total+'人')
                 : s.status==='warn' ? ('⚠️ 不足 '+s.total+'/'+MIN_STANDARD)
                 : ('🔥 超员 '+s.total+'/'+MAX_STANDARD);
    return s;
  }
  // 从当前阵容的7个板块统计（反向：舞台保障→服装/前场/电工，武场文场→乐队，各剧目的角色→演员）
  function statsFromCurrentCast(){
    // 简化策略：尝试从 PERFORMERS_DB 或 ACTIVE_KEY 中的 groups 字段读出；若不存在则返回全0
    // 主模块没有 groups 字段时，我们返回0，等用户载入模板后就会刷新
    try{
      var raw = _safeGet(ACTIVE_KEY, null);
      if(raw && raw.__troupeGroups){
        return statsFromGroups(raw.__troupeGroups);
      }
    }catch(_){}
    return statsFromGroups({});
  }
  function refreshTopBar(){
    var s = statsFromCurrentCast();
    var el;
    el = $('tp-total');     if(el){ el.className='tb-stat '+(s.status==='ok'?'ok':s.status==='warn'?'warn':'bad'); var e=el.querySelector('.n'); if(e)e.textContent=s.total; }
    el = $('tp-actor');     if(el){ var e=el.querySelector('.n'); if(e)e.textContent=s.actor; }
    el = $('tp-band');      if(el){ var e=el.querySelector('.n'); if(e)e.textContent=s.band; }
    el = $('tp-front');     if(el){ var e=el.querySelector('.n'); if(e)e.textContent=s.front; }
    el = $('tp-costume');   if(el){ var e=el.querySelector('.n'); if(e)e.textContent=s.costume; }
    el = $('tp-electric');  if(el){ var e=el.querySelector('.n'); if(e)e.textContent=s.electric; }
    el = $('tp-status');
    if(el){
      el.className='tb-stat '+(s.status==='ok'?'ok':s.status==='warn'?'warn':'bad');
      var e = el.querySelector('.n');
      if(e) e.textContent = s.statusText;
    }
  }
  // 持久化 groups 到当前阵容 raw
  function saveGroupsToActive(groups, name){
    try{
      var raw = _safeGet(ACTIVE_KEY, {}) || {};
      raw.__troupeGroups = groups;
      raw.__troupeTemplateName = name || '';
      raw.__troupeUpdatedAt = _now();
      _safeSet(ACTIVE_KEY, raw);
      refreshTopBar();
    }catch(e){ _t('保存编组失败：'+e.message,'error'); }
  }

  /* ==================== Modal 系统（通用） ==================== */
  function _ensureOverlay(){
    var ov = $('tpOverlay');
    if(ov) return ov;
    ov = document.createElement('div');
    ov.id = 'tpOverlay';
    ov.className = 'op-overlay';
    var md = document.createElement('div');
    md.id = 'tpModal';
    md.className = 'op-modal';
    md.innerHTML = '<div class="op-head">' +
      '<h3 id="tpModalTitle">民营剧团组团模板</h3>' +
      '<button class="op-close" id="tpModalClose" type="button">×</button></div>' +
      '<div class="op-body" id="tpModalBody" style="padding:18px 24px;"></div>';
    ov.appendChild(md);
    document.body.appendChild(ov);
    md.querySelector('#tpModalClose').addEventListener('click', closeModal, true);
    ov.addEventListener('click', function(e){ if(e.target===ov) closeModal(); }, true);
    return ov;
  }
  function openModal(bodyHtml, title){
    var ov = _ensureOverlay();
    var md = ov.querySelector('#tpModal');
    var tb = md.querySelector('#tpModalTitle');
    var bd = md.querySelector('#tpModalBody');
    if(title) tb.textContent = title;
    bd.innerHTML = bodyHtml;
    setTimeout(function(){ try{ ov.classList.add('show'); md.classList.add('show'); }catch(_){} }, 10);
  }
  function closeModal(){
    try{
      var ov = $('tpOverlay'); if(!ov) return;
      var md = ov.querySelector('#tpModal');
      ov.classList.remove('show');
      md.classList.remove('show');
    }catch(_){}
  }

  /* ==================== 载入模板弹窗（列表） ==================== */
  function openLoadList(){
    if(!_acq('troupe-loadlist',700)) return;
    var list = listTemplates();
    var html = '';
    if(list.length===0){
      html = '<div style="padding:40px;text-align:center;color:#64748b;">🗂 暂无模板，点击「一键生成36人标配样板」自动创建行业推荐模板</div>';
    } else {
      html = '<div style="margin-bottom:12px;padding:10px 14px;background:#eff6ff;border-radius:10px;border:1.5px solid #bfdbfe;color:#1e40af;font-size:.9rem;">👉 点击右侧「载入」一键应用模板到当前演出阵容（会保留剧目和主创信息，仅更新人力资源配置）</div>';
      for(var i=0;i<list.length;i++){
        var t = list[i];
        var s = statsFromGroups(t.groups);
        var tagCls = s.status==='ok'?'background:#dcfce7;color:#166534;border-color:#86efac;'
                  : s.status==='warn'?'background:#fef9c3;color:#854d0e;border-color:#fde047;'
                  : 'background:#fecaca;color:#991b1b;border-color:#fca5a5;';
        html += '<div class="tp-list-item" data-tp-id="'+_escape(t.id)+'">' +
          '<div class="tp-info">' +
            '<div class="tp-name">'+_escape(t.name)+(t.builtin?' <span style="font-size:.74rem;padding:2px 8px;border-radius:10px;background:#e0e7ff;color:#3730a3;border:1px solid #c7d2fe;">行业标准</span>':'')+'</div>' +
            '<div class="tp-meta">' +
              '<span>👥 '+s.total+' 人</span>'+
              '<span style="'+tagCls+'padding:2px 8px;border-radius:10px;border:1.5px solid;">'+s.statusText+'</span>'+
              '<span>🎭 演员 '+s.actor+'</span>'+
              '<span>🎷 乐队 '+s.band+'</span>'+
              '<span>🪑 前场 '+s.front+'</span>'+
              '<span>👘 服装 '+s.costume+'</span>'+
              '<span>💡 电工 '+s.electric+'</span>'+
              (t.desc?'<span style="flex:1 0 100%;margin-top:4px;max-width:100%;background:#fffbeb;color:#92400e;border-color:#fde68a;">📝 '+_escape(t.desc)+'</span>':'') +
            '</div>' +
          '</div>' +
          '<div class="tp-ops">' +
            '<button class="tp-load" data-op="load">📋 载入</button>'+
            '<button class="tp-edit" data-op="edit">✏ 编辑</button>'+
            '<button class="tp-dup" data-op="dup">📋 复制</button>'+
            (t.builtin?'':'<button class="tp-del" data-op="del">🗑 删除</button>')+
          '</div>' +
        '</div>';
      }
    }
    openModal(html, '📋 从组团模板库载入');
    // 绑定按钮
    var bd = $('tpModalBody');
    if(!bd) return;
    var items = bd.querySelectorAll('.tp-list-item');
    for(var j=0;j<items.length;j++){
      (function(el){
        var id = el.getAttribute('data-tp-id');
        var loadBtn = el.querySelector('[data-op="load"]');
        var editBtn = el.querySelector('[data-op="edit"]');
        var dupBtn  = el.querySelector('[data-op="dup"]');
        var delBtn  = el.querySelector('[data-op="del"]');
        if(loadBtn) loadBtn.addEventListener('click', function(){ if(!_acq('load-'+id,600))return; closeModal(); loadTemplate(id); }, true);
        if(editBtn) editBtn.addEventListener('click', function(){ if(!_acq('edit-'+id,600))return; openEditor(id); }, true);
        if(dupBtn)  dupBtn.addEventListener('click',  function(){ if(!_acq('dup-'+id,600))return; duplicateTemplate(id); openLoadList(); }, true);
        if(delBtn)  delBtn.addEventListener('click',  function(){ if(!_acq('del-'+id,800))return; if(deleteTemplate(id)) openLoadList(); }, true);
      })(items[j]);
    }
  }

  /* ==================== 载入模板 → 当前阵容 ==================== */
  function loadTemplate(id){
    var tpl = getTemplate(id);
    if(!tpl){ _t('❌ 模板不存在','error'); return; }
    var s = statsFromGroups(tpl.groups);
    if(!confirm('确认载入模板「'+tpl.name+'」（'+s.total+'人）？\n\n载入后：\n✅ 会覆盖当前5大岗位组的人员配置\n✅ 主创/剧目/节目单等板块不会被清除\n✅ 可继续手动微调岗位名单')){
      return;
    }
    var groups = JSON.parse(JSON.stringify(tpl.groups));
    saveGroupsToActive(groups, tpl.name);
    _t('🎭 已载入「'+tpl.name+'」共 '+s.total+' 人，顶部人数条已刷新。\n下一步：请在「载入模板→编辑」或「模板管理→编辑」中填入真实姓名','success');
    refreshTopBar();
  }

  /* ==================== 模板编辑器（新增/编辑） ==================== */
  function openEditor(id){
    var tpl = id ? getTemplate(id) : { id:_uid('TP'), name:'', desc:'', groups:{} };
    if(!tpl){ _t('模板不存在','error'); return; }
    // 补齐5大组
    for(var k in GROUPS){ if(!tpl.groups[k]) tpl.groups[k] = []; }
    var body = '';
    body += '<div style="margin-bottom:14px;display:grid;grid-template-columns:1fr 2fr;gap:12px;align-items:center;">' +
      '<label style="font-weight:800;color:#0f172a;">模板名称：</label>'+
      '<input id="tpInpName" value="'+_escape(tpl.name||'')+'" style="padding:9px 12px;border:2px solid #fcd34d;border-radius:10px;font-size:.98rem;font-weight:700;" placeholder="例：2026秋季巡演版 36人">' +
      '</div>' +
      '<div style="margin-bottom:14px;display:grid;grid-template-columns:1fr 2fr;gap:12px;align-items:start;">' +
      '<label style="font-weight:800;color:#0f172a;margin-top:8px;">备注说明：</label>'+
      '<textarea id="tpInpDesc" rows="2" style="padding:8px 12px;border:2px solid #e2e8f0;border-radius:10px;font-size:.9rem;resize:vertical;" placeholder="例：适合冬季下乡巡演、棉衣箱配置、发电机大功率版…">'+_escape(tpl.desc||'')+'</textarea>' +
      '</div>';
    // 5 大分组卡片
    for(var g=0; g<G_KEYS.length; g++){
      var gk = G_KEYS[g];
      var gd = GROUPS[gk];
      var rows = tpl.groups[gk] && tpl.groups[gk].length>0 ? tpl.groups[gk] : [{pos:'',name:''},{pos:'',name:''},{pos:'',name:''}];
      body += '<div class="tp-group '+gd.cls+'" data-gk="'+gk+'">' +
        '<div class="tp-g-head"><span>'+_escape(gd.name)+'</span>' +
          '<button class="tp-add-btn" type="button" data-tp-add-group="'+gk+'">+ 追加1行 '+gd.name+'</button>'+
          '<span class="tp-g-count" id="tpGCount_'+gk+'">0 人</span>'+
        '</div>'+
        '<div class="tp-g-body" data-tp-body="'+gk+'">';
      for(var r=0; r<rows.length; r++){
        body += _renderRow(gk, rows[r]);
      }
      body += '</div></div>';
    }
    body += '<div style="margin-top:14px;padding:12px 16px;background:#fafafa;border:2px dashed #cbd5e1;border-radius:12px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">' +
      '<div id="tpEditorStat" style="font-weight:900;color:#0f172a;">实时统计：0 人</div>'+
      '<div style="display:flex;gap:8px;flex-wrap:wrap;">' +
        '<button class="tb-btn tp-btn-gray" id="tpBtnEditorCancel" type="button">取消</button>'+
        '<button class="tb-btn tp-btn-amber" id="tpBtnEditorSeed" type="button">✨ 填充36人样板行</button>'+
        '<button class="tb-btn tp-btn-blue" id="tpBtnEditorSave" type="button">💾 保存模板</button>'+
      '</div></div>';
    openModal(body, (id?'✏ 编辑组团模板':'➕ 新建组团模板'));
    _bindEditorEvents(tpl);
    _updateEditorStat();
  }
  function _renderRow(gk, row){
    row = row || {};
    return '<div class="tp-row" data-tp-row="'+gk+'">' +
      '<input placeholder="岗位（例：老生·A角）" data-f="pos" value="'+_escape(row.pos||'')+'">' +
      '<input placeholder="姓名（留空=待配）" data-f="name" value="'+_escape(row.name||'')+'">' +
      '<input placeholder="备注/替补说明" data-f="note" value="'+_escape(row.note||'')+'">' +
      '<button class="tp-del" type="button" data-tp-row-del>×</button>'+
    '</div>';
  }
  function _bindEditorEvents(tpl){
    var bd = $('tpModalBody');
    if(!bd) return;
    // 新增行
    var addBtns = bd.querySelectorAll('[data-tp-add-group]');
    for(var i=0;i<addBtns.length;i++){
      addBtns[i].addEventListener('click', function(e){
        var gk = this.getAttribute('data-tp-add-group');
        var body = bd.querySelector('[data-tp-body="'+gk+'"]');
        if(!body) return;
        var div = document.createElement('div');
        div.innerHTML = _renderRow(gk, {});
        body.appendChild(div.firstElementChild);
        _bindRowEvents(body.lastElementChild, gk);
        _updateEditorStat();
      }, true);
    }
    // 行级事件
    var rows = bd.querySelectorAll('[data-tp-row]');
    for(var j=0;j<rows.length;j++){ _bindRowEvents(rows[j], rows[j].getAttribute('data-tp-row')); }
    // 取消
    var c = $('tpBtnEditorCancel'); if(c) c.addEventListener('click', closeModal, true);
    // 填充样板
    var sd = $('tpBtnEditorSeed'); if(sd) sd.addEventListener('click', function(){
      var s36 = _makeTroupe36();
      for(var gk in s36){
        var body = bd.querySelector('[data-tp-body="'+gk+'"]');
        if(!body) continue;
        body.innerHTML = '';
        for(var r=0;r<s36[gk].length;r++){
          var d = document.createElement('div');
          d.innerHTML = _renderRow(gk, s36[gk][r]);
          body.appendChild(d.firstElementChild);
          _bindRowEvents(body.lastElementChild, gk);
        }
      }
      _updateEditorStat();
      _t('已填充 36 人行业标准配置，可继续手动微调','info');
    }, true);
    // 保存
    var sv = $('tpBtnEditorSave');
    if(sv) sv.addEventListener('click', function(){
      if(!_acq('troupe-save',900)) return;
      var nameEl = $('tpInpName'); var descEl = $('tpInpDesc');
      var name = nameEl ? String(nameEl.value||'').trim() : '';
      var desc = descEl ? String(descEl.value||'').trim() : '';
      if(!name){ _t('❌ 请填写模板名称','error'); if(nameEl) nameEl.focus(); return; }
      var groups = {};
      var gKeys = Object.keys(GROUPS);
      for(var g=0;g<gKeys.length;g++){
        var gk = gKeys[g];
        var body = bd.querySelector('[data-tp-body="'+gk+'"]');
        groups[gk] = [];
        if(!body) continue;
        var rws = body.querySelectorAll('[data-tp-row="'+gk+'"]');
        for(var r=0;r<rws.length;r++){
          var rowEl = rws[r];
          var posI = rowEl.querySelector('[data-f="pos"]'); var nameI = rowEl.querySelector('[data-f="name"]'); var noteI=rowEl.querySelector('[data-f="note"]');
          var pos  = posI  ? String(posI.value||'').trim()  : '';
          var nm   = nameI ? String(nameI.value||'').trim() : '';
          var nt   = noteI ? String(noteI.value||'').trim() : '';
          if(!pos && !nm) continue;  // 空行跳过
          groups[gk].push({ pos:pos, name:nm, note:nt });
        }
      }
      var s = statsFromGroups(groups);
      if(s.total < 8){ if(!confirm('当前模板仅 '+s.total+' 人，人数较少，建议≥30人。确认保存吗？')) return; }
      tpl.name = name; tpl.desc = desc; tpl.groups = groups;
      upsertTemplate(tpl);
      closeModal();
    }, true);
  }
  function _bindRowEvents(rowEl, gk){
    var del = rowEl.querySelector('[data-tp-row-del]');
    if(del) del.addEventListener('click', function(){
      var parent = rowEl.parentNode; if(!parent) return;
      parent.removeChild(rowEl); _updateEditorStat();
    }, true);
    // 输入即刷新统计
    var inputs = rowEl.querySelectorAll('input');
    for(var i=0;i<inputs.length;i++){ inputs[i].addEventListener('input', _updateEditorStat, true); }
  }
  function _updateEditorStat(){
    try{
      var bd = $('tpModalBody'); if(!bd) return;
      var groups = {};
      for(var g=0;g<G_KEYS.length;g++){
        var gk = G_KEYS[g];
        var body = bd.querySelector('[data-tp-body="'+gk+'"]');
        groups[gk] = [];
        if(!body) continue;
        var rws = body.querySelectorAll('[data-tp-row="'+gk+'"]');
        for(var r=0;r<rws.length;r++){
          var rowEl = rws[r];
          var posI = rowEl.querySelector('[data-f="pos"]'); var nameI = rowEl.querySelector('[data-f="name"]');
          var pos  = posI ? String(posI.value||'').trim() : '';
          var nm   = nameI? String(nameI.value||'').trim(): '';
          if(pos || nm) groups[gk].push(1);
        }
        var countEl = $('tpGCount_'+gk);
        if(countEl) countEl.textContent = groups[gk].length + ' 人';
      }
      var s = statsFromGroups(groups);
      var st = $('tpEditorStat');
      if(st){
        var cls = s.status==='ok'?'color:#15803d;':s.status==='warn'?'color:#b45309;':'color:#b91c1c;';
        st.innerHTML = '实时统计：<b style="'+cls+'font-size:1.06rem;">'+s.total+' 人</b>'+
          ' ｜演员 '+s.actor+'｜乐队 '+s.band+'｜前场 '+s.front+'｜服装 '+s.costume+'｜电工 '+s.electric +
          ' ｜<b style="'+cls+'">'+s.statusText+'</b>（民营团标配 30-40 人）';
      }
    }catch(_){}
  }

  /* ==================== 另存为模板（从当前阵容） ==================== */
  function openSaveAs(){
    if(!_acq('troupe-saveas',700)) return;
    var raw = _safeGet(ACTIVE_KEY, null) || {};
    var groups = (raw && raw.__troupeGroups) ? raw.__troupeGroups : null;
    if(!groups){
      // 空当前阵容，提示先载入或生成
      if(!confirm('当前阵容尚未配置任何岗位人员。\n\n是否直接创建一个空白模板？')) return;
      groups = { actor:[], band:[], front:[], costume:[], electric:[] };
    }
    openEditor(null);
    // 预填充当前 groups（openEditor 已创建空白，需要覆盖它的行）
    setTimeout(function(){
      try{
        var bd = $('tpModalBody'); if(!bd) return;
        for(var gk in groups){
          var body = bd.querySelector('[data-tp-body="'+gk+'"]'); if(!body) continue;
          body.innerHTML = '';
          var rows = groups[gk] || [];
          if(rows.length===0) rows = [{pos:'',name:''},{pos:'',name:''},{pos:'',name:''}];
          for(var r=0;r<rows.length;r++){
            var d = document.createElement('div');
            d.innerHTML = _renderRow(gk, rows[r]);
            body.appendChild(d.firstElementChild);
            _bindRowEvents(body.lastElementChild, gk);
          }
        }
        // 模板名预填
        var nm = $('tpInpName');
        if(nm){
          var fromTpl = (raw&&raw.__troupeTemplateName)? String(raw.__troupeTemplateName).replace(/（.+?）/g,'').trim() : '';
          nm.value = (fromTpl? fromTpl+' · 变体版 ' : '新建模板 ') + (new Date().toISOString().slice(0,10));
        }
        _updateEditorStat();
      }catch(e){ console.warn(e); }
    }, 60);
  }

  /* ==================== 一键36人样板（直接写入当前阵容） ==================== */
  function doSeed36(){
    if(!_acq('troupe-seed36',900)) return;
    var g36 = _makeTroupe36();
    var s = statsFromGroups(g36);
    if(!confirm('一键载入【行业标准·秦腔民营团36人标配版】？\n\n配置：演员13人 + 乐队13人 + 前场3人 + 服装3人 + 电工4人\n\n载入后可随时继续在「模板管理」中编辑人员姓名。')) return;
    saveGroupsToActive(g36, '【行业标准】秦腔民营团·36人标配版（推荐）');
    _t('✨ 一键生成36人标配成功！请逐个岗位填入真实姓名。当前 '+s.total+' 人（达标✅）','success');
    refreshTopBar();
  }

  /* ==================== 模板管理（列表视图） ==================== */
  function openManage(){
    var list = listTemplates();
    var html = '';
    html += '<div style="margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap;">' +
      '<button class="tb-btn tp-btn-blue" id="tpMgrNew" type="button">➕ 新建模板</button>' +
      '<button class="tb-btn tp-btn-amber" id="tpMgrSeed" type="button">✨ 重置为3个内置行业标准模板</button>' +
      '</div>';
    if(list.length===0){
      html += '<div style="padding:40px;text-align:center;color:#64748b;">暂无模板，点击上方「新建模板」或「重置内置」开始</div>';
    } else {
      html += '<div style="margin-bottom:14px;padding:10px 14px;background:#fef9c3;border-radius:10px;border:1.5px solid #fde68a;color:#713f12;font-size:.9rem;">💡 行业标准模板建议只做「复制」后编辑，不要直接删除（已内置的无法删除）</div>';
      for(var i=0;i<list.length;i++){
        var t = list[i];
        var s = statsFromGroups(t.groups);
        html += '<div class="tp-list-item" data-tp-id="'+_escape(t.id)+'">' +
          '<div class="tp-info">' +
            '<div class="tp-name">'+_escape(t.name)+(t.builtin?' <span style="font-size:.74rem;padding:2px 8px;border-radius:10px;background:#e0e7ff;color:#3730a3;border:1px solid #c7d2fe;">内置</span>':'')+'</div>' +
            '<div class="tp-meta">' +
              '<span>👥 '+s.total+' 人</span>'+
              '<span>🎭 演员 '+s.actor+'</span>'+
              '<span>🎷 乐队 '+s.band+'</span>'+
              '<span>🪑 前场 '+s.front+'</span>'+
              '<span>👘 服装 '+s.costume+'</span>'+
              '<span>💡 电工 '+s.electric+'</span>'+
              (t.desc?'<span style="flex:1 0 100%;margin-top:4px;max-width:100%;">📝 '+_escape(t.desc)+'</span>':'') +
            '</div>' +
          '</div>' +
          '<div class="tp-ops">' +
            '<button class="tp-load" data-op="load">📋 载入</button>'+
            '<button class="tp-edit" data-op="edit">✏ 编辑</button>'+
            '<button class="tp-dup" data-op="dup">📋 复制</button>'+
            (t.builtin?'':'<button class="tp-del" data-op="del">🗑 删除</button>')+
          '</div>' +
        '</div>';
      }
    }
    openModal(html, '⚙️ 组团模板管理（共 '+list.length+' 个）');
    var bd = $('tpModalBody'); if(!bd) return;
    var n = $('tpMgrNew'); if(n) n.addEventListener('click', function(){ openEditor(null); }, true);
    var rs = $('tpMgrSeed'); if(rs) rs.addEventListener('click', function(){
      if(!confirm('确认重置模板库为3个内置行业标准模板？\n⚠ 现有自定义模板将全部丢失！')) return;
      try{ localStorage.removeItem(LS_KEY); }catch(_){}
      listTemplates();  // 触发重新种子
      _t('✅ 已重置模板库','success');
      openManage();
    }, true);
    var items = bd.querySelectorAll('.tp-list-item');
    for(var j=0;j<items.length;j++){
      (function(el){
        var id = el.getAttribute('data-tp-id');
        var loadBtn = el.querySelector('[data-op="load"]');
        var editBtn = el.querySelector('[data-op="edit"]');
        var dupBtn  = el.querySelector('[data-op="dup"]');
        var delBtn  = el.querySelector('[data-op="del"]');
        if(loadBtn) loadBtn.addEventListener('click', function(){ if(!_acq('load-'+id,600))return; closeModal(); loadTemplate(id); }, true);
        if(editBtn) editBtn.addEventListener('click', function(){ if(!_acq('edit-'+id,600))return; openEditor(id); }, true);
        if(dupBtn)  dupBtn.addEventListener('click',  function(){ if(!_acq('dup-'+id,600))return; duplicateTemplate(id); openManage(); }, true);
        if(delBtn)  delBtn.addEventListener('click',  function(){ if(!_acq('del-'+id,800))return; if(deleteTemplate(id)) openManage(); }, true);
      })(items[j]);
    }
  }

  /* ==================== 绑定顶部按钮 ==================== */
  function bindButtons(){
    try{
      var b;
      b = $('tpBtnLoad');   if(b) b.addEventListener('click', function(e){ e&&e.preventDefault&&e.preventDefault(); openLoadList(); }, true);
      b = $('tpBtnSaveAs'); if(b) b.addEventListener('click', function(e){ e&&e.preventDefault&&e.preventDefault(); openSaveAs(); }, true);
      b = $('tpBtnManage'); if(b) b.addEventListener('click', function(e){ e&&e.preventDefault&&e.preventDefault(); openManage(); }, true);
      b = $('tpBtnSeed');   if(b) b.addEventListener('click', function(e){ e&&e.preventDefault&&e.preventDefault(); doSeed36(); }, true);
    }catch(e){ console.warn('[Troupe] bind err', e); }
  }

  /* ==================== 启动 ==================== */
  function start(){
    try{
      bindButtons();
      refreshTopBar();
      // 每 4s 刷新一次统计（用户手动编辑了 raw 时能自动反映）
      setInterval(refreshTopBar, 3500);
      // 监听保存事件（主模块的 save 按钮被点击时，把当前 __troupeGroups 一并写入存档列表中当前激活项）
      document.addEventListener('click', function(){
        try{
          var raw = _safeGet(ACTIVE_KEY, null);
          if(!raw || !raw.__troupeGroups) return;
          var activeId = _safeGet('qaxqjt_cast_sheet_active_v1', '');
          if(!activeId) return;
          var list = _safeGet('qaxqjt_cast_sheets_v1', []);
          if(!Array.isArray(list)) return;
          for(var i=0;i<list.length;i++){
            if(list[i].id === activeId){ list[i].fromTemplateId = (list[i].fromTemplateId || raw.__troupeTemplateName || ''); list[i].updatedAt = _now(); break; }
          }
          _safeSet('qaxqjt_cast_sheets_v1', list);
        }catch(_){}
      }, true);
      console.info('[TroupeTemplateModule V20260802] 民营剧团组团模板已挂载：'+listTemplates().length+' 个模板库（5大岗位组 · 30-40人标配检测）');
    }catch(e){ console.warn('[TroupeTemplateModule] init err:', e); }
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){ setTimeout(start, 300); });
  } else {
    setTimeout(start, 300);
  }
})();
</script>
</body>
</html>