    <div class="admin-topbar">
      <button class="topbar-toggle" id="sidebarToggle" type="button">☰ 切换侧边栏</button>
      <div class="breadcrumb"><a href="index.html">后台首页</a> / <span>🎭 演出演员表配置（秦腔专业增强版V3）</span></div>
      <div class="topbar-user">👨‍💼 秦剧团管理员 / <a href="#" id="logoutLink2">退出</a></div>
    </div>
    <div class="cast-page-wrap">
      <div class="print-header">
        <div style="font-weight:800;font-size:1.1rem;color:#7f1d1d;text-align:center;">秦安县秦剧团文化演出有限公司 · 演出演员表（打印版）</div>
        <div style="font-size:.78rem;color:#64748b;text-align:center;margin-top:2px;">打印时间：<span id="printDate"></span>　|　本文件为内部演出资料，请妥善保管　|　观众扫码看电子阵容：cast-public.html</div>
      </div>
      <h2 class="page-title">🎭 演出演员表配置<small>· 秦腔专业增强版V3 · 8大板块 · 剧库+演职库双联动 · 手机/平板/打印三端适配</small></h2>
      <!-- 2026-08-02 新增：多场演出存档管理栏（支持新建/切换/另存为/删除 多场演出阵容） -->
      <div id="castSheetManagerBar" class="no-print" style="background:linear-gradient(135deg,#fef9ef,#f0f7ff);border:1px solid #e5d9b8;border-radius:10px;padding:10px 14px;margin-bottom:12px;display:flex;flex-wrap:wrap;align-items:center;gap:10px;">
        <span style="font-weight:800;color:#0f4c81;font-size:0.92rem;">📁 演出阵容存档：</span>
        <select id="csSheetSelect" data-action="cast-sheet-switch" style="padding:7px 10px;border:1px solid #c9a962;border-radius:6px;background:#fff;font-size:0.9rem;min-width:240px;max-width:360px;"></select>
        <button class="btn-action btn-primary" id="csBtnNew" data-action="cast-sheet-new" type="button" style="padding:6px 12px;font-size:0.85rem;">✨ 新建演出</button>
        <button class="btn-action btn-gold" id="csBtnSaveAs" data-action="cast-sheet-saveas" type="button" style="padding:6px 12px;font-size:0.85rem;">💾 另存为新存档</button>
        <button class="btn-action btn-red" id="csBtnDelete" data-action="cast-sheet-delete" type="button" style="padding:6px 12px;font-size:0.85rem;">🗑️ 删除当前存档</button>
        <span id="csSheetInfo" style="margin-left:auto;font-size:0.82rem;color:#64748b;"></span>
      </div>
      <!-- 2026-08-02 新增：按场勾选打印 范围控制条（全选/清空/统计/按勾选打印） -->
      <div class="op-print-scope-bar no-print" id="printScopeBar">
        <span class="ps-label">🎯 打印范围：</span>
        <span class="ps-stat" id="printScopeStat">未勾选</span>
        <button class="ps-btn" id="psSelectAll" data-action="cast-ps-selectall" type="button">☑️ 全选所有</button>
        <button class="ps-btn" id="psClearAll" data-action="cast-ps-clearall" type="button">❌ 清空勾选</button>
        <button class="ps-btn" id="psSelectOperaOnly" data-action="cast-ps-operaonly" type="button">🎭 仅选场次剧目</button>
        <button class="ps-btn primary" id="btnPrintSelected" data-action="cast-print-selected" type="button">🖨 按勾选打印</button>
        <span style="margin-left:auto;color:#64748b;font-size:.78rem;">提示：在每个板块标题、每个剧目卡片左上角勾选要打印的内容</span>
      </div>
      <!-- ===== 2026-08-02 ✅ 民营剧团组团模板（30-40人标配 + 天工资商议） ===== -->
      <div class="troupe-bar" id="troupeBar">
        <span class="tb-title">民营剧团组团模板 · 天工资商议</span>
        <span class="tb-stat" id="tp-total" title="组团总人数（含替补）">总人数 <em class="n">0</em></span>
        <span class="tb-stat" id="tp-actor" title="演员组：老生/小生/花旦/青衣/花脸/丑/武生等">演员 <em class="n">0</em></span>
        <span class="tb-stat" id="tp-band"  title="乐队组：武场(打击)+文场(管弦)">乐队 <em class="n">0</em></span>
        <span class="tb-stat" id="tp-front" title="前场：舞台监督/前台/检票/引导/字幕">前场 <em class="n">0</em></span>
        <span class="tb-stat" id="tp-costume" title="服装化妆：服装师/盔箱/化妆师/道具师">服装 <em class="n">0</em></span>
        <span class="tb-stat" id="tp-electric" title="电工：灯光师/音响师/配电/设备">电工 <em class="n">0</em></span>
        <span class="tb-stat" id="tp-status" title="民营团标配需≥30人，建议30-40人" style="min-width:110px;text-align:center;">标配检测 <em class="n">-</em></span>
        <span class="tb-stat ok" id="tp-wage-day" title="单日所有人员日薪合计（不含食宿路费等）" style="background:linear-gradient(135deg,#fef9c3,#fde68a);border-color:#fcd34d;color:#78350f;">日工资合计 <em class="n">¥0</em></span>
        <span class="tb-stat bad" id="tp-wage-total" title="演出天数 × 日工资合计 = 本场演出人工成本预算" style="min-width:200px;">
          <span>演出 <input type="number" id="tpDays" min="1" max="60" value="3" title="商议本次演出天数（庙会通常3-5天）" style="width:58px;height:28px;border:1.5px solid #fcd34d;border-radius:6px;font-weight:900;text-align:center;font-size:.88rem;color:#7c2d12;background:#fffbeb;">天 × 日薪 = 人工预算 <em class="n" style="font-size:1.08rem;">¥0</em></span>
        </span>
        <div class="tb-actions">
          <button class="tb-btn tb-btn-blue"   id="tpBtnLoad"   data-action="troupe-load-list"  type="button">📋 从模板载入</button>
          <button class="tb-btn tb-btn-amber"  id="tpBtnSaveAs" data-action="troupe-save-as"   type="button">💾 另存为组团模板</button>
          <button class="tb-btn tb-btn-rose"   id="tpBtnManage" data-action="troupe-manage"    type="button">⚙️ 组团模板管理</button>
          <button class="tb-btn tb-btn-gray"   id="tpBtnSeed"   data-action="troupe-seed-36"   type="button">✨ 一键生成36人标配样板</button>
        </div>
      </div>
      <!-- ===== 组团模板 · End ===== -->
