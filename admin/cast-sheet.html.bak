<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>演出演员表配置 - 秦安县秦剧团文化演出管理系统</title>
<link rel="stylesheet" href="../css/style.css?v=20260729">
<style>
.cast-page-wrap{padding:20px 28px 40px;max-width:1480px;margin:0 auto;}
.page-title{font-size:1.45rem;font-weight:800;color:#7c2d12;margin:0 0 6px;display:flex;align-items:center;gap:10px;}
.page-title small{font-size:.8rem;font-weight:500;color:#64748b;}
.page-actions{display:flex;flex-wrap:wrap;gap:10px;margin:8px 0 22px;padding:14px 16px;background:#fff;border-radius:15px;border:1.5px solid #f1f5f9;box-shadow:0 3px 12px rgba(15,23,42,0.05);position:sticky;top:54px;z-index:20;}
.btn-action{padding:9px 15px;border:none;border-radius:11px;font-weight:700;cursor:pointer;font-size:.86rem;transition:all .18s;letter-spacing:.3px;display:inline-flex;align-items:center;gap:6px;}
.btn-action:hover{transform:translateY(-1.5px);box-shadow:0 6px 16px rgba(0,0,0,0.11);}
.btn-action.btn-red{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b;border:1.5px solid #fca5a5;}
.btn-action.btn-gold{background:linear-gradient(135deg,#fef9c3,#fde68a);color:#854d0e;border:1.5px solid #fcd34d;}
.btn-action.btn-green{background:linear-gradient(135deg,#dcfce7,#bbf7d0);color:#166534;border:1.5px solid #86efac;}
.btn-action.btn-primary{background:linear-gradient(135deg,#dbeafe,#bfdbfe);color:#1e40af;border:1.5px solid #93c5fd;}
.btn-action.btn-gray{background:linear-gradient(135deg,#f1f5f9,#e2e8f0);color:#334155;border:1.5px solid #cbd5e1;}
.btn-action.btn-orange{background:linear-gradient(135deg,#ffedd5,#fed7aa);color:#9a3412;border:1.5px solid #fdba74;}
.mode-preview{display:none;}
body[data-mode="preview"] .mode-edit{display:none !important;}
body[data-mode="preview"] .mode-preview{display:inline-flex !important;}
.show-banner{padding:28px 28px 24px;background:linear-gradient(135deg,#7f1d1d 0%,#991b1b 45%,#b91c1c 100%);color:#fff;border-radius:20px;margin-bottom:24px;box-shadow:0 12px 34px rgba(127,29,29,0.25);position:relative;overflow:hidden;border:2px solid #fbbf24;}
.show-banner::before{content:"";position:absolute;right:-40px;top:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(251,191,36,0.28),transparent 70%);border-radius:50%;}
.show-banner::after{content:"";position:absolute;left:-30px;bottom:-50px;width:200px;height:200px;background:radial-gradient(circle,rgba(254,240,138,0.2),transparent 70%);border-radius:50%;}
.show-banner .comp-name{font-size:1.85rem;font-weight:900;letter-spacing:2.5px;margin-bottom:6px;text-shadow:0 2px 8px rgba(0,0,0,0.3);}
.show-banner .comp-name em{color:#fde047;font-style:normal;}
.show-banner .show-title{font-size:2.5rem;font-weight:900;margin:10px 0 16px;color:#fef9c3;text-shadow:0 3px 12px rgba(0,0,0,0.35);letter-spacing:3px;}
.show-banner .meta-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px 22px;position:relative;z-index:2;}
.show-banner .meta-grid .row{display:flex;gap:8px;font-size:.92rem;}
.show-banner .meta-grid .row b{min-width:86px;color:#fde68a;display:inline-block;font-weight:700;}
.show-banner .meta-grid .row input{background:rgba(255,255,255,0.12);border:1px solid rgba(251,191,36,0.45);color:#fff;padding:5px 9px;border-radius:7px;flex:1;font-size:.9rem;}
.show-banner .meta-grid .row input::placeholder{color:rgba(254,249,195,0.55);}
.date-field-wrap{position:relative;display:flex;flex:1;}
.section-block{background:#fff;border-radius:18px;box-shadow:0 6px 22px rgba(15,23,42,0.08);margin-bottom:22px;overflow:hidden;border:1.5px solid #e5e7eb;}
.section-block .sec-head{display:flex;align-items:center;gap:12px;padding:15px 22px;border-bottom:1.5px solid #f1f5f9;background:linear-gradient(135deg,#f8fafc,#f1f5f9);}
.section-block .sec-head.creative{background:linear-gradient(135deg,#f5f3ff,#ede9fe);}
.section-block .sec-head.main{background:linear-gradient(135deg,#fff7ed,#ffedd5);border-bottom-color:#fed7aa;}
.section-block .sec-head.add{background:linear-gradient(135deg,#ecfeff,#cffafe);border-bottom-color:#a5f3fc;}
.section-block .sec-head.wuchang{background:linear-gradient(135deg,#fef2f2,#fee2e2);border-bottom-color:#fecaca;}
.section-block .sec-head.wenchang{background:linear-gradient(135deg,#fefce8,#fef9c3);border-bottom-color:#fde68a;}
.section-block .sec-head.stage{background:linear-gradient(135deg,#f0fdf4,#dcfce7);border-bottom-color:#bbf7d0;}
.section-block .sec-head.program{background:linear-gradient(135deg,#eff6ff,#dbeafe);border-bottom-color:#bfdbfe;}
.section-block .sec-head .sec-badge{display:inline-flex;align-items:center;justify-content:center;min-width:40px;height:40px;border-radius:11px;color:#fff;font-weight:800;font-size:1.05rem;padding:0 10px;}
.badge-creative{background:linear-gradient(135deg,#8b5cf6,#7c3aed);box-shadow:0 4px 10px rgba(124,58,237,0.35);}
.badge-main{background:linear-gradient(135deg,#f97316,#ea580c);box-shadow:0 4px 10px rgba(234,88,12,0.35);}
.badge-add{background:linear-gradient(135deg,#06b6d4,#0891b2);box-shadow:0 4px 10px rgba(8,145,178,0.35);}
.badge-wuchang{background:linear-gradient(135deg,#ef4444,#dc2626);box-shadow:0 4px 10px rgba(220,38,38,0.35);}
.badge-wenchang{background:linear-gradient(135deg,#eab308,#ca8a04);box-shadow:0 4px 10px rgba(202,138,4,0.35);}
.badge-stage{background:linear-gradient(135deg,#22c55e,#16a34a);box-shadow:0 4px 10px rgba(22,163,74,0.35);}
.badge-program{background:linear-gradient(135deg,#3b82f6,#2563eb);box-shadow:0 4px 10px rgba(37,99,235,0.35);}
.section-block .sec-head h3{margin:0;font-size:1.1rem;font-weight:800;color:#0f172a;letter-spacing:.5px;}
.section-block .sec-head .sec-sub{font-size:.8rem;color:#64748b;font-weight:500;margin-left:auto;}
.section-block .sec-body{padding:18px 22px 16px;}
.mobile-fold-btn{display:none;background:transparent;border:none;font-size:1.4rem;font-weight:800;color:#475569;cursor:pointer;}
.cast-table{width:100%;border-collapse:separate;border-spacing:0;margin-bottom:0;}
.cast-table th{background:#f8fafc;color:#334155;font-size:.82rem;font-weight:700;padding:9px 11px;text-align:left;border-bottom:2px solid #e2e8f0;white-space:nowrap;letter-spacing:.3px;}
.cast-table td{padding:8px 10px;border-bottom:1px dashed #e5e7eb;font-size:.88rem;vertical-align:middle;}
.cast-table tr:hover td{background:#f8fafc;}
.cast-table input,.cast-table select,.cast-table textarea{width:100%;padding:6px 9px;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.86rem;box-sizing:border-box;background:#fff;transition:border .15s;}
.cast-table textarea{min-height:52px;resize:vertical;font-family:inherit;}
.cast-table input:focus,.cast-table select:focus,.cast-table textarea:focus{outline:none;border-color:#f59e0b;background:#fffbeb;box-shadow:0 0 0 3px rgba(245,158,11,0.15);}
.cast-table .seq{width:46px;color:#94a3b8;font-weight:700;text-align:center;}
.cast-opera-card{padding:18px;border:1.5px solid #e5e7eb;border-radius:15px;margin-bottom:18px;background:linear-gradient(180deg,#fff,#fafafa);box-shadow:0 4px 14px rgba(15,23,42,0.05);}
.cast-opera-card:last-child{margin-bottom:0;}
.cast-opera-card.add-op{border-color:#a5f3fc;background:linear-gradient(180deg,#ecfeff,#fff);}
.cast-opera-card .oper-head{display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap;}
.cast-opera-card .oper-head .oh-title{font-size:1.08rem;font-weight:800;color:#0f172a;display:flex;align-items:center;gap:7px;}
.cast-opera-card .oper-head .oh-title input{font-weight:800;font-size:1.08rem;padding:6px 10px;border:2px dashed #cbd5e1;border-radius:9px;background:#fefce8;}
.cast-opera-card .oper-head .oh-title input:focus{background:#fffbeb;border-color:#f59e0b;outline:none;}
.cast-opera-card .oper-head .oh-meta{display:flex;gap:7px;align-items:center;flex-wrap:wrap;}
.cast-opera-card .oper-head .oh-meta .chip{background:#f1f5f9;padding:4px 10px;border-radius:20px;font-size:.8rem;font-weight:600;color:#475569;border:1px solid #e2e8f0;}
.cast-opera-card .oper-head .oh-meta .chip input,.cast-opera-card .oper-head .oh-meta .chip select{background:transparent;border:none;padding:2px 4px;font-size:.8rem;font-weight:600;color:#475569;width:auto;min-width:60px;}
.cast-opera-card .oper-head .oh-actions{margin-left:auto;display:flex;gap:8px;}
.cast-opera-card .btn-op-del,.cast-opera-card .btn-op-cast{background:transparent;border:none;padding:6px 10px;border-radius:8px;font-weight:700;font-size:.8rem;cursor:pointer;transition:all .15s;}
.cast-opera-card .btn-op-del{background:#fff1f2;color:#be123c;border:1.5px solid #fecdd3;}
.cast-opera-card .btn-op-del:hover{background:#ffe4e6;}
.cast-opera-card .btn-op-cast{background:#ede9fe;color:#6d28d9;border:1.5px solid #ddd6fe;}
.cast-opera-card .btn-op-cast:hover{background:#ddd6fe;}
.cast-opera-card .oper-intro-row{margin-bottom:14px;}
.cast-opera-card .oper-intro-row label{display:block;font-size:.8rem;font-weight:600;color:#475569;margin-bottom:4px;}
.cast-opera-card .oper-intro-row textarea{width:100%;padding:8px 11px;border:1.5px solid #e2e8f0;border-radius:9px;min-height:54px;resize:vertical;font-family:inherit;font-size:.88rem;box-sizing:border-box;}
.cast-opera-card .oper-intro-row textarea:focus{border-color:#c4b5fd;outline:none;background:#faf5ff;}
.btn-add-row{width:100%;padding:12px;border:none;background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border-top:1px dashed #bae6fd;color:#0369a1;font-weight:700;cursor:pointer;transition:all .2s;border-radius:0 0 14px 14px;letter-spacing:.5px;}
.btn-add-row:hover{background:linear-gradient(135deg,#e0f2fe,#bae6fd);color:#075985;}
.btn-add-row::before{content:"＋ ";font-size:1.1rem;font-weight:900;}
.btn-del-row{background:#fff;border:1.5px solid #fecaca;color:#b91c1c;padding:3px 7px;border-radius:7px;font-weight:700;font-size:.78rem;cursor:pointer;}
.btn-del-row:hover{background:#fee2e2;}
.btn-add-cast{background:linear-gradient(135deg,#ede9fe,#ddd6fe);color:#5b21b6;border:1.5px dashed #a78bfa;padding:6px 12px;border-radius:10px;font-weight:700;cursor:pointer;font-size:.82rem;}
.btn-add-cast:hover{background:linear-gradient(135deg,#ddd6fe,#c4b5fd);}
body[data-mode="preview"] .cast-table input,
body[data-mode="preview"] .cast-table select,
body[data-mode="preview"] .cast-table textarea,
body[data-mode="preview"] .show-banner input,
body[data-mode="preview"] .date-field-wrap input{pointer-events:none;background:#f8fafc;border-color:#e5e7eb !important;color:#111827;}
body[data-mode="preview"] .btn-del-row,
body[data-mode="preview"] .btn-add-row,
body[data-mode="preview"] .cast-picker-open,
body[data-mode="preview"] .btn-op-del,
body[data-mode="preview"] .btn-op-cast,
body[data-mode="preview"] .btn-add-cast,
body[data-mode="preview"] .mobile-fold-btn,
body[data-mode="preview"] .mobile-fab-bar{display:none !important;}
@media print{
  body{background:#fff;}
  .admin-sidebar,.admin-topbar,.page-actions,.btn-del-row,.btn-add-row,.no-print,.mobile-fab-bar,.op-overlay,.op-modal,.cp-overlay,.cp-modal{display:none !important;}
  body[data-mode="preview"] .cast-table input,
  body[data-mode="preview"] .cast-table textarea,
  body[data-mode="preview"] .cast-table select,
  body[data-mode="preview"] .show-banner input{background:#fff !important;color:#0f172a !important;border:none !important;box-shadow:none !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  input::placeholder{color:transparent !important;}
  textarea::placeholder{color:transparent !important;}
  .cast-page-wrap{padding:0;margin:0;max-width:100%;}
  .show-banner{background:#7f1d1d !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;box-shadow:none;border:none;border-radius:0;padding:20px;margin-bottom:14px;}
  .show-banner .meta-grid .row input{background:#fff !important;color:#0f172a !important;border:1px solid #cbd5e1 !important;}
  .section-block{box-shadow:none;border:1px solid #d1d5db;break-inside:avoid;margin-bottom:10px;border-radius:6px;}
  .section-block .sec-head{padding:8px 12px;}
  .section-block .sec-body{padding:8px 12px 6px;}
  .cast-opera-card{box-shadow:none;border:1px solid #e5e7eb;margin-bottom:10px;break-inside:avoid;}
  .cast-table th{background:#f1f5f9 !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  .cast-opera-card .oper-head .oh-title{font-size:1rem;}
  @page {size:A4;margin:12mm 10mm;}
  .print-header{display:block !important;padding:4px 0 10px;margin-bottom:8px;border-bottom:1.5px dashed #fbbf24;}
  .print-footer{display:block !important;padding-top:10px;margin-top:12px;border-top:1.5px dashed #cbd5e1;font-size:.7rem;color:#64748b;text-align:center;}
  /* ===== 2026-08-02 按勾选打印：未勾选的板块/剧目打印时隐藏 ===== */
  .section-block.__ps_hide__,
  .cast-opera-card.__ps_hide__{display:none !important;}
}
.print-header{display:none;}
.print-footer{display:none;}
.print-page-break{page-break-before:always;break-before:page;}
/* ===== 2026-08-02 按场勾选打印 UI 样式 ===== */
.print-scope-check{display:inline-flex;align-items:center;gap:4px;padding:4px 9px;border-radius:8px;background:linear-gradient(135deg,#fef3c7,#fde68a);border:1px solid #fbbf24;font-size:.78rem;font-weight:700;color:#92400e;cursor:pointer;user-select:none;}
.print-scope-check input{width:15px;height:15px;cursor:pointer;accent-color:#b91c1c;}
.op-print-check{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:8px;background:linear-gradient(135deg,#fef3c7,#fde68a);border:1px solid #fbbf24;font-size:.78rem;font-weight:700;color:#92400e;cursor:pointer;user-select:none;margin-right:4px;}
.op-print-check input{width:15px;height:15px;cursor:pointer;accent-color:#b91c1c;}
.section-block.selected-for-print{box-shadow:0 0 0 2px #fbbf24, 0 6px 22px rgba(15,23,42,0.08) !important;transition:all .15s;}
.cast-opera-card.selected-for-print{box-shadow:0 0 0 2px #fbbf24, 0 4px 14px rgba(15,23,42,0.05) !important;transition:all .15s;}
.op-print-scope-bar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:8px 12px;background:linear-gradient(135deg,#fff7ed,#fef9c3);border:1.5px solid #fed7aa;border-radius:10px;margin-bottom:10px;font-size:.84rem;}
.op-print-scope-bar .ps-label{font-weight:800;color:#9a3412;}
.op-print-scope-bar .ps-stat{color:#64748b;font-weight:600;}
.op-print-scope-bar .ps-btn{padding:5px 11px;border-radius:7px;border:1.5px solid #fb923c;background:#fff;color:#9a3412;font-weight:700;cursor:pointer;font-size:.82rem;}
.op-print-scope-bar .ps-btn:hover{background:linear-gradient(135deg,#ffedd5,#fed7aa);}
.op-print-scope-bar .ps-btn.primary{background:linear-gradient(135deg,#ea580c,#c2410c);color:#fff;border-color:#9a3412;}
.op-print-scope-bar .ps-btn.primary:hover{background:linear-gradient(135deg,#c2410c,#9a3412);}
/* ===================== P4：手机端快速配置（<640px） ===================== */
@media (max-width: 640px){
  .admin-sidebar{display:none !important;}
  .cast-page-wrap{padding:10px 10px 90px 10px;}
  .show-banner{padding:18px 15px 16px;border-radius:14px;margin-bottom:14px;}
  .show-banner .comp-name{font-size:1.25rem;letter-spacing:1px;}
  .show-banner .show-title{font-size:1.6rem;letter-spacing:1px;margin:6px 0 10px;}
  .show-banner .meta-grid{grid-template-columns:1fr;gap:7px;}
  .show-banner .meta-grid .row b{min-width:72px;font-size:.8rem;}
  .page-title{font-size:1.1rem;padding:4px 6px;}
  .page-title small{display:block;margin-top:2px;}
  .page-actions{position:fixed;bottom:0;left:0;right:0;z-index:50;margin:0;padding:6px 8px;border-radius:0;border-top:2px solid #fbbf24;background:rgba(255,255,255,0.97);display:flex;overflow-x:auto;gap:6px;justify-content:flex-start;scrollbar-width:none;}
  .page-actions::-webkit-scrollbar{display:none;}
  .btn-action{padding:7px 9px;font-size:.74rem;gap:3px;letter-spacing:0;flex:0 0 auto;}
  .section-block{border-radius:12px;margin-bottom:10px;border:1.5px solid #f1f5f9;}
  .section-block .sec-head{padding:10px 12px;}
  .section-block .sec-head h3{font-size:.94rem;flex:1;}
  .section-block .sec-head .sec-sub{display:none;}
  .section-block .sec-body{padding:10px;}
  .mobile-fold-btn{display:inline-block !important;}
  .section-block.folded .sec-body{display:none !important;}
  .section-block.folded .mobile-fold-btn{transform:rotate(-90deg);transition:transform .2s;}
  .cast-table th,.cast-table td{padding:5px 5px;font-size:.78rem;}
  .cast-table th{font-size:.7rem;padding:5px 4px;}
  .cast-table .seq{width:30px;font-size:.72rem;}
  .cast-table input,.cast-table select,.cast-table textarea{padding:7px 6px;font-size:.84rem;}
  .cast-opera-card{padding:10px;border-radius:10px;margin-bottom:10px;}
  .cast-opera-card .oper-head{flex-direction:column;align-items:flex-start;gap:7px;}
  .cast-opera-card .oper-head .oh-actions{margin-left:0;width:100%;justify-content:space-between;}
  .cast-opera-card .oper-head .oh-title{font-size:1rem;}
  .cast-opera-card .oper-head .oh-title input{font-size:1rem;}
  .cast-opera-card .btn-op-cast,.cast-opera-card .btn-op-del{padding:6px 8px;font-size:.76rem;}
  .cast-opera-card .oper-intro-row textarea{min-height:54px;padding:7px 8px;font-size:.84rem;}
  .cast-opera-card .oper-intro-row label{font-size:.76rem;}
  .btn-add-row{padding:10px;font-size:.84rem;border-radius:0 0 10px 10px;}
  .btn-add-cast{width:100%;margin-top:6px;text-align:center;padding:8px;}
  .cast-table{display:block;width:100%;overflow-x:auto;}
  body:not([data-mode="preview"]) .mobile-fab-bar{display:flex !important;position:fixed;bottom:58px;right:10px;flex-direction:column;gap:6px;z-index:40;}
  .mobile-fab-bar .mfab{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;border:2px solid #fff;box-shadow:0 6px 16px rgba(0,0,0,0.22);cursor:pointer;}
  .mfab-save{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;}
  .mfab-preview{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;}
  .mfab-export{background:linear-gradient(135deg,#ea580c,#c2410c);color:#fff;}
  .op-modal{top:40%;width:98vw;max-height:85vh;border-radius:14px;}
  .op-modal .op-head{padding:12px 14px;}
  .op-modal .op-head h3{font-size:1rem;}
  .op-modal .op-search{padding:10px 12px;}
  .op-modal .op-search input{min-width:150px;padding:8px 10px;font-size:.86rem;}
  .op-modal .op-body{padding:10px 12px;}
  .op-grid{grid-template-columns:1fr;gap:10px;}
  .op-modal .op-foot{padding:10px 12px;}
  .cp-modal{width:98vw;max-height:85vh;}
  .qr-placeholder{display:none;}
  .stage-wrap{display:block;}
}
.mobile-fab-bar{display:none;}
/* ===================== P5：舞台平板横屏（1024~1440 landscape） ===================== */
@media (min-width: 1024px) and (max-width: 1440px) and (orientation: landscape){
  .cast-page-wrap{padding:16px 20px;max-width:100%;}
  .stage-wrap{display:grid;grid-template-columns:1.15fr 1fr;gap:18px;}
  .stage-wrap .col-left .section-block,
  .stage-wrap .col-right .section-block{margin-bottom:14px;}
  .section-block{border-radius:14px;}
  .section-block .sec-head{padding:11px 16px;}
  .section-block .sec-head h3{font-size:1rem;}
  .section-block .sec-body{padding:14px 16px;}
  .cast-table th,.cast-table td{padding:8px 10px;font-size:.96rem;}
  .cast-table th{font-size:.9rem;padding:8px 10px;}
  .cast-table input,.cast-table select,.cast-table textarea{font-size:.96rem;padding:8px 10px;}
  .show-banner .comp-name{font-size:1.65rem;}
  .show-banner .show-title{font-size:2.2rem;margin:8px 0 12px;}
  .show-banner{padding:22px 26px;margin-bottom:16px;}
  .cast-opera-card{padding:16px;}
  .cast-opera-card .oper-head .oh-title{font-size:1.18rem;}
  .cast-opera-card .oper-head .oh-title input{font-size:1.18rem;}
  .cast-opera-card .btn-op-cast,.cast-opera-card .btn-op-del,.btn-add-cast{font-size:.9rem;padding:7px 11px;}
  .btn-action{font-size:.94rem;padding:10px 14px;}
  .page-actions{padding:11px 14px;margin-bottom:16px;top:50px;}
  .cast-opera-card .oper-intro-row textarea{min-height:62px;font-size:.96rem;}
  .cast-opera-card .cast-tabs{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap;}
  .cast-opera-card .cast-tabs .tab{padding:4px 10px;border-radius:16px;background:#f1f5f9;color:#475569;font-size:.84rem;font-weight:700;border:1.5px solid #e2e8f0;cursor:pointer;}
  .cast-opera-card .cast-tabs .tab.active{background:linear-gradient(135deg,#fef9c3,#fde68a);color:#92400e;border-color:#fbbf24;}
}
.stage-wrap{display:block;}
/* ===================== 剧库Picker Modal（X1） ===================== */
.op-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);backdrop-filter:blur(4px);z-index:2000;}
.op-overlay.show{display:block;}
.op-modal{display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(960px,96vw);max-height:90vh;background:#fff;border-radius:18px;z-index:2001;box-shadow:0 25px 60px rgba(0,0,0,0.35);overflow:hidden;flex-direction:column;border:2px solid #fbbf24;}
.op-modal.show{display:flex;}
.op-modal .op-head{padding:16px 24px;background:linear-gradient(135deg,#7f1d1d,#991b1b);color:#fff;display:flex;align-items:center;gap:14px;border-bottom:3px solid #fbbf24;}
.op-modal .op-head h3{margin:0;font-size:1.2rem;font-weight:800;flex:1;letter-spacing:.8px;}
.op-modal .op-head h3 em{color:#fde047;font-style:normal;}
.op-modal .op-head .op-close{background:rgba(255,255,255,0.18);border:1.5px solid rgba(251,191,36,0.55);color:#fff;width:38px;height:38px;border-radius:10px;font-size:1.3rem;font-weight:800;cursor:pointer;}
.op-modal .op-search{padding:14px 24px;background:linear-gradient(135deg,#fffbeb,#fef9c3);border-bottom:1.5px solid #fde68a;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
.op-modal .op-search input{flex:1;min-width:220px;padding:10px 14px;border:2px solid #fcd34d;border-radius:10px;background:#fff;font-size:.96rem;font-weight:500;}
.op-modal .op-search input:focus{outline:none;box-shadow:0 0 0 3px rgba(251,191,36,0.3);border-color:#f59e0b;}
.op-modal .op-search .cat-filter{padding:10px 14px;border:2px solid #fcd34d;border-radius:10px;background:#fff;font-weight:600;font-size:.9rem;}
.op-modal .op-body{flex:1;overflow-y:auto;padding:16px 24px 10px;}
.op-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;}
.op-card{background:#fff;border:2px solid #e5e7eb;border-radius:14px;padding:14px 15px;cursor:pointer;transition:all .18s;position:relative;}
.op-card:hover{border-color:#f59e0b;box-shadow:0 8px 20px rgba(245,158,11,0.18);transform:translateY(-2px);}
.op-card.selected{border-color:#b91c1c;background:linear-gradient(180deg,#fff1f2,#fff);box-shadow:0 0 0 3px rgba(185,28,28,0.12);}
.op-card.selected::after{content:"✅";position:absolute;top:10px;right:10px;font-size:1.2rem;}
.op-card .opc-name{font-size:1.08rem;font-weight:800;color:#0f172a;margin-bottom:6px;}
.op-card .opc-tags{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:8px;}
.op-card .opc-tags .t{padding:2px 9px;border-radius:12px;font-size:.74rem;font-weight:700;}
.op-card .opc-tags .t-benxi{background:linear-gradient(135deg,#fed7aa,#fdba74);color:#9a3412;}
.op-card .opc-tags .t-zhezi{background:linear-gradient(135deg,#a5f3fc,#67e8f9);color:#155e75;}
.op-card .opc-tags .t-hongse{background:linear-gradient(135deg,#fecaca,#fca5a5);color:#991b1b;}
.op-card .opc-tags .t-xinbian{background:linear-gradient(135deg,#ddd6fe,#c4b5fd);color:#5b21b6;}
.op-card .opc-meta{font-size:.82rem;color:#475569;display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px;}
.op-card .opc-meta b{color:#b91c1c;font-weight:800;}
.op-card .opc-cast-preview{background:#fafafa;padding:7px 9px;border-radius:9px;border:1px dashed #e2e8f0;}
.op-card .opc-cast-preview .cast-mini{font-size:.78rem;color:#334155;line-height:1.6;max-height:72px;overflow:hidden;}
.op-card .opc-cast-preview .cast-mini b{color:#6d28d9;}
.op-modal .op-foot{padding:14px 24px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);border-top:1.5px solid #e2e8f0;display:flex;justify-content:flex-end;gap:10px;}
.op-modal .op-foot .op-empty{margin-right:auto;color:#64748b;font-size:.82rem;font-weight:600;align-self:center;}
/* ===================== 选角Modal ===================== */
.cp-overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);backdrop-filter:blur(4px);z-index:1000;}
.cp-overlay.show{display:block;}
.cp-modal{display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(960px,96vw);max-height:90vh;background:#fff;border-radius:18px;z-index:1001;box-shadow:0 25px 60px rgba(0,0,0,0.35);overflow:hidden;flex-direction:column;}
.cp-modal.show{display:flex;}
.cp-head{padding:16px 24px;background:linear-gradient(135deg,#5b21b6,#7c3aed);color:#fff;display:flex;align-items:center;gap:14px;}
.cp-head h3{margin:0;font-size:1.15rem;font-weight:800;flex:1;}
.cp-close{background:rgba(255,255,255,0.18);border:1.5px solid rgba(255,255,255,0.35);color:#fff;width:36px;height:36px;border-radius:9px;font-size:1.25rem;font-weight:800;cursor:pointer;}
.cp-body{flex:1;overflow-y:auto;padding:18px 22px;}
.cp-cat{margin-bottom:16px;}
.cp-cat h4{margin:0 0 9px;font-size:.95rem;color:#475569;font-weight:800;padding-bottom:6px;border-bottom:2px dashed #e5e7eb;display:flex;align-items:center;gap:7px;}
.cp-cat h4 em{font-style:normal;background:#fef9c3;color:#854d0e;padding:2px 9px;border-radius:10px;font-size:.74rem;}
.cp-cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:9px;}
.cp-item{display:flex;align-items:center;gap:9px;padding:7px 11px;background:#fafafa;border:1.5px solid #e5e7eb;border-radius:10px;cursor:pointer;transition:all .15s;font-size:.86rem;}
.cp-item:hover{background:#fffbeb;border-color:#fcd34d;}
.cp-item input[type="checkbox"]{width:18px;height:18px;accent-color:#7c3aed;}
.cp-item.cp-selected{background:linear-gradient(135deg,#ede9fe,#ddd6fe);border-color:#a78bfa;font-weight:600;color:#4c1d95;}
.cp-item .cpi-type{margin-left:auto;font-size:.72rem;background:#f1f5f9;color:#475569;padding:1px 7px;border-radius:10px;}
.cp-foot{padding:14px 24px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);border-top:1.5px solid #e2e8f0;display:flex;gap:10px;justify-content:flex-end;}
.qr-placeholder{position:absolute;right:18px;bottom:14px;width:86px;height:86px;background:rgba(255,255,255,0.9);border:2px solid #fbbf24;border-radius:10px;padding:5px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#92400e;font-size:.62rem;text-align:center;font-weight:700;z-index:3;}
.qr-placeholder .qr-img{width:60px;height:60px;background:repeating-conic-gradient(#78350f 0 25%, #fff 0 50%) 50%/6px 6px;border-radius:4px;margin-bottom:3px;}

    /* S-通用后台补丁：页码圆角（原方形→10px圆角） + hover 上浮 */
    .pagination .page-btn, button.page-btn, .page-btn,
    .pagination button, .data-table-container .pagination button {
      border-radius: 10px !important;
      min-width: 38px;
      padding: 6px 14px;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .pagination .page-btn:hover:not(:disabled), button.page-btn:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(15,76,129,0.18);
    }
    /* 弹窗显示/隐藏通用 class（CSP友好，不写 style.display） */
    .s-modal-hide { display: none !important; }
    .s-overlay-hide { display: none !important; }
    /* 侧边栏死链兜底颜色 + href=# 伪链接视觉提示 */
    a[href="#"]:not(.action-link):not(.sched-opera-link)::after { content: " ⚠"; color: #f59e0b; font-size: .72rem; opacity: .65; }
    /* 查询按钮行内提示色 */
    .btn-ghost { color: #64748b; }
/* 🔧 H9后台总补CSS：页码圆角10px + 后台表格min-width:760px/720px/680px响应式断点 + 遮罩隐藏类 */
.pagination .page-btn, button.page-btn, .page-btn,
.pagination button, .page-number-item button, .pager button,
.btn-pagination, [class*="pagination"] button,
.btn, button.btn {
  border-radius: 10px !important;
  transition: transform .2s ease, box-shadow .2s ease;
}
.pagination .page-btn:hover:not(:disabled), button.page-btn:hover:not(:disabled),
.pager button:hover:not(:disabled), .btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(15,76,129,0.15);
}
/* 后台表格最小宽度（768px以上 → 760px；480~767 →720px；<480 →680px） */
.admin-card .data-table-container, .table-wrapper, .admin-card .table-wrapper,
.data-table-container, [class*="table-wrapper"], .admin-content table {
  min-width: 760px !important;
  overflow-x: auto !important;
}
@media (max-width: 768px) {
  .admin-card .data-table-container, .table-wrapper, .admin-card .table-wrapper,
  .data-table-container, [class*="table-wrapper"], .admin-content table {
    min-width: 720px !important;
  }
}
@media (max-width: 480px) {
  .admin-card .data-table-container, .table-wrapper, .admin-card .table-wrapper,
  .data-table-container, [class*="table-wrapper"], .admin-content table {
    min-width: 680px !important;
  }
}
.s-modal-hide { display: none !important; }
.s-overlay-hide { display: none !important; }
/* 侧边栏死链接视觉警告 */
.admin-sidebar-menu li a:not([href]), .admin-sidebar-menu li a[href="#"] { cursor: pointer; position: relative; }
.admin-sidebar-menu li a:not([href])::after, .admin-sidebar-menu li a[href="#"]::after {
  content: " ⚠"; color: #f59e0b; font-size: .78rem; opacity: .75;
}
/* ===== 2026-08-02 民营剧团组团模板 · 新增强制样式 ===== */
.troupe-bar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:6px 0 14px;padding:12px 16px;background:linear-gradient(135deg,#eff6ff,#dbeafe);border-radius:14px;border:2px solid #93c5fd;box-shadow:0 3px 10px rgba(37,99,235,0.08);}
.troupe-bar .tb-title{font-weight:900;color:#1e3a8a;font-size:.98rem;display:flex;align-items:center;gap:8px;white-space:nowrap;}
.troupe-bar .tb-title::before{content:"🎭";}
.troupe-bar .tb-stat{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1.5px solid #bfdbfe;border-radius:10px;padding:6px 12px;font-size:.86rem;font-weight:700;color:#1e40af;}
.troupe-bar .tb-stat .n{font-size:1.12rem;color:#1d4ed8;font-weight:900;}
.troupe-bar .tb-stat.ok{border-color:#86efac;background:#f0fdf4;color:#166534;} .tb-stat.ok .n{color:#15803d;}
.troupe-bar .tb-stat.warn{border-color:#fcd34d;background:#fffbeb;color:#92400e;} .tb-stat.warn .n{color:#b45309;}
.troupe-bar .tb-stat.bad{border-color:#fca5a5;background:#fef2f2;color:#991b1b;} .tb-stat.bad .n{color:#b91c1c;}
.troupe-bar .tb-actions{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;}
.troupe-bar .tb-btn{border:none;border-radius:10px;padding:8px 14px;font-weight:800;font-size:.88rem;cursor:pointer;transition:all .15s;user-select:none;white-space:nowrap;}
.troupe-bar .tb-btn-blue{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;box-shadow:0 3px 10px rgba(37,99,235,0.25);}
.troupe-bar .tb-btn-blue:hover{transform:translateY(-1px);box-shadow:0 5px 15px rgba(37,99,235,0.35);}
.troupe-bar .tb-btn-amber{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;box-shadow:0 3px 10px rgba(245,158,11,0.25);}
.troupe-bar .tb-btn-amber:hover{transform:translateY(-1px);}
.troupe-bar .tb-btn-rose{background:linear-gradient(135deg,#e11d48,#be123c);color:#fff;box-shadow:0 3px 10px rgba(225,29,72,0.25);}
.troupe-bar .tb-btn-rose:hover{transform:translateY(-1px);}
.troupe-bar .tb-btn-gray{background:linear-gradient(135deg,#64748b,#475569);color:#fff;}
.tp-group{margin-bottom:14px;border:2px solid #e2e8f0;border-radius:14px;overflow:hidden;}
.tp-group .tp-g-head{padding:10px 16px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);border-bottom:2px solid #e2e8f0;display:flex;align-items:center;gap:10px;font-weight:800;color:#0f172a;}
.tp-group .tp-g-head .tp-g-count{margin-left:auto;background:#fff;border:1.5px solid #cbd5e1;border-radius:20px;padding:3px 12px;font-size:.82rem;font-weight:900;color:#334155;}
.tp-group.tpg-actor{border-color:#fecaca;} .tp-group.tpg-actor .tp-g-head{background:linear-gradient(135deg,#fff1f2,#fee2e2);color:#991b1b;}
.tp-group.tpg-band{border-color:#fed7aa;}  .tp-group.tpg-band  .tp-g-head{background:linear-gradient(135deg,#fff7ed,#ffedd5);color:#9a3412;}
.tp-group.tpg-front{border-color:#bfdbfe;} .tp-group.tpg-front .tp-g-head{background:linear-gradient(135deg,#eff6ff,#dbeafe);color:#1e40af;}
.tp-group.tpg-costume{border-color:#c7d2fe;} .tp-group.tpg-costume .tp-g-head{background:linear-gradient(135deg,#eef2ff,#e0e7ff);color:#3730a3;}
.tp-group.tpg-electric{border-color:#bbf7d0;} .tp-group.tpg-electric .tp-g-head{background:linear-gradient(135deg,#f0fdf4,#dcfce7);color:#166534;}
.tp-row{display:flex;gap:6px;align-items:center;background:#fff;border:1.5px solid #e2e8f0;border-radius:10px;padding:6px 8px;}
.tp-row input{flex:1;min-width:0;padding:6px 9px;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.88rem;background:#fafafa;}
.tp-row input[type="number"]{max-width:90px;text-align:right;font-weight:800;color:#b45309;}
.tp-row input.tp-wage{max-width:86px;text-align:right;font-weight:900;color:#9a3412;background:#fffbeb;border-color:#fcd34d;}
.tp-row input:focus{outline:none;border-color:#fbbf24;background:#fffbeb;}
.tp-row .tp-wage-label{font-size:.72rem;color:#92400e;font-weight:900;white-space:nowrap;user-select:none;}
.tp-row .tp-del{background:#fee2e2;color:#b91c1c;border:1.5px solid #fecaca;border-radius:7px;padding:4px 8px;cursor:pointer;font-weight:900;}
.tp-row .tp-del:hover{background:#fecaca;}
.tp-group .tp-g-body{padding:10px 14px;display:grid;grid-template-columns:1fr;gap:10px;}
.tp-group .tp-g-head .tp-g-wage{margin-right:6px;background:linear-gradient(135deg,#fef9c3,#fde68a);color:#78350f;border:1.5px solid #fcd34d;border-radius:18px;padding:3px 12px;font-size:.8rem;font-weight:900;}
.tp-form-row{display:grid;grid-template-columns:1fr 2fr;gap:12px;align-items:center;margin-bottom:12px;}
.tp-form-row > label{font-weight:800;color:#0f172a;}
.tp-form-row input,.tp-form-row textarea{padding:9px 12px;border:2px solid #e2e8f0;border-radius:10px;font-size:.94rem;}
.tp-form-row input[type="number"]{max-width:160px;text-align:right;font-weight:800;color:#b45309;background:#fffbeb;border-color:#fcd34d;}
.tp-form-row.tp-wage-row{background:linear-gradient(135deg,#fffbeb,#fef3c7);padding:10px 14px;border-radius:12px;border:2px solid #fde68a;}
.tp-add-btn{display:block;width:100%;margin-top:6px;padding:6px 10px;border:1.5px dashed #94a3b8;color:#475569;border-radius:8px;background:#f8fafc;cursor:pointer;font-weight:700;font-size:.84rem;}
.tp-add-btn:hover{background:#eff6ff;color:#1d4ed8;border-color:#93c5fd;}
.tp-list-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border:2px solid #e2e8f0;border-radius:12px;margin-bottom:8px;background:#fff;transition:all .15s;}
.tp-list-item:hover{border-color:#3b82f6;box-shadow:0 4px 14px rgba(59,130,246,0.1);}
.tp-list-item .tp-info{flex:1;min-width:0;}
.tp-list-item .tp-info .tp-name{font-weight:900;color:#0f172a;font-size:1rem;}
.tp-list-item .tp-info .tp-meta{font-size:.78rem;color:#64748b;margin-top:3px;display:flex;flex-wrap:wrap;gap:8px;}
.tp-list-item .tp-info .tp-meta span{background:#f1f5f9;padding:2px 8px;border-radius:10px;border:1px solid #e2e8f0;}
.tp-list-item .tp-ops{display:flex;gap:6px;}
.tp-list-item .tp-ops button{border:none;border-radius:8px;padding:6px 11px;cursor:pointer;font-weight:800;font-size:.82rem;}
.tp-ops .tp-load{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;}
.tp-ops .tp-edit{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;}
.tp-ops .tp-del{background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;}
.tp-ops .tp-dup{background:#fff;color:#334155;border:1.5px solid #cbd5e1 !important;}
@media print{
  .troupe-bar{display:none !important;}
}
</style>
</head>
