<!-- 剧库Picker Modal（X1新增） -->
<div class="op-overlay" id="opOverlay"></div>
<div class="op-modal" id="opModal">
  <div class="op-head">
    <h3>🎫 秦腔剧目资源库 · <em id="opPickTarget">主场本戏</em>选择</h3>
    <button class="op-close" id="opClose" type="button">×</button>
  </div>
  <div class="op-search">
    <input type="text" id="opSearch" placeholder="🔍 搜索剧目名称、剧情关键词、角色行当…">
    <select class="cat-filter" id="opCatFilter">
      <option value="">全部分类</option>
      <option value="传统本戏">传统本戏</option>
      <option value="传统折子戏">传统折子戏</option>
      <option value="红色现代戏">红色现代戏</option>
      <option value="新编历史剧">新编历史剧</option>
    </select>
  </div>
  <div class="op-body">
    <div class="op-grid" id="opGrid"></div>
  </div>
  <div class="op-foot">
    <span class="op-empty" id="opEmptyHint">💡 提示：剧库内置10部经典秦腔（标准角色行当），并自动联动【剧目资源管理】用户新增剧目</span>
    <button class="btn-action btn-gray" id="opBtnCancel" type="button">取消</button>
    <button class="btn-action btn-primary" id="opBtnConfirm" type="button">✅ 选择该剧并配置角色</button>
  </div>
</div>

