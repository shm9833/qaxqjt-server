      <!-- 01 演出封面横幅 -->
      <div class="show-banner">
        <div class="qr-placeholder"><div class="qr-img"></div>扫码看电子阵容</div>
        <div class="comp-name">秦安县秦剧团<em>文化演出有限公司</em></div>
        <div class="show-title"><input type="text" id="inp-title" placeholder="例：{year} 文化惠民 · 秦腔经典传统剧目专场"></div>
        <div class="meta-grid">
          <div class="row"><b>📢 主办单位</b><input type="text" id="inp-host" placeholder="例：中共秦安县委宣传部"></div>
          <div class="row"><b>🎬 承办单位</b><input type="text" id="inp-organizer" placeholder="例：秦安县文体广电和旅游局"></div>
          <div class="row"><b>🤝 协办单位</b><input type="text" id="inp-coorganizer" placeholder="例：秦安县文化馆 / 陇城镇人民政府"></div>
          <div class="row"><b>💝 赞助单位</b><input type="text" id="inp-sponsor" placeholder="例：甘肃秦安农村商业银行（冠名）"></div>
          <div class="row"><b>📅 演出日期</b>
            <div class="date-field-wrap">
              <input type="date" id="inp-date">
            </div>
          </div>
          <div class="row"><b>⏰ 开演时间</b><input type="text" id="inp-time" placeholder='例：下午 14:00 / 晚间 19:30'></div>
          <div class="row"><b>📍 演出地点</b><input type="text" id="inp-venue" placeholder="例：秦安县陇城镇张沟村文化广场大舞台"></div>
          <div class="row"><b>📜 温馨提示</b><input type="text" id="inp-notice" placeholder="例：本场演出免费观看；严禁录音录像；1.2米以下儿童请家长陪同…"></div>
          <div class="row" style="grid-column:1/-1;border-top:1px dashed rgba(15,76,129,0.18);padding-top:12px;margin-top:6px;">
            <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-weight:700;color:#0f4c81;font-size:0.95rem;user-select:none;">
              <input type="checkbox" id="inp-isPublic" style="width:20px;height:20px;accent-color:#b91c1c;cursor:pointer;">
              ☑️ 公开此阵容到 <b style="color:#7f1d1d;">cast-public.html</b>（观众扫码可看）
            </label>
            <div id="publicStatusBar" class="pubstatus-wrap" style="margin-top:10px;font-size:0.85rem;"></div>
          </div>
        </div>
      </div>

      <div class="stage-wrap">
        <div class="col-left">
      <!-- 02 主创 -->
      <div class="section-block" data-ps-sec="creative">
        <div class="sec-head creative">
          <span class="sec-badge badge-creative">01</span>
          <h3>主创 &amp; 艺术指导团队</h3>
          <label class="print-scope-check no-print" data-ps-label="sec"><input type="checkbox" data-ps-cb-sec="creative"> 打印此板块</label>
          <button class="mobile-fold-btn" type="button" data-fold="sec-creative">▼</button>
          <span class="sec-sub">出品人 / 编剧 / 导演 / 艺术总监 / 唱腔设计 / 舞美</span>
        </div>
        <div class="sec-body" id="sec-creative">
          <table class="cast-table">
            <thead><tr><th class="seq">#</th><th style="width:170px;">职位</th><th style="width:130px;">姓名</th><th>备注 / 分工说明</th><th style="width:58px;" title="勾选=观众扫码可见，取消勾选=仅后台内部可见">公开</th><th style="width:52px;">操作</th></tr></thead>
            <tbody id="bodyCreative"></tbody>
          </table>
        </div>
        <button class="btn-add-row no-print" type="button" data-add="creative">追加主创/职位行（自动新增）</button>
