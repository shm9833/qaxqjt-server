        <div class="sec-body" id="sec-mainOpera">
          <div id="blkMainOpera"></div>
        </div>
        <button class="btn-add-row no-print" type="button" data-add="mainOpera" style="border-radius:0;">🎫 从剧库选择主场本戏…</button>
      </div>

      <!-- 04 加演 -->
      <div class="section-block" data-ps-sec="addOpera">
        <div class="sec-head add">
          <span class="sec-badge badge-add">03</span>
          <h3>加演演出剧目（折子戏 · 清唱 · 曲艺）</h3>
          <label class="print-scope-check no-print" data-ps-label="sec"><input type="checkbox" data-ps-cb-sec="addOpera"> 打印此板块</label>
          <button class="mobile-fold-btn" type="button" data-fold="sec-addOpera">▼</button>
          <span class="sec-sub">经典折子戏 / 秦腔清唱 / 小曲 · 演出时长 15~35 分钟</span>
        </div>
        <div class="sec-body" id="sec-addOpera">
          <div id="blkAddOpera"></div>
        </div>
        <button class="btn-add-row no-print" type="button" data-add="addOpera" style="border-radius:0;">🎫 从剧库选择加演折戏…</button>
      </div>

      <!-- 07 舞台保障 -->
      <div class="section-block" data-ps-sec="stage">
        <div class="sec-head stage">
          <span class="sec-badge badge-stage">06</span>
          <h3>舞台技术保障 &amp; 后勤（后台/前台）</h3>
          <label class="print-scope-check no-print" data-ps-label="sec"><input type="checkbox" data-ps-cb-sec="stage"> 打印此板块</label>
          <button class="mobile-fold-btn" type="button" data-fold="sec-stage">▼</button>
          <span class="sec-sub">舞台监督 ★★ · 盔箱（秦腔特色岗）★ · 灯光 · 音响 · 服装 · 化妆 · 道具</span>
        </div>
        <div class="sec-body" id="sec-stage">
          <table class="cast-table">
            <thead><tr><th class="seq">#</th><th style="width:180px;">岗位 / 职责</th><th style="width:130px;">负责人</th><th>备注（后台/前台/巡检点）</th><th style="width:58px;" title="勾选=观众可见，取消=内部保密">公开</th><th style="width:52px;">操作</th></tr></thead>
            <tbody id="bodyStage"></tbody>
          </table>
        </div>
        <button class="btn-add-row no-print" type="button" data-add="stage">追加保障岗位行（自动新增）</button>
      </div>

      <!-- 08 节目单 -->
      <div class="section-block print-page-break" data-ps-sec="program">
        <div class="sec-head program">
          <span class="sec-badge badge-program">07</span>
          <h3>演出节目单总览（按上台顺序）</h3>
          <label class="print-scope-check no-print" data-ps-label="sec"><input type="checkbox" data-ps-cb-sec="program"> 打印此板块</label>
          <button class="mobile-fold-btn" type="button" data-fold="sec-program">▼</button>
          <span class="sec-sub">开场锣鼓 → 加演折子戏 → 幕间休息 → 主场大本戏 → 谢幕加唱</span>
        </div>
        <div class="sec-body" id="sec-program">
          <table class="cast-table">
            <thead><tr><th class="seq">#</th><th style="width:110px;">分类</th><th>节目名称 / 章节</th><th style="width:86px;">时长(分)</th><th style="width:180px;">参演人员 / 负责人</th><th>备注 / 说明</th><th style="width:58px;" title="勾选=观众可见，取消=内部保密">公开</th><th style="width:52px;">操作</th></tr></thead>
            <tbody id="bodyProgram"></tbody>
          </table>
        </div>
        <button class="btn-add-row no-print" type="button" data-add="program">＋ 追加节目行（自动新增）</button>
      </div>
      </div>

      <div class="col-right">
      <!-- 05 武场 -->
      <div class="section-block" data-ps-sec="wuchang">
        <div class="sec-head wuchang">
